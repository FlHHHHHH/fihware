function Fihware:CreateWindow(config)
    config = config or {}
    self:_init()

    -- capture instance so all closures reference the right table
    local lib      = self
    local name     = config.Name      or "Window"
    local position = config.Position  or UDim2.new(0, 192, 0, 6)
    local maxH     = config.MaxHeight or 480
    local elemCount = 0
    local accentObjs = {}

    local win = Instance.new("Frame")
    win.Name             = name .. "Window"
    win.Size             = UDim2.new(0, 215, 0, 38)
    win.Position         = position
    win.BackgroundColor3 = lib.Theme.Surface
    win.BorderSizePixel  = 0
    win.ClipsDescendants = false
    win.Visible          = false
    win.Parent           = lib.ScaleRoot
    corner(win, 8)
    stroke(win, lib.Theme.Border)
    shadow(win)

    local tb = Instance.new("Frame")
    tb.Name             = "Titlebar"
    tb.Size             = UDim2.new(1, 0, 0, 38)
    tb.BackgroundColor3 = lib.Theme.Elevated
    tb.BorderSizePixel  = 0
    tb.ZIndex           = 2
    tb.Parent           = win
    corner(tb, 8)

    local tbCover = Instance.new("Frame")
    tbCover.Size             = UDim2.new(1, 0, 0, 8)
    tbCover.Position         = UDim2.new(0, 0, 1, -8)
    tbCover.BackgroundColor3 = lib.Theme.Elevated
    tbCover.BorderSizePixel  = 0
    tbCover.Parent           = tb

    if config.Icon then
        local icn = Instance.new("ImageLabel")
        icn.Size              = UDim2.new(0, config.IconSize or 15, 0, config.IconSize or 15)
        icn.Position          = UDim2.new(0, 11, 0.5, -(config.IconSize or 15) / 2)
        icn.BackgroundTransparency = 1
        icn.Image             = config.Icon
        icn.ImageColor3       = lib.Theme.SubText
        icn.ZIndex            = 3
        icn.Parent            = tb
        table.insert(accentObjs, { obj = icn, type = "ImageColor3" })
    end

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size             = UDim2.new(1, -50, 1, 0)
    titleLbl.Position         = UDim2.new(0, config.Icon and 30 or 11, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text             = name
    titleLbl.TextSize         = 13
    titleLbl.Font             = Enum.Font.GothamBold
    titleLbl.TextColor3       = lib.Theme.Text
    titleLbl.TextXAlignment   = Enum.TextXAlignment.Left
    titleLbl.ZIndex           = 3
    titleLbl.Parent           = tb

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size             = UDim2.new(0, 20, 0, 20)
    closeBtn.AnchorPoint      = Vector2.new(1, 0.5)
    closeBtn.Position         = UDim2.new(1, -8, 0.5, 0)
    closeBtn.BackgroundColor3 = lib.Theme.Background
    closeBtn.BorderSizePixel  = 0
    closeBtn.Text             = "×"
    closeBtn.TextSize         = 15
    closeBtn.Font             = Enum.Font.GothamBold
    closeBtn.TextColor3       = lib.Theme.SubText
    closeBtn.AutoButtonColor  = false
    closeBtn.ZIndex           = 3
    closeBtn.Parent           = tb
    corner(closeBtn, 99)

    closeBtn.MouseEnter:Connect(function()
        tween(closeBtn, { BackgroundColor3 = lib.Theme.Error, TextColor3 = Color3.new(1,1,1) }, 0.1)
    end)
    closeBtn.MouseLeave:Connect(function()
        tween(closeBtn, { BackgroundColor3 = lib.Theme.Background, TextColor3 = lib.Theme.SubText }, 0.1)
    end)
    closeBtn.MouseButton1Click:Connect(function()
        win.Visible = false
    end)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Name                 = "Content"
    scroll.Size                 = UDim2.new(1, 0, 1, -38)
    scroll.Position             = UDim2.new(0, 0, 0, 38)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel      = 0
    scroll.ScrollBarThickness   = 3
    scroll.ScrollBarImageColor3 = lib.Theme.Accent
    scroll.CanvasSize           = UDim2.new(0, 0, 0, 0)
    scroll.ClipsDescendants     = true
    scroll.Parent               = win
    table.insert(accentObjs, { obj = scroll, type = "ScrollBarImageColor3" })

    local contentList = listLayout(scroll, 3)
    pad(scroll, 6, 6, 6, 6)

    local function refreshSize()
        local ch = contentList.AbsoluteContentSize.Y + 18
        scroll.CanvasSize = UDim2.new(0, 0, 0, ch)
        tween(win, { Size = UDim2.new(0, 215, 0, math.min(ch + 38, maxH)) }, 0.18)
    end
    contentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshSize)

    makeDraggable(win, tb)

    local W = { Frame = win, _accentObjects = accentObjs, _wasVisible = false }
    table.insert(lib.Windows, W)

    -- ── Label ────────────────────────────────────────────────────
    function W:CreateLabel(cfg)
        elemCount = elemCount + 1
        local text  = cfg.Text  or ""
        local color = cfg.Color or lib.Theme.SubText

        local lbl = Instance.new("TextLabel")
        lbl.Size             = UDim2.new(1, 0, 0, 20)
        lbl.BackgroundTransparency = 1
        lbl.Text             = text
        lbl.TextSize         = 12
        lbl.Font             = Enum.Font.Gotham
        lbl.TextColor3       = color
        lbl.TextXAlignment   = Enum.TextXAlignment.Left
        lbl.TextWrapped      = true
        lbl.LayoutOrder      = elemCount
        lbl.Parent           = scroll
        pad(lbl, 0, 6, 0, 10)

        local api = {}
        function api:SetText(t) lbl.Text = t end
        function api:SetColor(c) lbl.TextColor3 = c end
        return api
    end

    -- ── Section ──────────────────────────────────────────────────
    function W:CreateSection(sName)
        elemCount = elemCount + 1
        local sect = Instance.new("Frame")
        sect.Size             = UDim2.new(1, 0, 0, 20)
        sect.BackgroundTransparency = 1
        sect.LayoutOrder      = elemCount
        sect.Parent           = scroll

