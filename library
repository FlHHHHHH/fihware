    logoLabel.Position               = UDim2.new(0, 12, 0, 0)
    logoLabel.BackgroundTransparency = 1
    logoLabel.Text                   = title
    logoLabel.TextSize               = 15
    logoLabel.Font                   = Enum.Font.GothamBold
    logoLabel.TextColor3             = lib.Theme.Accent
    logoLabel.TextXAlignment         = Enum.TextXAlignment.Left
    logoLabel.ZIndex                 = 3
    logoLabel.Parent                 = header

    local verLabel = Instance.new("TextLabel")
    verLabel.Size             = UDim2.new(0, 30, 0, 15)
    verLabel.AnchorPoint      = Vector2.new(1, 0.5)
    verLabel.Position         = UDim2.new(1, -10, 0.5, 0)
    verLabel.BackgroundColor3 = lib.Theme.Background
    verLabel.BorderSizePixel  = 0
    verLabel.Text             = "v2.0"
    verLabel.TextSize         = 10
    verLabel.Font             = Enum.Font.GothamBold
    verLabel.TextColor3       = lib.Theme.SubText
    verLabel.ZIndex           = 3
    verLabel.Parent           = header
    corner(verLabel, 4)
    stroke(verLabel, lib.Theme.Border)

    makeDraggable(nav, header)

    local navScroll = Instance.new("ScrollingFrame")
    navScroll.Name                   = "NavScroll"
    navScroll.Size                   = UDim2.new(1, 0, 1, -42)
    navScroll.Position               = UDim2.new(0, 0, 0, 42)
    navScroll.BackgroundTransparency = 1
    navScroll.BorderSizePixel        = 0
    navScroll.ScrollBarThickness     = 0
    navScroll.CanvasSize             = UDim2.new(0, 0, 0, 0)
    navScroll.ClipsDescendants       = true
    navScroll.Parent                 = nav

    local navList = listLayout(navScroll, 2)
    pad(navScroll, 6, 6, 6, 6)

    local function updateNavSize()
        local h = navList.AbsoluteContentSize.Y + 14
        navScroll.CanvasSize = UDim2.new(0, 0, 0, h)
        tween(nav, { Size = UDim2.new(0, lib.MainNavWidth, 0, math.min(h + 42, 540)) }, 0.18)
    end
    navList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateNavSize)

    local Main = {}
    Main._nav = nav

    -- keybind toggle
    local keyCon = UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == lib.CurrentKeybind then
            lib:Toggle()
        end
    end)
    table.insert(lib.Connections, keyCon)

    -- ── Section Divider ─────────────────────────────────────────
    function Main:AddSection(name)
        elemCount = elemCount + 1
        local sect = Instance.new("Frame")
        sect.Size                   = UDim2.new(1, 0, 0, 22)
        sect.BackgroundTransparency = 1
        sect.LayoutOrder            = elemCount
        sect.Parent                 = navScroll

        local line = Instance.new("Frame")
        line.Size             = UDim2.new(1, 0, 0, 1)
        line.Position         = UDim2.new(0, 0, 0.5, 0)
        line.BackgroundColor3 = lib.Theme.Border
        line.BorderSizePixel  = 0
        line.Parent           = sect

        if name and name ~= "" then
            local tw = TextService:GetTextSize(
                name:upper(), 10, Enum.Font.GothamBold, Vector2.new(9999, 9999)).X
            local bg = Instance.new("Frame")
            bg.Size             = UDim2.new(0, tw + 12, 0, 14)
            bg.AnchorPoint      = Vector2.new(0, 0.5)
            bg.Position         = UDim2.new(0, 6, 0.5, 0)
            bg.BackgroundColor3 = lib.Theme.Surface
            bg.BorderSizePixel  = 0
            bg.Parent           = sect

            local sLbl = Instance.new("TextLabel")
            sLbl.Size                   = UDim2.new(1, 0, 1, 0)
            sLbl.BackgroundTransparency = 1
            sLbl.Text                   = name:upper()
            sLbl.TextSize               = 10
            sLbl.Font                   = Enum.Font.GothamBold
            sLbl.TextColor3             = lib.Theme.Muted
            sLbl.Parent                 = bg
        end
    end

    -- ── Window Toggle Button (nav) ───────────────────────────────
    function Main:AddWindowButton(name, window, icon)
        elemCount = elemCount + 1
        local active = false

        local btn = Instance.new("TextButton")
        btn.Name             = name .. "NavBtn"
        btn.Size             = UDim2.new(1, 0, 0, 30)
        btn.BackgroundColor3 = lib.Theme.Elevated
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel  = 0
        btn.Text             = ""
        btn.LayoutOrder      = elemCount
        btn.AutoButtonColor  = false
        btn.Parent           = navScroll
        corner(btn, 5)

        local iconImg
        if icon then
            iconImg = Instance.new("ImageLabel")
            iconImg.Size                   = UDim2.new(0, 14, 0, 14)
            iconImg.Position               = UDim2.new(0, 10, 0.5, -7)
            iconImg.BackgroundTransparency = 1
            iconImg.Image                  = icon
            iconImg.ImageColor3            = lib.Theme.SubText
            iconImg.Parent                 = btn
        end

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size                   = UDim2.new(1, -42, 1, 0)
        nameLbl.Position               = UDim2.new(0, icon and 30 or 12, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text                   = name
        nameLbl.TextSize               = 13
        nameLbl.Font                   = Enum.Font.GothamMedium
        nameLbl.TextColor3             = lib.Theme.SubText
        nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
        nameLbl.Parent                 = btn

        local dot = Instance.new("Frame")
        dot.Size                   = UDim2.new(0, 5, 0, 5)
        dot.AnchorPoint            = Vector2.new(1, 0.5)
        dot.Position               = UDim2.new(1, -10, 0.5, 0)
        dot.BackgroundColor3       = lib.Theme.Accent
        dot.BackgroundTransparency = 1
        dot.BorderSizePixel        = 0
        dot.Parent                 = btn
        corner(dot, 99)

        local function setActive(v)
            active = v
            if window then
                if v then
                    window:SetVisible(true)
                else
                    window:SetVisible(false)
                end
            end
            tween(nameLbl, { TextColor3 = v and lib.Theme.TextBright or lib.Theme.SubText }, 0.15)
            tween(dot,     { BackgroundTransparency = v and 0 or 1 }, 0.15)
            tween(btn,     { BackgroundTransparency = v and 0 or 1, BackgroundColor3 = lib.Theme.Elevated }, 0.15)
            if iconImg then
                tween(iconImg, { ImageColor3 = v and lib.Theme.Accent or lib.Theme.SubText }, 0.15)
            end
        end

        btn.MouseEnter:Connect(function()
            if not active then
                tween(btn,     { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
                tween(nameLbl, { TextColor3 = lib.Theme.Text }, 0.1)
            end
        end)
        btn.MouseLeave:Connect(function()
            if not active then
                tween(btn,     { BackgroundTransparency = 1 }, 0.1)
                tween(nameLbl, { TextColor3 = lib.Theme.SubText }, 0.1)
            end
        end)
        btn.MouseButton1Click:Connect(function()
            setActive(not active)
        end)

        return {
            SetActive = setActive,
            GetActive = function() return active end,
            Frame     = btn,
        }
    end

    function Main:SetKeybind(key)
        lib.CurrentKeybind = key
    end

    function Main:GetFrame() return nav end

    return Main
end

-- ================================================================
-- CREATE WINDOW (auto side-by-side)
-- ================================================================
function Fihware:CreateWindow(config)
    config = config or {}
    self:_init()

    local lib        = self
    local name       = config.Name      or "Window"
    local maxH       = config.MaxHeight or 480
    local elemCount  = 0
    local accentObjs = {}

    local win = Instance.new("Frame")
    win.Name             = name .. "Window"
    win.Size             = UDim2.new(0, lib.WindowWidth, 0, 40)
    win.Position         = config.Position or UDim2.new(0, 200, 0, 6)
    win.BackgroundColor3 = lib.Theme.Surface
    win.BorderSizePixel  = 0
    win.ClipsDescendants = false
    win.Visible          = false
    win.Parent           = lib.ScaleRoot
    corner(win, 7)
    stroke(win, lib.Theme.Border)
    shadow(win, 0.55)

    -- titlebar
    local tb = Instance.new("Frame")
    tb.Name             = "Titlebar"
    tb.Size             = UDim2.new(1, 0, 0, 40)
    tb.BackgroundColor3 = lib.Theme.Elevated
    tb.BorderSizePixel  = 0
    tb.ZIndex           = 2
    tb.Parent           = win
    corner(tb, 7)

    local tbCover = Instance.new("Frame")
    tbCover.Size             = UDim2.new(1, 0, 0, 9)
    tbCover.Position         = UDim2.new(0, 0, 1, -9)
    tbCover.BackgroundColor3 = lib.Theme.Elevated
    tbCover.BorderSizePixel  = 0
    tbCover.Parent           = tb

    local tbDivider = Instance.new("Frame")
    tbDivider.Size             = UDim2.new(1, 0, 0, 1)
    tbDivider.Position         = UDim2.new(0, 0, 1, 0)
    tbDivider.BackgroundColor3 = lib.Theme.Border
    tbDivider.BorderSizePixel  = 0
    tbDivider.ZIndex           = 3
    tbDivider.Parent           = tb

    -- icon
    local iconOffset = 12
    if config.Icon then
        local sizeV = config.IconSize or 15
        local icn = Instance.new("ImageLabel")
        icn.Size                   = UDim2.new(0, sizeV, 0, sizeV)
        icn.Position               = UDim2.new(0, 12, 0.5, -sizeV / 2)
        icn.BackgroundTransparency = 1
        icn.Image                  = config.Icon
        icn.ImageColor3            = lib.Theme.Accent
        icn.ZIndex                 = 3
        icn.Parent                 = tb
        table.insert(accentObjs, { obj = icn, type = "ImageColor3" })
        iconOffset = 12 + sizeV + 8
    end

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size                   = UDim2.new(1, -iconOffset - 12, 1, 0)
    titleLbl.Position               = UDim2.new(0, iconOffset, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text                   = name
    titleLbl.TextSize               = 14
    titleLbl.Font                   = Enum.Font.GothamBold
    titleLbl.TextColor3             = lib.Theme.TextBright
    titleLbl.TextXAlignment         = Enum.TextXAlignment.Left
    titleLbl.ZIndex                 = 3
    titleLbl.Parent                 = tb

    -- content scroll
    local scroll = Instance.new("ScrollingFrame")
    scroll.Name                   = "Content"
    scroll.Size                   = UDim2.new(1, 0, 1, -40)
    scroll.Position               = UDim2.new(0, 0, 0, 40)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel        = 0
    scroll.ScrollBarThickness     = 3
    scroll.ScrollBarImageColor3   = lib.Theme.Accent
    scroll.CanvasSize             = UDim2.new(0, 0, 0, 0)
    scroll.ClipsDescendants       = true
    scroll.Parent                 = win
    table.insert(accentObjs, { obj = scroll, type = "ScrollBarImageColor3" })

    local contentList = listLayout(scroll, 3)
    pad(scroll, 8, 8, 8, 8)

    local function refreshSize()
        local ch = contentList.AbsoluteContentSize.Y + 22
        scroll.CanvasSize = UDim2.new(0, 0, 0, ch)
        tween(win, { Size = UDim2.new(0, lib.WindowWidth, 0, math.min(ch + 40, maxH)) }, 0.18)
    end
    contentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshSize)

    local W = {
        Frame          = win,
        _accentObjects = accentObjs,
        _userDragged   = false,
    }
    table.insert(lib.Windows, W)

    makeDraggable(win, tb, function() W._userDragged = true end)

    -- ── Visibility (auto side-by-side) ───────────────────────────
    function W:SetVisible(val)
        if val and not win.Visible then
            if not W._userDragged then
                win.Position = lib:_getNextWindowPosition(W)
            end
            local targetPos = win.Position
            win.Position = targetPos + UDim2.fromOffset(-18, 0)
            win.Visible = true

            -- subtle slide + fade
            local tweenObj = tween(win, { Position = targetPos }, 0.28, Enum.EasingStyle.Quart)
            tween(scroll, { ScrollBarImageTransparency = 0 }, 0.28)
        elseif not val and win.Visible then
            local tweenObj = tween(win,
                { Position = win.Position + UDim2.fromOffset(-12, 0) },
                0.18, Enum.EasingStyle.Quart)
            task.delay(0.18, function()
                if not W._wantsVisible then win.Visible = false end
            end)
        end
        W._wantsVisible = val
    end

    function W:IsVisible() return win.Visible end

    -- ── Label ────────────────────────────────────────────────────
    function W:CreateLabel(cfg)
        cfg = cfg or {}
        elemCount = elemCount + 1
        local lbl = Instance.new("TextLabel")
        lbl.Size                   = UDim2.new(1, 0, 0, 18)
        lbl.BackgroundTransparency = 1
        lbl.Text                   = cfg.Text or ""
        lbl.TextSize               = 12
        lbl.Font                   = Enum.Font.Gotham
        lbl.TextColor3             = cfg.Color or lib.Theme.SubText
        lbl.TextXAlignment         = Enum.TextXAlignment.Left
        lbl.TextWrapped            = true
        lbl.LayoutOrder            = elemCount
        lbl.Parent                 = scroll
        pad(lbl, 0, 4, 0, 4)

        local api = {}
        function api:SetText(t)  lbl.Text = t end
        function api:SetColor(c) lbl.TextColor3 = c end
        return api
    end

