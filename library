    bodyLbl.Text                   = body or ""
    bodyLbl.TextSize               = 11
    bodyLbl.Font                   = Enum.Font.Gotham
    bodyLbl.TextColor3             = self.Theme.SubText
    bodyLbl.TextXAlignment         = Enum.TextXAlignment.Left
    bodyLbl.TextWrapped            = true
    bodyLbl.LayoutOrder            = 2
    bodyLbl.Parent                 = inner

    -- Progress bar
    local progBG = Instance.new("Frame")
    progBG.Size             = UDim2.new(1, 0, 0, 2)
    progBG.AnchorPoint      = Vector2.new(0, 1)
    progBG.Position         = UDim2.new(0, 0, 1, 0)
    progBG.BackgroundColor3 = self.Theme.Border
    progBG.BorderSizePixel  = 0
    progBG.Parent           = notif

    local prog = Instance.new("Frame")
    prog.Size             = UDim2.new(1, 0, 1, 0)
    prog.BackgroundColor3 = accentColor
    prog.BorderSizePixel  = 0
    prog.Parent           = progBG

    tween(prog, { Size = UDim2.new(0, 0, 1, 0) }, duration, Enum.EasingStyle.Linear)

    task.delay(duration, function()
        tween(notif, { BackgroundTransparency = 1, Position = UDim2.new(1, 10, 0, 0) }, 0.22,
              Enum.EasingStyle.Quart)
        task.wait(0.25)
        notif:Destroy()
    end)
end

-- ================================================================
-- INIT
-- ================================================================
function Fihware:_init()
    if self.Initialized then return end
    self.Initialized = true

    pcall(function()
        if not _isfolder("fihware") then _makefolder("fihware") end
    end)

    local sg = Instance.new("ScreenGui")
    sg.Name           = "FihwareGui"
    sg.ResetOnSpawn   = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder   = 999
    local ok = pcall(function() sg.Parent = game:GetService("CoreGui") end)
    if not ok then sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    self.MainGui = sg

    local root = Instance.new("Frame")
    root.Name                   = "ScaleRoot"
    root.Size                   = UDim2.new(1, 0, 1, 0)
    root.BackgroundTransparency = 1
    root.Parent                 = sg
    self.ScaleRoot = root

    local uiScale = Instance.new("UIScale")
    uiScale.Scale  = math.clamp(Camera.ViewportSize.X / 1920, 0.55, 1)
    uiScale.Parent = root
    self.MainScale = uiScale

    table.insert(self.Connections,
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            uiScale.Scale = math.clamp(Camera.ViewportSize.X / 1920, 0.55, 1)
        end))

    local blur = Instance.new("BlurEffect")
    blur.Size   = 0
    blur.Parent = Lighting
    self.MainBlur = blur

    local nh = Instance.new("Frame")
    nh.Name                   = "NotifHolder"
    nh.Size                   = UDim2.new(0, 300, 0, 540)
    nh.AnchorPoint            = Vector2.new(1, 1)
    nh.Position               = UDim2.new(1, -16, 1, -16)
    nh.BackgroundTransparency = 1
    nh.Parent                 = root
    local nhList = listLayout(nh, 6)
    nhList.VerticalAlignment = Enum.VerticalAlignment.Bottom
    self.NotifHolder = nh

    -- auto-save
    task.spawn(function()
        while task.wait(12) do
            if self.Initialized then self:SaveSettings() end
        end
    end)

    -- rainbow
    task.spawn(function()
        while task.wait() do
            if self.RainbowEnabled and self.Initialized then
                self.RainbowHue = (self.RainbowHue + self.RainbowSpeed * 0.003) % 1
                self:SetAccent(self.RainbowHue, self.AccentS, self.AccentV)
            end
        end
    end)
end

-- ================================================================
-- DESTROY / VISIBILITY
-- ================================================================
function Fihware:Destroy()
    self:SaveSettings()
    for _, con in pairs(self.Connections) do pcall(function() con:Disconnect() end) end
    if self.MainGui  then self.MainGui:Destroy()  end
    if self.MainBlur then self.MainBlur:Destroy() end
    self.Windows      = {}
    self.SavedObjects = {}
    self.Connections  = {}
    self.Initialized  = false
end

-- ================================================================
-- WINDOW POSITIONING  (no drift: uses stored _homePos)
-- ================================================================
function Fihware:_getNextWindowPosition()
    local navRight = self.MainNavRef
        and (self.MainNavRef.AbsolutePosition.X + self.MainNavRef.AbsoluteSize.X)
        or (8 + self.MainNavWidth)
    local navY = self.MainNavRef and self.MainNavRef.AbsolutePosition.Y or 8

    local maxRight = navRight
    for _, w in ipairs(self.Windows) do
        if w._homePos then
            local right = w._homePos.X.Offset + self.WindowWidth
            if right > maxRight then maxRight = right end
        end
    end
    return UDim2.new(0, maxRight + self.WindowGap, 0, navY)
end

function Fihware:SortWindows()
    if not self.MainNavRef then return end
    local nx = self.MainNavRef.AbsolutePosition.X + self.MainNavRef.AbsoluteSize.X + self.WindowGap
    local ny = self.MainNavRef.AbsolutePosition.Y
    for _, w in ipairs(self.Windows) do
        if w.Frame.Visible then
            w._homePos = UDim2.new(0, nx, 0, ny)
            tween(w.Frame, { Position = w._homePos }, 0.28, Enum.EasingStyle.Quart)
            nx = nx + self.WindowWidth + self.WindowGap
        end
    end
end

