function Fihware.new()
    local self = setmetatable({}, Fihware)

    self.Theme = {
        Accent      = Color3.fromRGB(80, 155, 255),
        AccentDark  = Color3.fromRGB(50, 110, 200),
        Background  = Color3.fromRGB(13, 12, 14),
        Surface     = Color3.fromRGB(18, 17, 19),
        Elevated    = Color3.fromRGB(23, 22, 24),
        ElevatedHvr = Color3.fromRGB(31, 30, 32),
        Border      = Color3.fromRGB(34, 33, 35),
        BorderLight = Color3.fromRGB(50, 49, 51),
        Text        = Color3.fromRGB(200, 200, 202),
        TextBright  = Color3.fromRGB(235, 235, 237),
        SubText     = Color3.fromRGB(130, 130, 134),
        Muted       = Color3.fromRGB(80, 80, 84),
        Success     = Color3.fromRGB(70, 200, 130),
        Warning     = Color3.fromRGB(240, 170, 60),
        Error       = Color3.fromRGB(235, 80, 80),
        Discord     = Color3.fromRGB(88, 101, 242),
    }

    self.SavedObjects = {}
    self.Windows      = {}
    self.Connections  = {}
    self.MainGui      = nil
    self.MainBlur     = nil
    self.MainScale    = nil
    self.ScaleRoot    = nil
    self.NotifHolder  = nil
    self.MainNavRef   = nil
    self.SettingsWin  = nil
    self.Initialized  = false

    self.RainbowEnabled = false
    self.RainbowHue     = 0.58
    self.RainbowSpeed   = 0.4

    self.AccentH = 0.58
    self.AccentS = 0.69
    self.AccentV = 1.0

    self.NotificationsEnabled = true
    self.ToggleAlertsEnabled  = true
    self.CurrentKeybind       = CONFIG.DEFAULT_KEY
    self.GuiVisible           = false

    self.WindowWidth   = 240
    self.NavWidth      = 245
    self.WindowGap     = 10

    self.Icons  = {}
    for k, v in pairs(Icons) do self.Icons[k] = v end

    self.Config = CONFIG
    self._mainAccentList = {}

    return self
end

-- ================================================================
-- PUBLIC API
-- ================================================================
function Fihware:MakeIcon(parent, assetId, size, color, zindex)
    return makeIcon(parent, assetId, size, color, zindex)
end

function Fihware:AddIcon(name, asset)
    local id = tostring(asset)
    if not id:match("^rbxassetid://") then
        id = "rbxassetid://" .. (id:match("%d+") or "0")
    end
    self.Icons[name] = id
    return id
end

function Fihware:SetAccent(h, s, v)
    self.AccentH = h
    self.AccentS = s
    self.AccentV = v
    self.Theme.Accent     = Color3.fromHSV(h, s, v)
    self.Theme.AccentDark = Color3.fromHSV(h, math.min(s + 0.08, 1), v * 0.75)

    local function applyList(list)
        if not list then return end
        for _, entry in pairs(list) do
            pcall(function()
                entry.obj[entry.prop] = self.Theme.Accent
            end)
        end
    end

    for _, win in pairs(self.Windows) do
        applyList(win._accentList)
    end
    applyList(self._mainAccentList)
end

function Fihware:SaveSettings()
    local data = { _accent = { h = self.AccentH, s = self.AccentS, v = self.AccentV } }
    for k, v in pairs(self.SavedObjects) do
        if v.SaveValue ~= nil then data[k] = v.SaveValue end
    end
    pcall(function()
        if not _isfolder("fihware") then _makefolder("fihware") end
        _writefile("fihware/" .. tostring(game.PlaceId) .. ".json", HttpService:JSONEncode(data))
    end)
end

function Fihware:LoadSettings()
    local ok, data = pcall(function()
        return HttpService:JSONDecode(_readfile("fihware/" .. tostring(game.PlaceId) .. ".json"))
    end)
    if not ok or type(data) ~= "table" then return end
    if data._accent then self:SetAccent(data._accent.h, data._accent.s, data._accent.v) end
    for k, v in pairs(data) do
        if k ~= "_accent" and self.SavedObjects[k] and self.SavedObjects[k].Load then
            pcall(self.SavedObjects[k].Load, v)
        end
    end
end

function Fihware:Notify(title, body, duration, accentColor)
    if not self.NotificationsEnabled or not self.NotifHolder then return end
    duration    = duration    or 4
    accentColor = accentColor or self.Theme.Accent

    local notif = Instance.new("Frame")
    notif.Size                   = UDim2.new(1, 0, 0, 60)
    notif.BackgroundColor3       = self.Theme.Surface
    notif.BackgroundTransparency = 1
    notif.BorderSizePixel        = 0
    notif.Parent                 = self.NotifHolder
    corner(notif, 7)
    stroke(notif, self.Theme.Border)
    shadow(notif)

    tw(notif, { BackgroundTransparency = 0 }, 0.2)

    local inner = Instance.new("Frame")
    inner.Size                   = UDim2.new(1, 0, 1, 0)
    inner.BackgroundTransparency = 1
    inner.Parent                 = notif
    pad(inner, 10, 12, 10, 12)
    listLayout(inner, 3)

    local t = Instance.new("TextLabel")
    t.Size                   = UDim2.new(1, 0, 0, 17)
    t.BackgroundTransparency = 1
    t.Text                   = title or ""
    t.TextSize               = 13
    t.Font                   = Enum.Font.GothamBold
    t.TextColor3             = self.Theme.TextBright
    t.TextXAlignment         = Enum.TextXAlignment.Left
    t.LayoutOrder            = 1
    t.Parent                 = inner

    local b = Instance.new("TextLabel")
    b.Size                   = UDim2.new(1, 0, 0, 14)
    b.BackgroundTransparency = 1
    b.Text                   = body or ""
    b.TextSize               = 11
    b.Font                   = Enum.Font.Gotham
    b.TextColor3             = self.Theme.SubText
    b.TextXAlignment         = Enum.TextXAlignment.Left
    b.TextWrapped            = true
    b.LayoutOrder            = 2
    b.Parent                 = inner

    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(1, 0, 0, 2)
    bar.AnchorPoint      = Vector2.new(0, 1)
    bar.Position         = UDim2.new(0, 0, 1, 0)
    bar.BackgroundColor3 = accentColor
    bar.BorderSizePixel  = 0
    bar.Parent           = notif
    corner(bar, 99)
    TweenService:Create(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2)
    }):Play()

    task.delay(duration, function()
        if not notif or not notif.Parent then return end
        tw(notif, { BackgroundTransparency = 1 }, 0.25)
        tw(t,     { TextTransparency       = 1 }, 0.25)
        tw(b,     { TextTransparency       = 1 }, 0.25)
        task.wait(0.3)
        if notif and notif.Parent then notif:Destroy() end
    end)
end

-- ================================================================
-- INIT
-- ================================================================
function Fihware:_init()
    if self.Initialized then return end
    self.Initialized = true

    pcall(function()
        if not _isfolder("fihware") then _makefolder("fihware") end
    end)

    local sg = Instance.new("ScreenGui")
    sg.Name           = "FihwareGui"
    sg.ResetOnSpawn   = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
