        Main:AddSection("PROFILE")
        Main:CreateOutlineButton({
            Name     = "SAVE SETTINGS",
            Function = function()
                lib:SaveSettings()
                lib:Notify("Profile", "Settings saved.", 2.5, lib.Theme.Success)
