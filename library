        local btn = Instance.new("TextButton")
        btn.Size                   = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text                   = ""
        btn.AutoButtonColor        = false
        btn.Parent                 = row

        local accentBar = Instance.new("Frame")
        accentBar.Size             = UDim2.new(0, 2, 0, 14)
        accentBar.AnchorPoint      = Vector2.new(0, 0.5)
        accentBar.Position         = UDim2.new(0, 0, 0.5, 0)
        accentBar.BackgroundColor3 = lib.Theme.Accent
        accentBar.BackgroundTransparency = 1
        accentBar.BorderSizePixel  = 0
        accentBar.Parent           = row
        corner(accentBar, 1)
        table.insert(accentObjs, { obj = accentBar, type = "BackgroundColor3" })

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size                   = UDim2.new(1, -34, 1, 0)
        nameLbl.Position               = UDim2.new(0, 12, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text                   = eName
        nameLbl.TextSize               = 13
        nameLbl.Font                   = Enum.Font.GothamMedium
        nameLbl.TextColor3             = lib.Theme.Text
        nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
        nameLbl.Parent                 = row

        local indicator = Instance.new("Frame")
        indicator.Size             = UDim2.new(0, 16, 0, 16)
        indicator.AnchorPoint      = Vector2.new(1, 0.5)
        indicator.Position         = UDim2.new(1, -8, 0.5, 0)
        indicator.BackgroundColor3 = lib.Theme.Background
        indicator.BorderSizePixel  = 0
        indicator.Parent           = row
        corner(indicator, 4)
        local indStroke = stroke(indicator, lib.Theme.BorderLight)

        local indFill = Instance.new("Frame")
        indFill.Size                   = UDim2.new(0, 8, 0, 8)
        indFill.AnchorPoint            = Vector2.new(0.5, 0.5)
        indFill.Position               = UDim2.new(0.5, 0, 0.5, 0)
        indFill.BackgroundColor3       = lib.Theme.Accent
        indFill.BackgroundTransparency = 1
        indFill.BorderSizePixel        = 0
        indFill.Parent                 = indicator
        corner(indFill, 2)
        table.insert(accentObjs, { obj = indFill, type = "BackgroundColor3" })

        if cfg.HoverText and lib.TooltipsEnabled then
            local tip = Instance.new("TextLabel")
            tip.Size                   = UDim2.new(0, 170, 0, 0)
            tip.AutomaticSize          = Enum.AutomaticSize.Y
            tip.Position               = UDim2.new(0, 12, 1, 6)
            tip.BackgroundColor3       = lib.Theme.Elevated
            tip.BorderSizePixel        = 0
            tip.Text                   = cfg.HoverText
            tip.TextSize               = 11
            tip.Font                   = Enum.Font.Gotham
            tip.TextColor3             = lib.Theme.SubText
            tip.TextXAlignment         = Enum.TextXAlignment.Left
            tip.TextYAlignment         = Enum.TextYAlignment.Top
            tip.TextWrapped            = true
            tip.Visible                = false
            tip.ZIndex                 = 25
            tip.Parent                 = row
            pad(tip, 6, 8, 6, 8)
            corner(tip, 5)
            stroke(tip, lib.Theme.Border)
            btn.MouseEnter:Connect(function() tip.Visible = true  end)
            btn.MouseLeave:Connect(function() tip.Visible = false end)
        end

        local api = { Enabled = enabled }

        local function setEnabled(val, silent)
            enabled     = val
            api.Enabled = val
            tween(accentBar, { BackgroundTransparency = val and 0 or 1 }, 0.15)
            tween(indFill,   { BackgroundTransparency = val and 0 or 1, Size = val and UDim2.new(0, 8, 0, 8) or UDim2.new(0, 0, 0, 0) }, 0.15)
            tween(nameLbl,   { TextColor3 = val and lib.Theme.TextBright or lib.Theme.Text }, 0.15)
            indStroke.Color = val and lib.Theme.Accent or lib.Theme.BorderLight

            if not silent then
                if cfg.Function then pcall(cfg.Function, val) end
                if lib.ToggleAlertsEnabled then
                    lib:Notify(eName, "Module " .. (val and "enabled" or "disabled"), 2,
                        val and lib.Theme.Success or lib.Theme.Muted)
                end
            end
            if lib.SavedObjects[eName] then
                lib.SavedObjects[eName].SaveValue = val
            end
        end

        btn.MouseEnter:Connect(function()
            tween(row, { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
        end)
        btn.MouseLeave:Connect(function()
            tween(row, { BackgroundTransparency = 0.4, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
        end)
        btn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)

        api.Set    = function(val, silent) setEnabled(val, silent) end
        api.Toggle = function() setEnabled(not enabled) end

        lib.SavedObjects[eName] = {
            SaveValue    = enabled,
            Load         = function(v) setEnabled(v, true) end,
            UpdateAccent = function(c)
                if enabled then indFill.BackgroundColor3 = c; accentBar.BackgroundColor3 = c end
            end,
        }

        if cfg.Default ~= nil then setEnabled(cfg.Default, true) end
        return api
    end

    -- ── Slider ───────────────────────────────────────────────────
    function W:CreateSlider(cfg)
        cfg = cfg or {}
        local min      = cfg.Min      or 0
        local max      = cfg.Max      or 100
        local value    = cfg.Default  or min
        local suffix   = cfg.Suffix   or ""
        local eName    = cfg.Name     or "Slider"
        local decimals = cfg.Decimals or 0
        elemCount      = elemCount + 1

        local row = Instance.new("Frame")
        row.Size                   = UDim2.new(1, 0, 0, 46)
        row.BackgroundColor3       = lib.Theme.Elevated
        row.BackgroundTransparency = 0.4
        row.BorderSizePixel        = 0
        row.LayoutOrder            = elemCount
        row.Parent                 = scroll
        corner(row, 5)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size                   = UDim2.new(0.6, 0, 0, 18)
        nameLbl.Position               = UDim2.new(0, 12, 0, 6)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text                   = eName
        nameLbl.TextSize               = 13
        nameLbl.Font                   = Enum.Font.GothamMedium
        nameLbl.TextColor3             = lib.Theme.Text
        nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
        nameLbl.Parent                 = row

        local function fmtVal(v)
            if decimals > 0 then
                return string.format("%." .. decimals .. "f", v) .. suffix
            end
            return tostring(math.floor(v)) .. suffix
        end

        local valLbl = Instance.new("TextLabel")
        valLbl.Size                   = UDim2.new(0.4, -12, 0, 18)
        valLbl.AnchorPoint            = Vector2.new(1, 0)
        valLbl.Position               = UDim2.new(1, -12, 0, 6)
        valLbl.BackgroundTransparency = 1
        valLbl.Text                   = fmtVal(value)
        valLbl.TextSize               = 12
        valLbl.Font                   = Enum.Font.GothamMedium
        valLbl.TextColor3             = lib.Theme.Accent
        valLbl.TextXAlignment         = Enum.TextXAlignment.Right
        valLbl.Parent                 = row
        table.insert(accentObjs, { obj = valLbl, type = "TextColor3" })

        local track = Instance.new("Frame")
        track.Size             = UDim2.new(1, -24, 0, 4)
        track.Position         = UDim2.new(0, 12, 0, 30)
        track.BackgroundColor3 = lib.Theme.Border
        track.BorderSizePixel  = 0
        track.Parent           = row
        corner(track, 99)

        local pct0 = (value - min) / (max - min)
        local fill = Instance.new("Frame")
        fill.Size             = UDim2.new(pct0, 0, 1, 0)
        fill.BackgroundColor3 = lib.Theme.Accent
        fill.BorderSizePixel  = 0
        fill.Parent           = track
        corner(fill, 99)
        table.insert(accentObjs, { obj = fill, type = "BackgroundColor3" })

        local knob = Instance.new("Frame")
        knob.Size             = UDim2.new(0, 10, 0, 10)
        knob.AnchorPoint      = Vector2.new(0.5, 0.5)
        knob.Position         = UDim2.new(pct0, 0, 0.5, 0)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.BorderSizePixel  = 0
        knob.ZIndex           = 2
        knob.Parent           = track
        corner(knob, 99)

        local hitbox = Instance.new("TextButton")
        hitbox.Size                   = UDim2.new(1, 0, 0, 46)
        hitbox.Position               = UDim2.new(0, 0, 0, 0)
        hitbox.BackgroundTransparency = 1
        hitbox.Text                   = ""
        hitbox.ZIndex                 = 4
        hitbox.Parent                 = row

        local dragging = false
        local api      = { Value = value }

        local function updateSlider(x)
            local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            if decimals > 0 then
                local mult = 10 ^ decimals
                value = math.floor((min + (max - min) * pct) * mult + 0.5) / mult
            else
                value = math.floor(min + (max - min) * pct + 0.5)
            end
            api.Value     = value
            fill.Size     = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            valLbl.Text   = fmtVal(value)
            if cfg.Function then pcall(cfg.Function, value) end
            if lib.SavedObjects[eName] then lib.SavedObjects[eName].SaveValue = value end
        end

        hitbox.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateSlider(i.Position.X)
                tween(knob, { Size = UDim2.new(0, 14, 0, 14) }, 0.1)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                          or i.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(i.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    tween(knob, { Size = UDim2.new(0, 10, 0, 10) }, 0.1)
                end
                dragging = false
            end
        end)

        hitbox.MouseEnter:Connect(function()
            tween(row, { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
        end)
        hitbox.MouseLeave:Connect(function()
            if not dragging then
                tween(row, { BackgroundTransparency = 0.4, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
            end
        end)

        lib.SavedObjects[eName] = {
            SaveValue = value,
            Load = function(v)
                value = v; api.Value = v
                local pct = (v - min) / (max - min)
                fill.Size     = UDim2.new(pct, 0, 1, 0)
                knob.Position = UDim2.new(pct, 0, 0.5, 0)
                valLbl.Text   = fmtVal(v)
                if cfg.Function then pcall(cfg.Function, v) end
            end,
            UpdateAccent = function(c)
                fill.BackgroundColor3   = c
                valLbl.TextColor3       = c
            end,
        }

        return api
    end

