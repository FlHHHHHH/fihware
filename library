    bodyLbl.TextSize               = 11
    bodyLbl.Font                   = Enum.Font.Gotham
    bodyLbl.TextColor3             = self.Theme.SubText
    bodyLbl.TextXAlignment         = Enum.TextXAlignment.Left
    bodyLbl.TextWrapped            = true
    bodyLbl.LayoutOrder            = 2
    bodyLbl.Parent                 = inner

    local progBG = Instance.new("Frame")
    progBG.Size             = UDim2.new(1, 0, 0, 2)
    progBG.AnchorPoint      = Vector2.new(0, 1)
    progBG.Position         = UDim2.new(0, 0, 1, 0)
    progBG.BackgroundColor3 = self.Theme.Border
    progBG.BorderSizePixel  = 0
    progBG.Parent           = notif

    local prog = Instance.new("Frame")
    prog.Size             = UDim2.new(1, 0, 1, 0)
    prog.BackgroundColor3 = accentColor
    prog.BorderSizePixel  = 0
    prog.Parent           = progBG

    tween(prog, { Size = UDim2.new(0, 0, 1, 0) }, duration, Enum.EasingStyle.Linear)

    task.delay(duration, function()
        tween(notif,    { BackgroundTransparency = 1 }, 0.25)
        tween(titleLbl, { TextTransparency       = 1 }, 0.25)
        tween(bodyLbl,  { TextTransparency       = 1 }, 0.25)
        task.wait(0.3)
        notif:Destroy()
    end)
end

-- ================================================================
-- INIT
-- ================================================================
function Fihware:_init()
    if self.Initialized then return end
    self.Initialized = true

    pcall(function()
        if not _isfolder("fihware") then _makefolder("fihware") end
    end)

    local sg = Instance.new("ScreenGui")
    sg.Name           = "FihwareGui"
    sg.ResetOnSpawn   = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder   = 999
    local ok = pcall(function() sg.Parent = game:GetService("CoreGui") end)
    if not ok then sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    self.MainGui = sg

    local root = Instance.new("Frame")
    root.Name                   = "ScaleRoot"
    root.Size                   = UDim2.new(1, 0, 1, 0)
    root.BackgroundTransparency = 1
    root.Parent                 = sg
    self.ScaleRoot = root

    local uiScale = Instance.new("UIScale")
    uiScale.Scale  = math.clamp(Camera.ViewportSize.X / 1920, 0.55, 1)
    uiScale.Parent = root
    self.MainScale = uiScale

    table.insert(self.Connections,
        Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            uiScale.Scale = math.clamp(Camera.ViewportSize.X / 1920, 0.55, 1)
        end))

    local blur = Instance.new("BlurEffect")
    blur.Size   = 0
    blur.Parent = Lighting
    self.MainBlur = blur

    local nh = Instance.new("Frame")
    nh.Name                   = "NotifHolder"
    nh.Size                   = UDim2.new(0, 290, 0, 520)
    nh.AnchorPoint            = Vector2.new(1, 1)
    nh.Position               = UDim2.new(1, -14, 1, -14)
    nh.BackgroundTransparency = 1
    nh.Parent                 = root
    local nhList = listLayout(nh, 6)
    nhList.VerticalAlignment = Enum.VerticalAlignment.Bottom
    self.NotifHolder = nh

    task.spawn(function()
        while task.wait(10) do
            if self.Initialized then self:SaveSettings() end
        end
    end)

    task.spawn(function()
        while task.wait() do
            if self.RainbowEnabled and self.Initialized then
                self.RainbowHue = (self.RainbowHue + self.RainbowSpeed * 0.003) % 1
                self:SetAccent(self.RainbowHue, self.AccentS, self.AccentV)
            end
        end
    end)
end

-- ================================================================
-- DESTROY / VISIBILITY
-- ================================================================
function Fihware:Destroy()
    self:SaveSettings()
    for _, con in pairs(self.Connections) do
        pcall(function() con:Disconnect() end)
    end
    if self.MainGui then self.MainGui:Destroy() end
    if self.MainBlur then self.MainBlur:Destroy() end
    self.Windows      = {}
    self.SavedObjects = {}
    self.Connections  = {}
    self.Initialized  = false
end

function Fihware:SetVisible(val)
    self.GuiVisible = val
    if self.ScaleRoot then self.ScaleRoot.Visible = val end
    if self.MainBlur then tween(self.MainBlur, { Size = val and 8 or 0 }, 0.25) end
end

function Fihware:Toggle()
    self:SetVisible(not self.GuiVisible)
end

-- ================================================================
-- SIDE-BY-SIDE WINDOW POSITIONING
-- ================================================================
function Fihware:_getNextWindowPosition(skipWin)
    local mainNavRight = self.MainNavRef
        and (self.MainNavRef.Position.X.Offset + self.MainNavRef.Size.X.Offset)
        or 8
    local mainNavY = self.MainNavRef and self.MainNavRef.Position.Y.Offset or 8

    local maxRight = mainNavRight
    for _, w in ipairs(self.Windows) do
        if w ~= skipWin and w.Frame.Visible then
            local right = w.Frame.Position.X.Offset + w.Frame.Size.X.Offset
            if right > maxRight then maxRight = right end
        end
    end
    return UDim2.new(0, maxRight + self.WindowGap, 0, mainNavY)
end

function Fihware:SortWindows()
    if not self.MainNavRef then return end
    local nx = self.MainNavRef.Position.X.Offset + self.MainNavRef.Size.X.Offset + self.WindowGap
    local ny = self.MainNavRef.Position.Y.Offset
    for _, w in ipairs(self.Windows) do
        if w.Frame.Visible then
            tween(w.Frame, { Position = UDim2.new(0, nx, 0, ny) }, 0.25, Enum.EasingStyle.Quart)
            w._userDragged = false
            nx = nx + w.Frame.Size.X.Offset + self.WindowGap
        end
    end
end

