            tw(btn,      { BackgroundTransparency = 1 }, 0.1)
            tw(nameLbl2, { TextColor3 = lib.Theme.SubText }, 0.1)
            if iconImg then tw(iconImg, { ImageColor3 = lib.Theme.Text }, 0.1) end
        end)
        btn.MouseButton1Click:Connect(function() setActive(not active) end)

        return {
            SetActive = setActive,
            GetActive = function() return active end,
            Frame     = btn,
        }
    end

    function Main:AddSection(name)    elemCount += 1; return W.section(lib, scroll, elemCount, name) end
    Main.CreateSection = Main.AddSection

    function Main:CreateLabel(cfg)         elemCount += 1; return W.label(lib, scroll, elemCount, cfg) end
    function Main:CreateToggle(cfg)        elemCount += 1; return W.toggle(lib, scroll, elemCount, accentList, cfg) end
    function Main:CreateSlider(cfg)        elemCount += 1; return W.slider(lib, scroll, elemCount, accentList, cfg) end
