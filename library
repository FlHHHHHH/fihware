    stroke(nav, lib.Theme.Border)
    shadow(nav, 0.6)

    -- Header
    local header = Instance.new("Frame")
    header.Name             = "Header"
    header.Size             = UDim2.new(1, 0, 0, 40)
    header.BackgroundColor3 = lib.Theme.Elevated
