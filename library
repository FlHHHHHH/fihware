    local userLbl = Instance.new("TextLabel")
    userLbl.Size                   = UDim2.new(1, -60, 0, 14)
    userLbl.Position               = UDim2.new(0, 55, 0.5, 2)
    userLbl.BackgroundTransparency = 1
    userLbl.Text                   = "@" .. LocalPlayer.Name
    userLbl.TextSize               = 11
    userLbl.Font                   = Enum.Font.Gotham
    userLbl.TextColor3             = lib.Theme.SubText
    userLbl.TextXAlignment         = Enum.TextXAlignment.Left
    userLbl.TextTruncate           = Enum.TextTruncate.AtEnd
    userLbl.ZIndex                 = 3
    userLbl.Parent                 = footer

    -- ── content scroll (between logoBar and footer) ──────────────
    local scroll = Instance.new("ScrollingFrame")
    scroll.Name                   = "Content"
    scroll.Size                   = UDim2.new(1, 0, 1, -LOGO_H - FOOTER_H)
    scroll.Position               = UDim2.new(0, 0, 0, LOGO_H)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel        = 0
    scroll.ScrollBarThickness     = 3
    scroll.ScrollBarImageColor3   = lib.Theme.Accent
    scroll.CanvasSize             = UDim2.new(0, 0, 0, 0)
    scroll.ClipsDescendants       = true
    scroll.ZIndex                 = 2
    scroll.Parent                 = nav
    table.insert(accentObjs, { obj = scroll, type = "ScrollBarImageColor3" })

    local contentList = listLayout(scroll, 4)
    pad(scroll, 10, 10, 10, 10)

    -- ── collapse / expand logic ──────────────────────────────────
    local expanded      = false
    local animating     = false
    local fullNavH      = LOGO_H  -- updated as content grows

    local function getFullH()
        local ch = contentList.AbsoluteContentSize.Y + 24
        return math.min(ch + LOGO_H + FOOTER_H, maxH)
    end

    local function refreshSize()
        fullNavH = getFullH()
        -- position footer at the bottom of content
        footer.Position = UDim2.new(0, 0, 0, fullNavH - FOOTER_H)
        scroll.CanvasSize = UDim2.new(0, 0, 0, contentList.AbsoluteContentSize.Y + 24)
        if expanded then
            tween(nav, { Size = UDim2.new(0, lib.MainNavWidth, 0, fullNavH) }, 0.18)
        end
    end
    contentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshSize)

    local function setExpanded(val)
        if animating then return end
        expanded  = val
        animating = true

        if val then
            -- reveal: grow down with Back easing for a satisfying pop
            fullNavH = getFullH()
            footer.Position = UDim2.new(0, 0, 0, fullNavH - FOOTER_H)
            tween(nav, { Size = UDim2.new(0, lib.MainNavWidth, 0, fullNavH) },
                  0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            tween(chevron, { Rotation = 180 }, 0.22)
        else
            -- collapse: shrink to pill
            tween(nav, { Size = UDim2.new(0, lib.MainNavWidth, 0, LOGO_H) },
                  0.26, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
            tween(chevron, { Rotation = 0 }, 0.22)
        end

        task.delay(0.42, function() animating = false end)
    end

    -- ── global toggle (show/hide everything) ────────────────────
    local function toggleAll()
        lib.GuiVisible = not lib.GuiVisible
        nav.Visible    = lib.GuiVisible

        if lib.GuiVisible then
            -- Slide in from top-left
            local targetPos = nav.Position
            nav.Position    = targetPos + UDim2.fromOffset(0, -14)
            tween(nav, { Position = targetPos }, 0.3, Enum.EasingStyle.Quart)
            -- Restore sub-windows that were open
            for _, w in ipairs(lib.Windows) do
                if lib._subVisible[w] then
                    w.Frame.Visible = true
                    if w._homePos then
                        w.Frame.Position = w._homePos
                    end
                end
            end
        else
            -- Hide sub-windows, remember their state
            for _, w in ipairs(lib.Windows) do
                lib._subVisible[w] = w.Frame.Visible
                w.Frame.Visible    = false
            end
        end

        if lib.MainBlur then
            tween(lib.MainBlur, { Size = lib.GuiVisible and 6 or 0 }, 0.25)
        end
    end

    -- logo pill click
    logoBtn.MouseButton1Click:Connect(setExpanded.bind and nil or function()
        setExpanded(not expanded)
    end)
    logoBtn.MouseButton1Click:Connect(function()
        setExpanded(not expanded)
    end)

    -- logo bar hover effect
    logoBtn.MouseEnter:Connect(function()
        tween(logoBar, { BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
    end)
    logoBtn.MouseLeave:Connect(function()
        tween(logoBar, { BackgroundColor3 = lib.Theme.Elevated }, 0.1)
    end)

    -- keybind (RCtrl by default) toggles entire GUI visibility
    table.insert(lib.Connections, UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == lib.CurrentKeybind then
            toggleAll()
        end
    end))

    -- start hidden, notify user after brief delay
    nav.Visible = false
    task.delay(1.5, function()
        lib:Notify("fihware", "Press Right Ctrl to open the menu", 5, lib.Theme.Accent)
    end)

    -- ── Main API ─────────────────────────────────────────────────
    local Main = { Frame = nav, _accentObjects = accentObjs }

    function Main:GetFrame() return nav end
    function Main:SetKeybind(key) lib.CurrentKeybind = key end

    -- Nav window button (opens a sub-window)
    function Main:AddWindowButton(name, window, icon)
        elemCount = elemCount + 1
        local active = false

        local btn = Instance.new("TextButton")
        btn.Name                   = name .. "NavBtn"
        btn.Size                   = UDim2.new(1, 0, 0, 38)
        btn.BackgroundColor3       = lib.Theme.Elevated
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel        = 0
        btn.Text                   = ""
        btn.LayoutOrder            = elemCount
        btn.AutoButtonColor        = false
        btn.ZIndex                 = 2
        btn.Parent                 = scroll
        corner(btn, 7)

        -- left accent pip
        local pip = Instance.new("Frame")
        pip.Size                   = UDim2.new(0, 3, 0, 20)
        pip.AnchorPoint            = Vector2.new(0, 0.5)
        pip.Position               = UDim2.new(0, 0, 0.5, 0)
        pip.BackgroundColor3       = lib.Theme.Accent
        pip.BackgroundTransparency = 1
        pip.BorderSizePixel        = 0
        pip.ZIndex                 = 3
        pip.Parent                 = btn
        corner(pip, 2)
        table.insert(accentObjs, { obj = pip, type = "BackgroundColor3" })

        local iconImg
        if icon then
            iconImg = Instance.new("ImageLabel")
            iconImg.Size                   = UDim2.new(0, 15, 0, 15)
            iconImg.Position               = UDim2.new(0, 16, 0.5, -8)
            iconImg.BackgroundTransparency = 1
            iconImg.Image                  = icon
            iconImg.ImageColor3            = lib.Theme.SubText
            iconImg.ZIndex                 = 3
            iconImg.Parent                 = btn
        end

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size                   = UDim2.new(1, -50, 1, 0)
        nameLbl.Position               = UDim2.new(0, icon and 37 or 18, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text                   = name
        nameLbl.TextSize               = 13
        nameLbl.Font                   = Enum.Font.GothamMedium
        nameLbl.TextColor3             = lib.Theme.SubText
        nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
        nameLbl.ZIndex                 = 3
        nameLbl.Parent                 = btn

        local dot = Instance.new("Frame")
        dot.Size                   = UDim2.new(0, 5, 0, 5)
        dot.AnchorPoint            = Vector2.new(1, 0.5)
        dot.Position               = UDim2.new(1, -14, 0.5, 0)
        dot.BackgroundColor3       = lib.Theme.Accent
        dot.BackgroundTransparency = 1
        dot.BorderSizePixel        = 0
        dot.ZIndex                 = 3
        dot.Parent                 = btn
        corner(dot, 99)
        table.insert(accentObjs, { obj = dot, type = "BackgroundColor3" })

        local function setActive(v)
            active = v
            if window then window:SetVisible(v) end
            tween(nameLbl, { TextColor3 = v and lib.Theme.TextBright or lib.Theme.SubText }, 0.16)
            tween(dot,     { BackgroundTransparency = v and 0 or 1 }, 0.16)
            tween(pip,     { BackgroundTransparency = v and 0 or 1 }, 0.16)
            tween(btn, {
                BackgroundTransparency = v and 0 or 1,
                BackgroundColor3       = lib.Theme.Elevated,
            }, 0.16)
            if iconImg then
                tween(iconImg, { ImageColor3 = v and lib.Theme.Accent or lib.Theme.SubText }, 0.16)
            end
        end

        btn.MouseEnter:Connect(function()
            if not active then
                tween(btn,     { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
                tween(nameLbl, { TextColor3 = lib.Theme.Text }, 0.1)
                if iconImg then tween(iconImg, { ImageColor3 = lib.Theme.Text }, 0.1) end
            end
        end)
        btn.MouseLeave:Connect(function()
            if not active then
                tween(btn,     { BackgroundTransparency = 1 }, 0.1)
                tween(nameLbl, { TextColor3 = lib.Theme.SubText }, 0.1)
                if iconImg then tween(iconImg, { ImageColor3 = lib.Theme.SubText }, 0.1) end
            end
        end)
        btn.MouseButton1Click:Connect(function() setActive(not active) end)

        return {
            SetActive = setActive,
            GetActive = function() return active end,
            Frame     = btn,
        }
    end

    function Main:AddSection(name)
        elemCount = elemCount + 1; return W.section(lib, scroll, elemCount, name)
    end
    Main.CreateSection = Main.AddSection

    function Main:CreateLabel(cfg)       elemCount = elemCount + 1; return W.label(lib, scroll, elemCount, cfg) end
    function Main:CreateToggle(cfg)      elemCount = elemCount + 1; return W.toggle(lib, scroll, elemCount, accentObjs, cfg) end
    function Main:CreateSlider(cfg)      elemCount = elemCount + 1; return W.slider(lib, scroll, elemCount, accentObjs, cfg) end
    function Main:CreateDropdown(cfg)    elemCount = elemCount + 1; return W.dropdown(lib, scroll, elemCount, accentObjs, cfg) end
    function Main:CreateButton(cfg)      elemCount = elemCount + 1; return W.button(lib, scroll, elemCount, accentObjs, cfg) end
    function Main:CreateOutlineButton(cfg) elemCount = elemCount + 1; return W.outlineButton(lib, scroll, elemCount, accentObjs, cfg) end
