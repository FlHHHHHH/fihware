    pfp.AnchorPoint      = Vector2.new(0, 0.5)
    pfp.Position         = UDim2.new(0, 11, 0.5, 0)
    pfp.BackgroundColor3 = lib.Theme.Background
    pfp.BorderSizePixel  = 0
