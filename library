            sLbl.TextSize         = 10
            sLbl.Font             = Enum.Font.GothamBold
            sLbl.TextColor3       = lib.Theme.SubText
            sLbl.Parent           = bg
        end
    end

    -- ── Toggle ───────────────────────────────────────────────────
    function W:CreateToggle(cfg)
        local enabled = cfg.Default or false
        local eName   = cfg.Name    or "Toggle"
        elemCount     = elemCount + 1

        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1, 0, 0, 30)
        row.BackgroundColor3 = lib.Theme.Elevated
        row.BorderSizePixel  = 0
        row.LayoutOrder      = elemCount
        row.Parent           = scroll
        corner(row, 6)

        local btn = Instance.new("TextButton")
        btn.Size             = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text             = ""
        btn.AutoButtonColor  = false
        btn.Parent           = row

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size             = UDim2.new(1, -52, 1, 0)
        nameLbl.Position         = UDim2.new(0, 10, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text             = eName
        nameLbl.TextSize         = 13
        nameLbl.Font             = Enum.Font.GothamMedium
        nameLbl.TextColor3       = lib.Theme.Text
        nameLbl.TextXAlignment   = Enum.TextXAlignment.Left
        nameLbl.Parent           = row

        local pillBG = Instance.new("Frame")
        pillBG.Size             = UDim2.new(0, 34, 0, 17)
        pillBG.AnchorPoint      = Vector2.new(1, 0.5)
        pillBG.Position         = UDim2.new(1, -10, 0.5, 0)
        pillBG.BackgroundColor3 = enabled and lib.Theme.Accent or lib.Theme.Border
        pillBG.BorderSizePixel  = 0
        pillBG.Parent           = row
        corner(pillBG, 99)

        local pill = Instance.new("Frame")
        pill.Size             = UDim2.new(0, 11, 0, 11)
        pill.AnchorPoint      = Vector2.new(0, 0.5)
        pill.Position         = enabled and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
        pill.BackgroundColor3 = Color3.new(1, 1, 1)
        pill.BorderSizePixel  = 0
        pill.Parent           = pillBG
        corner(pill, 99)

        if cfg.HoverText and lib.TooltipsEnabled then
            local tip = Instance.new("TextLabel")
            tip.Size              = UDim2.new(0, 160, 0, 28)
            tip.Position          = UDim2.new(0, 10, 1, 4)
            tip.BackgroundColor3  = lib.Theme.Elevated
            tip.BorderSizePixel   = 0
            tip.Text              = cfg.HoverText
            tip.TextSize          = 11
            tip.Font              = Enum.Font.Gotham
            tip.TextColor3        = lib.Theme.SubText
            tip.TextWrapped       = true
            tip.Visible           = false
            tip.ZIndex            = 10
            tip.Parent            = row
            corner(tip, 5)
            stroke(tip, lib.Theme.Border)
            btn.MouseEnter:Connect(function() tip.Visible = true  end)
            btn.MouseLeave:Connect(function() tip.Visible = false end)
        end

        local api = { Enabled = enabled }

        local function setEnabled(val, silent)
            enabled     = val
            api.Enabled = val
            tween(pillBG, { BackgroundColor3 = val and lib.Theme.Accent or lib.Theme.Border }, 0.15)
            tween(pill,   { Position = val and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, 0.15)
            if not silent then
                if cfg.Function then pcall(cfg.Function, val) end
                if lib.ToggleAlertsEnabled then
                    lib:Notify("Toggle", eName .. " " .. (val and "enabled" or "disabled"), 2)
                end
            end
            lib.SavedObjects[eName]           = lib.SavedObjects[eName] or {}
            lib.SavedObjects[eName].SaveValue = val
        end

        btn.MouseEnter:Connect(function() tween(row, { BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1) end)
        btn.MouseLeave:Connect(function() tween(row, { BackgroundColor3 = lib.Theme.Elevated    }, 0.1) end)
        btn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)

        api.Set = function(val, silent) setEnabled(val, silent) end

        lib.SavedObjects[eName] = {
            SaveValue = enabled,
            Load = function(v) setEnabled(v, true) end,
            UpdateAccent = function(c)
                if enabled then pillBG.BackgroundColor3 = c end
            end,
        }

        if cfg.Default ~= nil then setEnabled(cfg.Default, true) end
        return api
    end

    -- ── Slider ───────────────────────────────────────────────────
    function W:CreateSlider(cfg)
        local min      = cfg.Min      or 0
        local max      = cfg.Max      or 100
        local value    = cfg.Default  or min
        local suffix   = cfg.Suffix   or ""
        local eName    = cfg.Name     or "Slider"
        local decimals = cfg.Decimals or 0
        elemCount      = elemCount + 1

        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1, 0, 0, 46)
        row.BackgroundColor3 = lib.Theme.Elevated
        row.BorderSizePixel  = 0
        row.LayoutOrder      = elemCount
        row.Parent           = scroll
        corner(row, 6)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size             = UDim2.new(0.6, 0, 0, 18)
        nameLbl.Position         = UDim2.new(0, 10, 0, 6)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text             = eName
        nameLbl.TextSize         = 13
        nameLbl.Font             = Enum.Font.GothamMedium
        nameLbl.TextColor3       = lib.Theme.Text
        nameLbl.TextXAlignment   = Enum.TextXAlignment.Left
        nameLbl.Parent           = row

        local function fmtVal(v)
            if decimals > 0 then
                return string.format("%." .. decimals .. "f", v) .. suffix
            end
            return tostring(math.floor(v)) .. suffix
        end

        local valLbl = Instance.new("TextLabel")
        valLbl.Size             = UDim2.new(0.4, -10, 0, 18)
        valLbl.AnchorPoint      = Vector2.new(1, 0)
        valLbl.Position         = UDim2.new(1, -10, 0, 6)
        valLbl.BackgroundTransparency = 1
        valLbl.Text             = fmtVal(value)
        valLbl.TextSize         = 12
        valLbl.Font             = Enum.Font.GothamMedium
        valLbl.TextColor3       = lib.Theme.SubText
        valLbl.TextXAlignment   = Enum.TextXAlignment.Right
        valLbl.Parent           = row

        local track = Instance.new("Frame")
        track.Size             = UDim2.new(1, -20, 0, 5)
        track.Position         = UDim2.new(0, 10, 0, 30)
        track.BackgroundColor3 = lib.Theme.Border
        track.BorderSizePixel  = 0
        track.Parent           = row
        corner(track, 99)

        local fill = Instance.new("Frame")
        fill.Size             = UDim2.new((value - min) / (max - min), 0, 1, 0)
        fill.BackgroundColor3 = lib.Theme.Accent
        fill.BorderSizePixel  = 0
        fill.Parent           = track
        corner(fill, 99)

        local knob = Instance.new("Frame")
        knob.Size             = UDim2.new(0, 12, 0, 12)
        knob.AnchorPoint      = Vector2.new(0.5, 0.5)
        knob.Position         = UDim2.new((value - min) / (max - min), 0, 0.5, 0)
        knob.BackgroundColor3 = Color3.new(1, 1, 1)
        knob.BorderSizePixel  = 0
        knob.ZIndex           = 2
        knob.Parent           = track
        corner(knob, 99)

        local hitbox = Instance.new("TextButton")
        hitbox.Size             = UDim2.new(1, 0, 0, 46)
        hitbox.Position         = UDim2.new(0, 0, 0, 0)
        hitbox.BackgroundTransparency = 1
        hitbox.Text             = ""
        hitbox.ZIndex           = 4
        hitbox.Parent           = row

        local dragging = false
        local api = { Value = value }

        local function updateSlider(x)
            local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            if decimals > 0 then
                value = math.floor((min + (max - min) * pct) * 10^decimals + 0.5) / 10^decimals
            else
                value = math.floor(min + (max - min) * pct + 0.5)
            end
            api.Value             = value
            fill.Size             = UDim2.new(pct, 0, 1, 0)
            knob.Position         = UDim2.new(pct, 0, 0.5, 0)
            valLbl.Text           = fmtVal(value)
            if cfg.Function then pcall(cfg.Function, value) end
            lib.SavedObjects[eName].SaveValue = value
        end

        hitbox.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true; updateSlider(i.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                updateSlider(i.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)

        lib.SavedObjects[eName] = {
            SaveValue = value,
            Load = function(v)
                value = v; api.Value = v
                local pct = (v - min) / (max - min)
                fill.Size     = UDim2.new(pct, 0, 1, 0)
                knob.Position = UDim2.new(pct, 0, 0.5, 0)
                valLbl.Text   = fmtVal(v)
                if cfg.Function then pcall(cfg.Function, v) end
            end,
            UpdateAccent = function(c) fill.BackgroundColor3 = c end,
        }

        return api
    end

    -- ── Dropdown ─────────────────────────────────────────────────
    function W:CreateDropdown(cfg)
        local eName    = cfg.Name    or "Dropdown"
        local list     = cfg.List    or {}
        local selected = cfg.Default or (list[1] or "")
        local open     = false
        elemCount      = elemCount + 1

        local container = Instance.new("Frame")
        container.Size             = UDim2.new(1, 0, 0, 30)
        container.BackgroundTransparency = 1
        container.ClipsDescendants = false
        container.LayoutOrder      = elemCount
        container.Parent           = scroll

        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1, 0, 0, 30)
        row.BackgroundColor3 = lib.Theme.Elevated
        row.BorderSizePixel  = 0
        row.ZIndex           = 3
        row.Parent           = container
        corner(row, 6)

        local btn = Instance.new("TextButton")
        btn.Size             = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text             = ""
        btn.AutoButtonColor  = false
        btn.ZIndex           = 4
        btn.Parent           = row

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size             = UDim2.new(0.55, 0, 1, 0)
        nameLbl.Position         = UDim2.new(0, 10, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text             = eName
        nameLbl.TextSize         = 13
        nameLbl.Font             = Enum.Font.GothamMedium
        nameLbl.TextColor3       = lib.Theme.Text
        nameLbl.TextXAlignment   = Enum.TextXAlignment.Left
        nameLbl.ZIndex           = 4
        nameLbl.Parent           = row

        local selLbl = Instance.new("TextLabel")
        selLbl.Size             = UDim2.new(0.4, -20, 1, 0)
        selLbl.AnchorPoint      = Vector2.new(1, 0)
        selLbl.Position         = UDim2.new(1, -20, 0, 0)
        selLbl.BackgroundTransparency = 1
        selLbl.Text             = selected
        selLbl.TextSize         = 12
        selLbl.Font             = Enum.Font.Gotham
        selLbl.TextColor3       = lib.Theme.Accent
        selLbl.TextXAlignment   = Enum.TextXAlignment.Right
        selLbl.TextTruncate     = Enum.TextTruncate.AtEnd
        selLbl.ZIndex           = 4
        selLbl.Parent           = row

        local arrow = Instance.new("TextLabel")
        arrow.Size             = UDim2.new(0, 14, 1, 0)
        arrow.AnchorPoint      = Vector2.new(1, 0)
        arrow.Position         = UDim2.new(1, -6, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text             = "▾"
        arrow.TextSize         = 11
        arrow.Font             = Enum.Font.Gotham
        arrow.TextColor3       = lib.Theme.SubText
        arrow.ZIndex           = 4
        arrow.Parent           = row

        local dropFrame = Instance.new("Frame")
        dropFrame.Size             = UDim2.new(1, 0, 0, 0)
        dropFrame.Position         = UDim2.new(0, 0, 1, 4)
        dropFrame.BackgroundColor3 = lib.Theme.Elevated
        dropFrame.BorderSizePixel  = 0
        dropFrame.ClipsDescendants = true
        dropFrame.ZIndex           = 10
        dropFrame.Visible          = false
        dropFrame.Parent           = container
        corner(dropFrame, 6)
        stroke(dropFrame, lib.Theme.Border)

        local dScroll = Instance.new("ScrollingFrame")
        dScroll.Size              = UDim2.new(1, 0, 1, 0)
        dScroll.BackgroundTransparency = 1
        dScroll.BorderSizePixel   = 0
        dScroll.ScrollBarThickness = 2
        dScroll.ScrollBarImageColor3 = lib.Theme.Accent
        dScroll.ZIndex            = 10
        dScroll.Parent            = dropFrame

        local dList = listLayout(dScroll, 2)
        pad(dScroll, 4, 4, 4, 4)

        local api = { Value = selected, List = list }

        local function closeDropdown()
            open = false
            tween(dropFrame, { Size = UDim2.new(1, 0, 0, 0) }, 0.13)
            task.wait(0.14)
            dropFrame.Visible = false
            container.Size    = UDim2.new(1, 0, 0, 30)
            tween(arrow, { Rotation = 0 }, 0.13)
        end

        local function populate()
            for _, c in pairs(dScroll:GetChildren()) do
                if c:IsA("Frame") then c:Destroy() end
            end
            for _, item in ipairs(list) do
                local opt = Instance.new("Frame")
                opt.Size             = UDim2.new(1, 0, 0, 26)
                opt.BackgroundColor3 = item == selected and lib.Theme.ElevatedHvr or Color3.fromRGB(0,0,0)
                opt.BackgroundTransparency = item == selected and 0 or 1
                opt.BorderSizePixel  = 0
                opt.ZIndex           = 11
                opt.Parent           = dScroll
                corner(opt, 4)

                local optBtn = Instance.new("TextButton")
                optBtn.Size             = UDim2.new(1, 0, 1, 0)
                optBtn.BackgroundTransparency = 1
                optBtn.Text             = item
                optBtn.TextSize         = 12
                optBtn.Font             = Enum.Font.GothamMedium
                optBtn.TextColor3       = item == selected and lib.Theme.Accent or lib.Theme.Text
                optBtn.TextXAlignment   = Enum.TextXAlignment.Left
                optBtn.ZIndex           = 12
                optBtn.AutoButtonColor  = false
                optBtn.Parent           = opt
                pad(optBtn, 0, 0, 0, 8)

                optBtn.MouseEnter:Connect(function()
                    if item ~= selected then
                        tween(opt, { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.08)
                    end
                end)
                optBtn.MouseLeave:Connect(function()
                    if item ~= selected then
                        tween(opt, { BackgroundTransparency = 1 }, 0.08)
                    end
                end)
                optBtn.MouseButton1Click:Connect(function()
                    selected   = item
                    api.Value  = item
                    selLbl.Text = item
                    if cfg.Function then pcall(cfg.Function, item) end
                    lib.SavedObjects[eName].SaveValue = item
                    closeDropdown()
                end)
            end
            return math.min(dList.AbsoluteContentSize.Y + 10, 160)
        end

        btn.MouseEnter:Connect(function() tween(row, { BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1) end)
        btn.MouseLeave:Connect(function() tween(row, { BackgroundColor3 = lib.Theme.Elevated    }, 0.1) end)
        btn.MouseButton1Click:Connect(function()
            open = not open
            if open then
                local h = populate()
                dropFrame.Visible = true
                dropFrame.Size    = UDim2.new(1, 0, 0, 0)
                tween(dropFrame, { Size = UDim2.new(1, 0, 0, h) }, 0.15)
                container.Size   = UDim2.new(1, 0, 0, 30 + h + 4)
                tween(arrow, { Rotation = 180 }, 0.15)
            else
                closeDropdown()
            end
        end)

        lib.SavedObjects[eName] = {
            SaveValue = selected,
            Load = function(v)
                selected = v; api.Value = v; selLbl.Text = v
                if cfg.Function then pcall(cfg.Function, v) end
            end,
            UpdateAccent = function(c) selLbl.TextColor3 = c end,
        }

        api.SetList = function(newList)
            list = newList; api.List = newList
        end

        return api
    end

    -- ── Button ───────────────────────────────────────────────────
    function W:CreateButton(cfg)
        local eName = cfg.Name or "Button"
        elemCount   = elemCount + 1

        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1, 0, 0, 30)
        row.BackgroundColor3 = lib.Theme.Elevated
        row.BorderSizePixel  = 0
        row.LayoutOrder      = elemCount
        row.Parent           = scroll
        corner(row, 6)
        stroke(row, lib.Theme.Border)

        local btn = Instance.new("TextButton")
        btn.Size             = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text             = eName
        btn.TextSize         = 13
        btn.Font             = Enum.Font.GothamBold
        btn.TextColor3       = lib.Theme.Accent
        btn.AutoButtonColor  = false
        btn.Parent           = row

        btn.MouseEnter:Connect(function()
            tween(row, { BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
        end)
        btn.MouseLeave:Connect(function()
            tween(row, { BackgroundColor3 = lib.Theme.Elevated }, 0.1)
        end)
        btn.MouseButton1Click:Connect(function()
            tween(row, { BackgroundColor3 = lib.Theme.Border }, 0.05)
            task.wait(0.08)
            tween(row, { BackgroundColor3 = lib.Theme.Elevated }, 0.12)
            if cfg.Function then pcall(cfg.Function) end
        end)

        local api = {}
        function api:SetText(t) btn.Text = t end
        return api
    end

    -- ── TextBox ──────────────────────────────────────────────────
    function W:CreateTextBox(cfg)
        local eName = cfg.Name    or "TextBox"
        local value = cfg.Default or ""
        elemCount   = elemCount + 1

        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1, 0, 0, 46)
        row.BackgroundColor3 = lib.Theme.Elevated
        row.BorderSizePixel  = 0
        row.LayoutOrder      = elemCount
        row.Parent           = scroll
        corner(row, 6)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size             = UDim2.new(1, -16, 0, 16)
        nameLbl.Position         = UDim2.new(0, 10, 0, 6)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text             = eName
        nameLbl.TextSize         = 11
        nameLbl.Font             = Enum.Font.GothamMedium
        nameLbl.TextColor3       = lib.Theme.SubText
        nameLbl.TextXAlignment   = Enum.TextXAlignment.Left
        nameLbl.Parent           = row

        local inputBG = Instance.new("Frame")
        inputBG.Size             = UDim2.new(1, -16, 0, 18)
        inputBG.Position         = UDim2.new(0, 8, 0, 23)
        inputBG.BackgroundColor3 = lib.Theme.Background
        inputBG.BorderSizePixel  = 0
        inputBG.Parent           = row
        corner(inputBG, 4)
        local inputStroke = stroke(inputBG, lib.Theme.Border)

        local input = Instance.new("TextBox")
        input.Size              = UDim2.new(1, -10, 1, 0)
        input.Position          = UDim2.new(0, 5, 0, 0)
        input.BackgroundTransparency = 1
        input.Text              = value
        input.PlaceholderText   = cfg.Placeholder or "Enter value..."
        input.PlaceholderColor3 = lib.Theme.SubText
        input.TextSize          = 12
        input.Font              = Enum.Font.Gotham
        input.TextColor3        = lib.Theme.Text
        input.TextXAlignment    = Enum.TextXAlignment.Left
        input.ClearTextOnFocus  = false
        input.Parent            = inputBG

        input.Focused:Connect(function()
            inputStroke.Color = lib.Theme.Accent
        end)
        input.FocusLost:Connect(function(enter)
            inputStroke.Color = lib.Theme.Border
            value = input.Text
            if cfg.FocusLost then pcall(cfg.FocusLost, value, enter) end
            lib.SavedObjects[eName].SaveValue = value
        end)

        lib.SavedObjects[eName] = {
            SaveValue = value,
            Load = function(v) input.Text = v; value = v end,
        }

        return { Value = value, Object = input }
    end

    -- ── Color Picker (Hue + Saturation + Value bars) ─────────────
    function W:CreateColorSlider(cfg)
        local eName = cfg.Name or "Color"
        local h = cfg.DefaultH or 0.58
        local s = cfg.DefaultS or 0.69
        local v = cfg.DefaultV or 1.0
        elemCount = elemCount + 1

        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1, 0, 0, 84)   -- taller: 3 bars
        row.BackgroundColor3 = lib.Theme.Elevated
        row.BorderSizePixel  = 0
        row.LayoutOrder      = elemCount
        row.Parent           = scroll
        corner(row, 6)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size             = UDim2.new(1, -50, 0, 16)
        nameLbl.Position         = UDim2.new(0, 10, 0, 5)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text             = eName
        nameLbl.TextSize         = 12
        nameLbl.Font             = Enum.Font.GothamMedium
        nameLbl.TextColor3       = lib.Theme.SubText
        nameLbl.TextXAlignment   = Enum.TextXAlignment.Left
        nameLbl.Parent           = row

        local swatch = Instance.new("Frame")
        swatch.Size             = UDim2.new(0, 24, 0, 14)
        swatch.AnchorPoint      = Vector2.new(1, 0)
        swatch.Position         = UDim2.new(1, -10, 0, 5)
        swatch.BackgroundColor3 = Color3.fromHSV(h, s, v)
        swatch.BorderSizePixel  = 0
        swatch.Parent           = row
        corner(swatch, 4)

        local function makeBar(yOff)
            local bar = Instance.new("Frame")
            bar.Size             = UDim2.new(1, -20, 0, 6)
            bar.Position         = UDim2.new(0, 10, 0, yOff)
            bar.BackgroundColor3 = Color3.new(1, 1, 1)
            bar.BorderSizePixel  = 0
            bar.Parent           = row
            corner(bar, 99)

            local k = Instance.new("Frame")
            k.Size             = UDim2.new(0, 10, 0, 10)
            k.AnchorPoint      = Vector2.new(0.5, 0.5)
            k.BackgroundColor3 = Color3.new(1, 1, 1)
            k.BorderSizePixel  = 0
            k.ZIndex           = 2
            k.Parent           = bar
            corner(k, 99)
            stroke(k, Color3.fromRGB(50, 50, 70))

            local hb = Instance.new("TextButton")
            hb.Size             = UDim2.new(1, 0, 0, 84)
            hb.Position         = UDim2.new(0, 0, 0, -(yOff - 6))
            hb.BackgroundTransparency = 1
            hb.Text             = ""
            hb.ZIndex           = 3
            hb.Parent           = bar
            return bar, k, hb
        end

        local hBar, hKnob, hHit = makeBar(26)
        local sBar, sKnob, sHit = makeBar(44)
        local vBar, vKnob, vHit = makeBar(62)

        -- Hue gradient
        local hGrad = Instance.new("UIGradient")
        hGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Color3.fromHSV(0,    1, 1)),
            ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
            ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
            ColorSequenceKeypoint.new(0.50, Color3.fromHSV(0.50, 1, 1)),
            ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
            ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
            ColorSequenceKeypoint.new(1,    Color3.fromHSV(1,    1, 1)),
        })
        hGrad.Parent = hBar

        local sGrad = Instance.new("UIGradient")
        sGrad.Color  = ColorSequence.new(Color3.fromHSV(h, 0, 1), Color3.fromHSV(h, 1, 1))
        sGrad.Parent = sBar

        local vGrad = Instance.new("UIGradient")
        vGrad.Color  = ColorSequence.new(Color3.fromHSV(h, s, 0), Color3.fromHSV(h, s, 1))
        vGrad.Parent = vBar

        hKnob.Position = UDim2.new(h, 0, 0.5, 0)
        sKnob.Position = UDim2.new(s, 0, 0.5, 0)
        vKnob.Position = UDim2.new(v, 0, 0.5, 0)

        local function fire()
            swatch.BackgroundColor3 = Color3.fromHSV(h, s, v)
            sGrad.Color = ColorSequence.new(Color3.fromHSV(h, 0, v), Color3.fromHSV(h, 1, v))
            vGrad.Color = ColorSequence.new(Color3.fromHSV(h, s, 0), Color3.fromHSV(h, s, 1))
            if cfg.Function then pcall(cfg.Function, h, s, v) end
            lib.SavedObjects[eName].SaveValue = { h = h, s = s, v = v }
        end

        local function barDrag(hitbox, bar, knob, setter)
            local dragging = false
            hitbox.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
                    local pct = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    knob.Position = UDim2.new(pct, 0, 0.5, 0)
                    setter(pct); fire()
                end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)
        end

        barDrag(hHit, hBar, hKnob, function(p) h = p end)
        barDrag(sHit, sBar, sKnob, function(p) s = p end)
        barDrag(vHit, vBar, vKnob, function(p) v = p end)

        local api = { Hue = h, Sat = s, Val = v }
        lib.SavedObjects[eName] = {
            SaveValue = { h = h, s = s, v = v },
            Load = function(d)
                h, s, v = d.h, d.s, d.v
                hKnob.Position = UDim2.new(h, 0, 0.5, 0)
                sKnob.Position = UDim2.new(s, 0, 0.5, 0)
                vKnob.Position = UDim2.new(v, 0, 0.5, 0)
                fire()
            end,
        }

        return api
    end

    -- ── Keybind ──────────────────────────────────────────────────
    function W:CreateKeybind(cfg)
        local eName     = cfg.Name    or "Keybind"
        local key       = cfg.Default or Enum.KeyCode.Unknown
        local capturing = false
        elemCount       = elemCount + 1

        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1, 0, 0, 30)
        row.BackgroundColor3 = lib.Theme.Elevated
        row.BorderSizePixel  = 0
        row.LayoutOrder      = elemCount
        row.Parent           = scroll
        corner(row, 6)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size             = UDim2.new(0.6, 0, 1, 0)
        nameLbl.Position         = UDim2.new(0, 10, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text             = eName
        nameLbl.TextSize         = 13
        nameLbl.Font             = Enum.Font.GothamMedium
        nameLbl.TextColor3       = lib.Theme.Text
        nameLbl.TextXAlignment   = Enum.TextXAlignment.Left
        nameLbl.Parent           = row

        local keyBtn = Instance.new("TextButton")
        keyBtn.Size             = UDim2.new(0, 64, 0, 18)
        keyBtn.AnchorPoint      = Vector2.new(1, 0.5)
        keyBtn.Position         = UDim2.new(1, -8, 0.5, 0)
        keyBtn.BackgroundColor3 = lib.Theme.Background
        keyBtn.BorderSizePixel  = 0
        keyBtn.Text             = key == Enum.KeyCode.Unknown and "None" or key.Name
        keyBtn.TextSize         = 11
        keyBtn.Font             = Enum.Font.GothamMedium
        keyBtn.TextColor3       = lib.Theme.SubText
        keyBtn.AutoButtonColor  = false
        keyBtn.Parent           = row
        corner(keyBtn, 4)
        stroke(keyBtn, lib.Theme.Border)

        local api = { Key = key }

        keyBtn.MouseButton1Click:Connect(function()
            if capturing then return end
            capturing         = true
            keyBtn.Text       = "..."
            keyBtn.TextColor3 = lib.Theme.Accent
        end)

        UserInputService.InputBegan:Connect(function(input, gp)
            if not gp and capturing and input.UserInputType == Enum.UserInputType.Keyboard then
                key           = input.KeyCode
                api.Key       = key
                capturing     = false
                keyBtn.Text   = key.Name
                keyBtn.TextColor3 = lib.Theme.SubText
                if cfg.Function then pcall(cfg.Function, key) end
                lib.SavedObjects[eName].SaveValue = key.Name
            end
        end)

        lib.SavedObjects[eName] = {
            SaveValue = key.Name,
            Load = function(v)
                local ok, k = pcall(function() return Enum.KeyCode[v] end)
                if ok and k then key = k; api.Key = k; keyBtn.Text = v end
            end,
        }

        return api
    end

    -- ── SetVisible / IsVisible ────────────────────────────────────
    function W:SetVisible(val)
        win.Visible   = val
        W._wasVisible = val
    end

    function W:IsVisible()
        return win.Visible
    end

    return W
end

