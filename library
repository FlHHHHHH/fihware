    function Main:CreateColorSlider(cfg) elemCount = elemCount + 1; return W.colorSlider(lib, scroll, elemCount, accentObjs, cfg) end
    function Main:CreateKeybind(cfg)     elemCount = elemCount + 1; return W.keybind(lib, scroll, elemCount, accentObjs, cfg) end

    -- ── Built-in settings ────────────────────────────────────────
    function Main:AddDefaultSettings()
