    pillLogo.Parent                 = pill

    local pillBtn = Instance.new("TextButton")
    pillBtn.Size                   = UDim2.new(1, 0, 1, 0)
    pillBtn.BackgroundTransparency = 1
    pillBtn.Text                   = ""
    pillBtn.AutoButtonColor        = false
    pillBtn.Parent                 = pill
    pillBtn.MouseEnter:Connect(function() tw(pill, { BackgroundColor3 = self.Theme.ElevatedHvr }, 0.12) end)
    pillBtn.MouseLeave:Connect(function() tw(pill, { BackgroundColor3 = self.Theme.Elevated },    0.12) end)
    pillBtn.MouseButton1Click:Connect(function() self:Toggle() end)

    self._pillFrame = pill

    -- Blur
    local blur = Instance.new("BlurEffect")
    blur.Size   = 0
    blur.Parent = Lighting
    self.MainBlur = blur

    -- Notification holder
    local nh = Instance.new("Frame")
    nh.Name                   = "NotifHolder"
    nh.Size                   = UDim2.new(0, 290, 0, 520)
    nh.AnchorPoint            = Vector2.new(1, 1)
    nh.Position               = UDim2.new(1, -14, 1, -14)
    nh.BackgroundTransparency = 1
    nh.Parent                 = root
    local nhList = listLayout(nh, 6)
    nhList.VerticalAlignment = Enum.VerticalAlignment.Bottom
    self.NotifHolder = nh

    -- Auto-save
    task.spawn(function()
        while task.wait(30) do
            if self.Initialized then self:SaveSettings() end
        end
    end)

    -- Rainbow loop
    task.spawn(function()
        while task.wait(0.03) do
            if self.RainbowEnabled and self.Initialized then
                self.RainbowHue = (self.RainbowHue + self.RainbowSpeed * 0.003) % 1
                self:SetAccent(self.RainbowHue, self.AccentS, self.AccentV)
            end
        end
    end)
end

function Fihware:SetVisible(val)
    self.GuiVisible = val
    if self.ScaleRoot   then self.ScaleRoot.Visible  = val end
    if self._pillFrame  then self._pillFrame.Visible  = not val end
    if self.MainBlur    then tw(self.MainBlur, { Size = val and 8 or 0 }, 0.25) end
end

function Fihware:Toggle() self:SetVisible(not self.GuiVisible) end

function Fihware:Destroy()
    self:SaveSettings()
    for _, c in pairs(self.Connections) do pcall(function() c:Disconnect() end) end
    if self.MainGui  then self.MainGui:Destroy()  end
    if self.MainBlur then self.MainBlur:Destroy() end
    self.Windows      = {}
    self.SavedObjects = {}
    self.Connections  = {}
    self.Initialized  = false
end

-- ================================================================
-- WINDOW LAYOUT
-- ================================================================
function Fihware:SortWindows()
    if not self.MainNavRef then return end

    -- Wait one frame so AbsolutePosition is valid
    task.defer(function()
        local navPos  = self.MainNavRef.AbsolutePosition
        local navSize = self.MainNavRef.AbsoluteSize
        local nx      = navPos.X + navSize.X + self.WindowGap
        local ny      = navPos.Y
        local tweenInfo = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

        for _, w in ipairs(self.Windows) do
            if w._wantsVisible then
                local targetPos = UDim2.new(0, nx, 0, ny)
                if not w.Frame.Visible then
                    w.Frame.Position = UDim2.new(0, nx + 18, 0, ny)
                    w.Frame.Visible  = true
                end
                TweenService:Create(w.Frame, tweenInfo, { Position = targetPos }):Play()
                nx = nx + w.Frame.AbsoluteSize.X + self.WindowGap
            end
        end
    end)
end

