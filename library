    local tbDivider = Instance.new("Frame")
    tbDivider.Size             = UDim2.new(1, 0, 0, 1)
    tbDivider.Position         = UDim2.new(0, 0, 1, 0)
    tbDivider.BackgroundColor3 = lib.Theme.Border
    tbDivider.BorderSizePixel  = 0
    tbDivider.ZIndex           = 3
    tbDivider.Parent           = tb

    local iconOffset = 14
    if config.Icon then
        local sizeV = config.IconSize or 16
        local icn = Instance.new("ImageLabel")
        icn.Size                   = UDim2.new(0, sizeV, 0, sizeV)
        icn.Position               = UDim2.new(0, 14, 0.5, -sizeV / 2)
        icn.BackgroundTransparency = 1
        icn.Image                  = config.Icon
        icn.ImageColor3            = lib.Theme.Accent
        icn.ZIndex                 = 3
        icn.Parent                 = tb
        table.insert(accentObjs, { obj = icn, type = "ImageColor3" })
        iconOffset = 14 + sizeV + 9
    end

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size                   = UDim2.new(1, -iconOffset - 14, 1, 0)
    titleLbl.Position               = UDim2.new(0, iconOffset, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text                   = name
    titleLbl.TextSize               = 14
    titleLbl.Font                   = Enum.Font.GothamBold
    titleLbl.TextColor3             = lib.Theme.TextBright
    titleLbl.TextXAlignment         = Enum.TextXAlignment.Left
    titleLbl.ZIndex                 = 3
    titleLbl.Parent                 = tb

    -- content scroll
    local scroll = Instance.new("ScrollingFrame")
    scroll.Name                   = "Content"
    scroll.Size                   = UDim2.new(1, 0, 1, -TB_H)
    scroll.Position               = UDim2.new(0, 0, 0, TB_H)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel        = 0
    scroll.ScrollBarThickness     = 3
    scroll.ScrollBarImageColor3   = lib.Theme.Accent
    scroll.CanvasSize             = UDim2.new(0, 0, 0, 0)
    scroll.ClipsDescendants       = true
    scroll.Parent                 = win
    table.insert(accentObjs, { obj = scroll, type = "ScrollBarImageColor3" })

    local contentList = listLayout(scroll, 4)
    pad(scroll, 10, 10, 10, 10)

    local function refreshSize()
        local ch = contentList.AbsoluteContentSize.Y + 24
        scroll.CanvasSize = UDim2.new(0, 0, 0, ch)
        tween(win, { Size = UDim2.new(0, lib.WindowWidth, 0, math.min(ch + TB_H, maxH)) }, 0.18)
    end
    contentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshSize)

    local Win = {
        Frame          = win,
        _accentObjects = accentObjs,
        _userDragged   = false,
        _wantsVisible  = false,
    }
    table.insert(lib.Windows, Win)

    makeDraggable(win, tb, function() Win._userDragged = true end)

    function Win:SetVisible(val)
        if val and not win.Visible then
            if not Win._userDragged then
                win.Position = lib:_getNextWindowPosition(Win)
            end
            local target = win.Position
            win.Position = target + UDim2.fromOffset(-20, 0)
            win.Visible = true
            tween(win, { Position = target }, 0.28, Enum.EasingStyle.Quart)
        elseif not val and win.Visible then
            tween(win, { Position = win.Position + UDim2.fromOffset(-12, 0) },
                  0.18, Enum.EasingStyle.Quart)
            task.delay(0.18, function()
                if not Win._wantsVisible then win.Visible = false end
            end)
        end
        Win._wantsVisible = val
    end

    function Win:IsVisible() return win.Visible end
    function Win:GetFrame() return win end

    function Win:CreateLabel(cfg)
        elemCount = elemCount + 1; return W.label(lib, scroll, elemCount, cfg)
    end
    function Win:CreateSection(sName)
        elemCount = elemCount + 1; return W.section(lib, scroll, elemCount, sName)
    end
    function Win:CreateToggle(cfg)
        elemCount = elemCount + 1; return W.toggle(lib, scroll, elemCount, accentObjs, cfg)
    end
    function Win:CreateSlider(cfg)
        elemCount = elemCount + 1; return W.slider(lib, scroll, elemCount, accentObjs, cfg)
    end
    function Win:CreateDropdown(cfg)
        elemCount = elemCount + 1; return W.dropdown(lib, scroll, elemCount, accentObjs, cfg)
    end
    function Win:CreateButton(cfg)
        elemCount = elemCount + 1; return W.button(lib, scroll, elemCount, accentObjs, cfg)
    end
    function Win:CreateOutlineButton(cfg)
        elemCount = elemCount + 1; return W.outlineButton(lib, scroll, elemCount, accentObjs, cfg)
    end
    function Win:CreateTextBox(cfg)
        elemCount = elemCount + 1; return W.textbox(lib, scroll, elemCount, accentObjs, cfg)
    end
    function Win:CreateColorSlider(cfg)
        elemCount = elemCount + 1; return W.colorSlider(lib, scroll, elemCount, accentObjs, cfg)
    end
    function Win:CreateKeybind(cfg)
        elemCount = elemCount + 1; return W.keybind(lib, scroll, elemCount, accentObjs, cfg)
    end

    return Win
end

return Fihware
