    function Main:AddWindowButton(name, window, icon)
        elemCount = elemCount + 1
        local active = false

        local btn = Instance.new("TextButton")
        btn.Name                   = name .. "NavBtn"
        btn.Size                   = UDim2.new(1, 0, 0, 36)
        btn.BackgroundColor3       = lib.Theme.Elevated
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel        = 0
        btn.Text                   = ""
        btn.LayoutOrder            = elemCount
        btn.AutoButtonColor        = false
        btn.Parent                 = scroll
        corner(btn, 6)

        local accentBar = Instance.new("Frame")
        accentBar.Size                   = UDim2.new(0, 2, 0, 18)
        accentBar.AnchorPoint            = Vector2.new(0, 0.5)
        accentBar.Position               = UDim2.new(0, 0, 0.5, 0)
        accentBar.BackgroundColor3       = lib.Theme.Accent
        accentBar.BackgroundTransparency = 1
        accentBar.BorderSizePixel        = 0
        accentBar.Parent                 = btn
        corner(accentBar, 1)
        table.insert(accentObjs, { obj = accentBar, type = "BackgroundColor3" })

        local iconImg
        if icon then
            iconImg = Instance.new("ImageLabel")
            iconImg.Size                   = UDim2.new(0, 15, 0, 15)
            iconImg.Position               = UDim2.new(0, 14, 0.5, -7)
            iconImg.BackgroundTransparency = 1
            iconImg.Image                  = icon
            iconImg.ImageColor3            = lib.Theme.SubText
            iconImg.Parent                 = btn
        end

        local nameLbl2 = Instance.new("TextLabel")
        nameLbl2.Size                   = UDim2.new(1, -46, 1, 0)
        nameLbl2.Position               = UDim2.new(0, icon and 35 or 16, 0, 0)
        nameLbl2.BackgroundTransparency = 1
        nameLbl2.Text                   = name
        nameLbl2.TextSize               = 13
        nameLbl2.Font                   = Enum.Font.GothamMedium
        nameLbl2.TextColor3             = lib.Theme.SubText
        nameLbl2.TextXAlignment         = Enum.TextXAlignment.Left
        nameLbl2.Parent                 = btn

        local stateDot = Instance.new("Frame")
        stateDot.Size                   = UDim2.new(0, 5, 0, 5)
        stateDot.AnchorPoint            = Vector2.new(1, 0.5)
        stateDot.Position               = UDim2.new(1, -14, 0.5, 0)
        stateDot.BackgroundColor3       = lib.Theme.Accent
        stateDot.BackgroundTransparency = 1
        stateDot.BorderSizePixel        = 0
        stateDot.Parent                 = btn
        corner(stateDot, 99)
        table.insert(accentObjs, { obj = stateDot, type = "BackgroundColor3" })

        local function setActive(v)
            active = v
            if window then window:SetVisible(v) end
            tween(nameLbl2,  { TextColor3 = v and lib.Theme.TextBright or lib.Theme.SubText }, 0.15)
            tween(stateDot,  { BackgroundTransparency = v and 0 or 1 }, 0.15)
            tween(accentBar, { BackgroundTransparency = v and 0 or 1 }, 0.15)
            tween(btn, {
                BackgroundTransparency = v and 0 or 1,
                BackgroundColor3       = lib.Theme.Elevated,
            }, 0.15)
            if iconImg then
                tween(iconImg, { ImageColor3 = v and lib.Theme.Accent or lib.Theme.SubText }, 0.15)
            end
        end

        btn.MouseEnter:Connect(function()
            if not active then
                tween(btn,      { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
                tween(nameLbl2, { TextColor3 = lib.Theme.Text }, 0.1)
                if iconImg then tween(iconImg, { ImageColor3 = lib.Theme.Text }, 0.1) end
            end
        end)
        btn.MouseLeave:Connect(function()
            if not active then
                tween(btn,      { BackgroundTransparency = 1 }, 0.1)
                tween(nameLbl2, { TextColor3 = lib.Theme.SubText }, 0.1)
                if iconImg then tween(iconImg, { ImageColor3 = lib.Theme.SubText }, 0.1) end
            end
        end)
        btn.MouseButton1Click:Connect(function() setActive(not active) end)

        return {
            SetActive = setActive,
            GetActive = function() return active end,
            Frame     = btn,
        }
    end

