    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size                   = UDim2.new(1, -iconOffset - 14, 1, 0)
    titleLbl.Position               = UDim2.new(0, iconOffset, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text                   = name
    titleLbl.TextSize               = 14
    titleLbl.Font                   = Enum.Font.GothamBold
    titleLbl.TextColor3             = lib.Theme.TextBright
    titleLbl.TextXAlignment         = Enum.TextXAlignment.Left
    titleLbl.ZIndex                 = 3
    titleLbl.Parent                 = tb

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size                   = UDim2.new(1, 0, 1, -TB_H)
    scroll.Position               = UDim2.new(0, 0, 0, TB_H)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel        = 0
    scroll.ScrollBarThickness     = 3
    scroll.ScrollBarImageColor3   = lib.Theme.Accent
    scroll.CanvasSize             = UDim2.new(0, 0, 0, 0)
    scroll.ClipsDescendants       = true
    scroll.Parent                 = win
    table.insert(accentList, { obj = scroll, prop = "ScrollBarImageColor3" })

    local contentList = listLayout(scroll, 4)
    pad(scroll, 10, 10, 10, 10)

    local function refreshSize()
        local ch = contentList.AbsoluteContentSize.Y + 24
        scroll.CanvasSize = UDim2.new(0, 0, 0, ch)
        tw(win, { Size = UDim2.new(0, lib.WindowWidth, 0, math.min(ch + TB_H, maxH)) }, 0.2)
    end
    contentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshSize)

    local Win = {
        Frame        = win,
        _accentList  = accentList,
        _wantsVisible = false,
    }
    table.insert(lib.Windows, Win)

    function Win:SetVisible(val)
        if Win._wantsVisible == val then return end
        Win._wantsVisible = val

        if val then
            lib:SortWindows()
        else
            local pos = win.Position
            TweenService:Create(win,
                TweenInfo.new(0.12, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
                { Position = UDim2.new(0, pos.X.Offset + 14, 0, pos.Y.Offset) }
            ):Play()

            task.delay(0.13, function()
                if not Win._wantsVisible then
                    win.Visible  = false
                    win.Position = UDim2.new(0, -lib.WindowWidth - 60, 0, 8)
                end
            end)

            lib:SortWindows()
        end
    end

    function Win:IsVisible()  return Win._wantsVisible end
    function Win:GetFrame()   return win end

    function Win:CreateLabel(cfg)         elemCount += 1; return W.label(lib, scroll, elemCount, cfg) end
    function Win:CreateSection(n)         elemCount += 1; return W.section(lib, scroll, elemCount, n) end
    function Win:CreateToggle(cfg)        elemCount += 1; return W.toggle(lib, scroll, elemCount, accentList, cfg) end
    function Win:CreateSlider(cfg)        elemCount += 1; return W.slider(lib, scroll, elemCount, accentList, cfg) end
    function Win:CreateDropdown(cfg)      elemCount += 1; return W.dropdown(lib, scroll, elemCount, accentList, cfg) end
    function Win:CreateButton(cfg)        elemCount += 1; return W.button(lib, scroll, elemCount, accentList, cfg) end
    function Win:CreateOutlineButton(cfg) elemCount += 1; return W.outlineButton(lib, scroll, elemCount, accentList, cfg) end
    function Win:CreateTextBox(cfg)       elemCount += 1; return W.textbox(lib, scroll, elemCount, accentList, cfg) end
    function Win:CreateColorSlider(cfg)   elemCount += 1; return W.colorSlider(lib, scroll, elemCount, accentList, cfg) end
    function Win:CreateKeybind(cfg)       elemCount += 1; return W.keybind(lib, scroll, elemCount, accentList, cfg) end

    return Win
end

return Fihware
