    logoLabel.Position         = UDim2.new(0, 12, 0, 0)
    logoLabel.BackgroundTransparency = 1
    logoLabel.Text             = title
    logoLabel.TextSize         = 15
    logoLabel.Font             = Enum.Font.GothamBold
    logoLabel.TextColor3       = lib.Theme.Accent
    logoLabel.TextXAlignment   = Enum.TextXAlignment.Left
    logoLabel.ZIndex           = 3
    logoLabel.Parent           = header

    local verLabel = Instance.new("TextLabel")
    verLabel.Size             = UDim2.new(0, 28, 0, 14)
    verLabel.AnchorPoint      = Vector2.new(1, 0.5)
    verLabel.Position         = UDim2.new(1, -8, 0.5, 0)
    verLabel.BackgroundColor3 = lib.Theme.AccentDark
    verLabel.BorderSizePixel  = 0
    verLabel.Text             = "v1.1"
    verLabel.TextSize         = 10
    verLabel.Font             = Enum.Font.GothamBold
    verLabel.TextColor3       = Color3.new(1, 1, 1)
    verLabel.ZIndex           = 3
    verLabel.Parent           = header
    corner(verLabel, 4)

    makeDraggable(nav, header)

    local navScroll = Instance.new("ScrollingFrame")
    navScroll.Name                = "NavScroll"
    navScroll.Size                = UDim2.new(1, 0, 1, -40)
    navScroll.Position            = UDim2.new(0, 0, 0, 40)
    navScroll.BackgroundTransparency = 1
    navScroll.BorderSizePixel     = 0
    navScroll.ScrollBarThickness  = 0
    navScroll.CanvasSize          = UDim2.new(0, 0, 0, 0)
    navScroll.ClipsDescendants    = true
    navScroll.Parent              = nav

    local navList = listLayout(navScroll, 2)
    pad(navScroll, 6, 6, 6, 6)

    local function updateNavSize()
        local h = navList.AbsoluteContentSize.Y + 18
        navScroll.CanvasSize = UDim2.new(0, 0, 0, h)
        tween(nav, { Size = UDim2.new(0, 178, 0, math.min(h + 40, 520)) }, 0.18)
    end
    navList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateNavSize)

    local Main = {}
    Main._nav = nav

    -- Keybind toggle
    local keyCon = UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and input.KeyCode == lib.CurrentKeybind then
            local newVis = not nav.Visible
            nav.Visible = newVis
            lib.GuiVisible = newVis
            tween(lib.MainBlur, { Size = newVis and 8 or 0 }, 0.25)
            for _, w in pairs(lib.Windows) do
                if w._wasVisible ~= nil then
                    w.Frame.Visible = newVis and w._wasVisible
                end
            end
        end
    end)
    table.insert(lib.Connections, keyCon)

    -- ── Section Divider ─────────────────────────────────────────
    function Main:AddSection(name)
        elemCount = elemCount + 1
        local sect = Instance.new("Frame")
        sect.Size             = UDim2.new(1, 0, 0, 22)
        sect.BackgroundTransparency = 1
        sect.LayoutOrder      = elemCount
        sect.Parent           = navScroll

