        })
        Main:CreateOutlineButton({
            Name     = "LOAD SETTINGS",
            Function = function()
                lib:LoadSettings()
                lib:Notify("Profile", "Settings loaded.", 2.5, lib.Theme.Success)
            end,
        })
    end

    return Main
end

-- ================================================================
-- SUB-WINDOW  — drift fixed, accent top-cap, spring animations
-- ================================================================
function Fihware:CreateWindow(config)
    config = config or {}
    self:_init()

    local lib        = self
    local name       = config.Name      or "Window"
    local maxH       = config.MaxHeight or 540
    local elemCount  = 0
    local accentObjs = {}

    local TB_H      = 46
    local CAP_H     = 3  -- accent top cap height

    local win = Instance.new("Frame")
    win.Name             = name .. "Window"
    win.Size             = UDim2.new(0, lib.WindowWidth, 0, TB_H + CAP_H)
    win.Position         = config.Position or UDim2.new(0, 270, 0, 8)
    win.BackgroundColor3 = lib.Theme.Surface
    win.BorderSizePixel  = 0
    win.ClipsDescendants = false
    win.Visible          = false
    win.Parent           = lib.ScaleRoot
    corner(win, 9)
    stroke(win, lib.Theme.Border)
    shadow(win, 0.42)

    -- accent top-cap line
    local cap = Instance.new("Frame")
    cap.Size             = UDim2.new(1, 0, 0, CAP_H)
    cap.BackgroundColor3 = lib.Theme.Accent
    cap.BorderSizePixel  = 0
    cap.ZIndex           = 4
    cap.Parent           = win
    corner(cap, 9)
    table.insert(accentObjs, { obj = cap, type = "BackgroundColor3" })

    -- Cover the bottom-left and bottom-right rounded parts of cap
    local capCover = Instance.new("Frame")
    capCover.Size             = UDim2.new(1, 0, 0.5, 0)
    capCover.AnchorPoint      = Vector2.new(0, 1)
    capCover.Position         = UDim2.new(0, 0, 1, 0)
    capCover.BackgroundColor3 = lib.Theme.Accent
    capCover.BorderSizePixel  = 0
    capCover.ZIndex           = 4
    capCover.Parent           = cap
    table.insert(accentObjs, { obj = capCover, type = "BackgroundColor3" })

    -- titlebar (sits below cap)
    local tb = Instance.new("Frame")
    tb.Name             = "Titlebar"
    tb.Size             = UDim2.new(1, 0, 0, TB_H)
    tb.Position         = UDim2.new(0, 0, 0, CAP_H)
    tb.BackgroundColor3 = lib.Theme.Elevated
    tb.BorderSizePixel  = 0
    tb.ZIndex           = 3
    tb.Parent           = win

    local tbCover = Instance.new("Frame")
    tbCover.Size             = UDim2.new(1, 0, 0, 10)
    tbCover.Position         = UDim2.new(0, 0, 1, -10)
    tbCover.BackgroundColor3 = lib.Theme.Elevated
    tbCover.BorderSizePixel  = 0
    tbCover.Parent           = tb

    local tbDivider = Instance.new("Frame")
    tbDivider.Size             = UDim2.new(1, 0, 0, 1)
    tbDivider.Position         = UDim2.new(0, 0, 1, 0)
    tbDivider.BackgroundColor3 = lib.Theme.Border
    tbDivider.BorderSizePixel  = 0
    tbDivider.ZIndex           = 4
    tbDivider.Parent           = tb

    local iconOff = 14
    if config.Icon then
        local sz = config.IconSize or 16
        local icn = Instance.new("ImageLabel")
        icn.Size                   = UDim2.new(0, sz, 0, sz)
        icn.Position               = UDim2.new(0, 14, 0.5, -sz / 2)
        icn.BackgroundTransparency = 1
        icn.Image                  = config.Icon
        icn.ImageColor3            = lib.Theme.Accent
        icn.ZIndex                 = 4
        icn.Parent                 = tb
        table.insert(accentObjs, { obj = icn, type = "ImageColor3" })
        iconOff = 14 + sz + 10
    end

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size                   = UDim2.new(1, -iconOff - 20, 1, 0)
    titleLbl.Position               = UDim2.new(0, iconOff, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text                   = name
    titleLbl.TextSize               = 14
    titleLbl.Font                   = Enum.Font.GothamBold
    titleLbl.TextColor3             = lib.Theme.TextBright
    titleLbl.TextXAlignment         = Enum.TextXAlignment.Left
    titleLbl.ZIndex                 = 4
    titleLbl.Parent                 = tb

    -- content scroll
    local scroll = Instance.new("ScrollingFrame")
    scroll.Name                   = "Content"
    scroll.Size                   = UDim2.new(1, 0, 1, -TB_H - CAP_H)
    scroll.Position               = UDim2.new(0, 0, 0, TB_H + CAP_H)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel        = 0
    scroll.ScrollBarThickness     = 3
    scroll.ScrollBarImageColor3   = lib.Theme.Accent
    scroll.CanvasSize             = UDim2.new(0, 0, 0, 0)
    scroll.ClipsDescendants       = true
    scroll.Parent                 = win
    table.insert(accentObjs, { obj = scroll, type = "ScrollBarImageColor3" })

    local contentList = listLayout(scroll, 4)
    pad(scroll, 10, 10, 10, 10)

    local function refreshSize()
        local ch = contentList.AbsoluteContentSize.Y + 24
        scroll.CanvasSize = UDim2.new(0, 0, 0, ch)
        tween(win, { Size = UDim2.new(0, lib.WindowWidth, 0, math.min(ch + TB_H + CAP_H, maxH)) }, 0.18)
    end
    contentList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(refreshSize)

    -- draggable by titlebar
    makeDraggable(win, tb)
    tb.InputBegan:Connect(function()
        -- mark as user-dragged so SortWindows won't override
        Win._userDragged = true
    end)

    -- ── DRIFT FIX: store canonical home position ─────────────────
    -- _homePos is set ONCE the first time the window opens.
    -- Show/hide always tweens TO _homePos, then resets to it after hiding.
    -- An _animating flag prevents overlapping tween accumulation.

    local Win = {
        Frame          = win,
        _accentObjects = accentObjs,
        _homePos       = nil,
        _animating     = false,
        _userDragged   = false,
    }
    table.insert(lib.Windows, Win)

    function Win:SetVisible(val)
        -- Debounce: ignore spam while animation is running
        if Win._animating then return end

        if val then
            -- Compute home position only once (or if user hasn't dragged it)
            if not Win._homePos then
                Win._homePos = lib:_getNextWindowPosition()
            end

            Win._animating = true

            -- Always start from a fixed offset to the left of home
            win.Position = Win._homePos + UDim2.fromOffset(-18, 0)
            win.Visible  = true
            tween(win, { Position = Win._homePos }, 0.28, Enum.EasingStyle.Quart)

            task.delay(0.30, function() Win._animating = false end)

        else
            if not win.Visible then return end

            Win._animating = true

            -- Slide out to fixed left offset (NOT relative to current pos — no drift)
            local hideTarget = (Win._homePos or win.Position) + UDim2.fromOffset(-18, 0)
            tween(win, { Position = hideTarget }, 0.20, Enum.EasingStyle.Quart)

            task.delay(0.21, function()
                win.Visible = false
                -- RESET position back to home so next open is clean
                if Win._homePos then
                    win.Position = Win._homePos
                end
                Win._animating = false
            end)
        end
    end

    function Win:IsVisible() return win.Visible end
    function Win:GetFrame()  return win end

    function Win:CreateLabel(cfg)         elemCount = elemCount + 1; return W.label(lib, scroll, elemCount, cfg) end
    function Win:CreateSection(s)         elemCount = elemCount + 1; return W.section(lib, scroll, elemCount, s) end
    function Win:CreateToggle(cfg)        elemCount = elemCount + 1; return W.toggle(lib, scroll, elemCount, accentObjs, cfg) end
    function Win:CreateSlider(cfg)        elemCount = elemCount + 1; return W.slider(lib, scroll, elemCount, accentObjs, cfg) end
    function Win:CreateDropdown(cfg)      elemCount = elemCount + 1; return W.dropdown(lib, scroll, elemCount, accentObjs, cfg) end
    function Win:CreateButton(cfg)        elemCount = elemCount + 1; return W.button(lib, scroll, elemCount, accentObjs, cfg) end
    function Win:CreateOutlineButton(cfg) elemCount = elemCount + 1; return W.outlineButton(lib, scroll, elemCount, accentObjs, cfg) end
    function Win:CreateTextBox(cfg)       elemCount = elemCount + 1; return W.textbox(lib, scroll, elemCount, accentObjs, cfg) end
    function Win:CreateColorSlider(cfg)   elemCount = elemCount + 1; return W.colorSlider(lib, scroll, elemCount, accentObjs, cfg) end
    function Win:CreateKeybind(cfg)       elemCount = elemCount + 1; return W.keybind(lib, scroll, elemCount, accentObjs, cfg) end

    return Win
end

return Fihware
