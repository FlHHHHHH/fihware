    end

    -- ── Built-in default settings (Vape-style) ─────────────────
    function Main:AddDefaultSettings()
        Main:AddSection("GUI SETTINGS")
        Main:CreateColorSlider({
            Name     = "GUI Theme",
            DefaultH = lib.AccentH,
            DefaultS = lib.AccentS,
            DefaultV = lib.AccentV,
            Function = function(h, s, v) lib:SetAccent(h, s, v) end,
        })
        Main:CreateToggle({
            Name      = "Blur Background",
            Default   = true,
            HoverText = "Blur the background of the GUI when open",
            Function  = function(v)
                if lib.MainBlur then tween(lib.MainBlur, { Size = v and 8 or 0 }, 0.25) end
            end,
        })
        Main:CreateToggle({
            Name      = "Notifications",
            Default   = true,
            HoverText = "Shows notifications in the bottom-right corner",
            Function  = function(v) lib.NotificationsEnabled = v end,
        })
        Main:CreateToggle({
            Name      = "Toggle Alert",
            Default   = true,
            HoverText = "Notifies you when a module is enabled/disabled",
            Function  = function(v) lib.ToggleAlertsEnabled = v end,
        })
        Main:CreateToggle({
            Name      = "Show Tooltips",
            Default   = true,
            HoverText = "Shows hover descriptions on modules",
            Function  = function(v) lib.TooltipsEnabled = v end,
        })
        Main:CreateToggle({
            Name      = "Rainbow",
            Default   = false,
            HoverText = "Cycles through theme colors automatically",
            Function  = function(v) lib.RainbowEnabled = v end,
        })
        Main:CreateSlider({
            Name     = "Rainbow Speed",
            Min      = 1,
            Max      = 100,
            Default  = 10,
            Function = function(v) lib.RainbowSpeed = math.max((v / 10) - 0.4, 0.05) end,
        })

        Main:AddSection("WINDOWS")
        Main:CreateOutlineButton({
            Name     = "SORT WINDOWS",
            Function = function() lib:SortWindows() end,
        })
        Main:CreateOutlineButton({
            Name     = "RESET POSITIONS",
            Function = function()
                if lib.MainNavRef then
                    tween(lib.MainNavRef, { Position = UDim2.new(0, 8, 0, 8) }, 0.2)
                end
                lib:SortWindows()
            end,
        })

        Main:AddSection("PROFILE")
        Main:CreateOutlineButton({
            Name     = "SAVE SETTINGS",
            Function = function()
                lib:SaveSettings()
                lib:Notify("Profile", "Settings saved", 2.5, lib.Theme.Success)
            end,
        })
        Main:CreateOutlineButton({
            Name     = "LOAD SETTINGS",
            Function = function()
                lib:LoadSettings()
                lib:Notify("Profile", "Settings loaded", 2.5, lib.Theme.Success)
            end,
        })
    end

    return Main
end

