    nav.BackgroundColor3 = lib.Theme.Surface
    nav.BorderSizePixel  = 0
    nav.ClipsDescendants = false
    nav.Parent           = lib.ScaleRoot
    corner(nav, 7)
    stroke(nav, lib.Theme.Border)
    shadow(nav, 0.55)
