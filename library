    -- ── Main window API ─────────────────────────────────────────
    local Main = { Frame = nav }

    function Main:AddWindowButton(name, window, icon)
        elemCount = elemCount + 1
        local active = false

        local btn = Instance.new("TextButton")
        btn.Name                   = name .. "Btn"
        btn.Size                   = UDim2.new(1, 0, 0, 36)
        btn.BackgroundColor3       = lib.Theme.Elevated
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel        = 0
        btn.Text                   = ""
        btn.LayoutOrder            = elemCount
        btn.AutoButtonColor        = false
        btn.Parent                 = scroll
        corner(btn, 6)

        local iconImg
        if icon then
            iconImg = makeIcon(btn, icon, 16, lib.Theme.Text, 2)
            -- Override the centered anchor to sit left-aligned
            iconImg.AnchorPoint = Vector2.new(0, 0.5)
            iconImg.Position    = UDim2.new(0, 12, 0.5, 0)
        end

        local nameLbl2 = Instance.new("TextLabel")
        nameLbl2.Size                   = UDim2.new(1, icon and -42 or -24, 1, 0)
        nameLbl2.Position               = UDim2.new(0, icon and 36 or 12, 0, 0)
        nameLbl2.BackgroundTransparency = 1
        nameLbl2.Text                   = name
        nameLbl2.TextSize               = 13
        nameLbl2.Font                   = Enum.Font.GothamMedium
        nameLbl2.TextColor3             = lib.Theme.SubText
        nameLbl2.TextXAlignment         = Enum.TextXAlignment.Left
        nameLbl2.Parent                 = btn

        local dot2 = Instance.new("Frame")
        dot2.Size                   = UDim2.new(0, 5, 0, 5)
        dot2.AnchorPoint            = Vector2.new(1, 0.5)
        dot2.Position               = UDim2.new(1, -12, 0.5, 0)
        dot2.BackgroundColor3       = lib.Theme.Accent
        dot2.BackgroundTransparency = 1
        dot2.BorderSizePixel        = 0
        dot2.Parent                 = btn
        corner(dot2, 99)
        table.insert(accentList, { obj = dot2, prop = "BackgroundColor3" })

        local function setActive(v)
            active = v
            if window then window:SetVisible(v) end
            tw(nameLbl2, { TextColor3 = v and lib.Theme.TextBright or lib.Theme.Text }, 0.18)
            tw(dot2, { BackgroundTransparency = v and 0 or 1 }, 0.18)
            tw(btn, {
                BackgroundTransparency = v and 0 or 1,
                BackgroundColor3       = lib.Theme.Elevated,
            }, 0.18)
            if iconImg then
                tw(iconImg, { ImageColor3 = v and lib.Theme.Accent or lib.Theme.Text }, 0.18)
            end
        end

        btn.MouseEnter:Connect(function()
            if active then return end
            tw(btn,      { BackgroundTransparency = 0.1, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
            tw(nameLbl2, { TextColor3 = lib.Theme.Text }, 0.1)
            if iconImg then tw(iconImg, { ImageColor3 = lib.Theme.TextBright }, 0.1) end
        end)
        btn.MouseLeave:Connect(function()
