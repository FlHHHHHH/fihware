    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = eName
    nameLbl.TextSize               = 13
    nameLbl.Font                   = Enum.Font.GothamMedium
    nameLbl.TextColor3             = lib.Theme.Text
    nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
    nameLbl.Parent                 = row

    local keyBtn = Instance.new("TextButton")
    keyBtn.Size             = UDim2.new(0, 76, 0, 21)
    keyBtn.AnchorPoint      = Vector2.new(1, 0.5)
    keyBtn.Position         = UDim2.new(1, -10, 0.5, 0)
    keyBtn.BackgroundColor3 = lib.Theme.Background
    keyBtn.BorderSizePixel  = 0
    keyBtn.Text             = key == Enum.KeyCode.Unknown and "None" or key.Name
    keyBtn.TextSize         = 11
    keyBtn.Font             = Enum.Font.GothamMedium
    keyBtn.TextColor3       = lib.Theme.SubText
    keyBtn.AutoButtonColor  = false
    keyBtn.Parent           = row
    corner(keyBtn, 5)
    stroke(keyBtn, lib.Theme.Border)

    local api = { Key = key }

    keyBtn.MouseButton1Click:Connect(function()
        if capturing then return end
        capturing         = true
        keyBtn.Text       = "..."
        keyBtn.TextColor3 = lib.Theme.Accent
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and capturing and input.UserInputType == Enum.UserInputType.Keyboard then
            key               = input.KeyCode
            api.Key           = key
            capturing         = false
            keyBtn.Text       = key.Name
            keyBtn.TextColor3 = lib.Theme.SubText
            if cfg.Function then pcall(cfg.Function, key) end
            if lib.SavedObjects[eName] then lib.SavedObjects[eName].SaveValue = key.Name end
        end
    end)

    lib.SavedObjects[eName] = {
        SaveValue = key.Name,
        Load = function(v)
            local ok, k = pcall(function() return Enum.KeyCode[v] end)
            if ok and k then key = k; api.Key = k; keyBtn.Text = v end
        end,
    }
    return api
end

-- ================================================================
-- CONSTRUCTOR
-- ================================================================
function Fihware.new()
    local self = setmetatable({}, Fihware)

    -- DARKER VAPE-INSPIRED THEME ────────────────────────────────
    self.Theme = {
        Accent       = Color3.fromRGB(80, 155, 255),
        AccentDark   = Color3.fromRGB(50, 110, 200),
        AccentText   = Color3.fromRGB(255, 255, 255),
        Background   = Color3.fromRGB(13, 12, 14),    -- darkest (input bg, base)
        Surface      = Color3.fromRGB(18, 17, 19),    -- main window body
        Elevated     = Color3.fromRGB(23, 22, 24),    -- rows / titlebar
        ElevatedHvr  = Color3.fromRGB(31, 30, 32),    -- hover state
        Border       = Color3.fromRGB(34, 33, 35),    -- outlines
        BorderLight  = Color3.fromRGB(48, 47, 49),    -- toggle indicator border
        Text         = Color3.fromRGB(208, 208, 210),
        TextBright   = Color3.fromRGB(238, 238, 240),
        SubText      = Color3.fromRGB(140, 140, 144),
        Muted        = Color3.fromRGB(88, 88, 92),
        Success      = Color3.fromRGB(70, 200, 130),
        Warning      = Color3.fromRGB(240, 170, 60),
        Error        = Color3.fromRGB(235, 80, 80),
    }

    self.SavedObjects   = {}
    self.Windows        = {}
    self.WindowGap      = 8
    self.WindowWidth    = 240   -- bigger sub-windows
    self.MainNavWidth   = 245   -- bigger main window
    self.Connections    = {}
    self.MainGui        = nil
    self.MainBlur       = nil
    self.MainScale      = nil
    self.ScaleRoot      = nil
    self.NotifHolder    = nil
    self.MainNavRef     = nil
    self.Initialized    = false

    self.RainbowEnabled = false
    self.RainbowHue     = 0.58
    self.RainbowSpeed   = 0.4

    self.AccentH = 0.58
    self.AccentS = 0.69
    self.AccentV = 1.0

    self.NotificationsEnabled = true
    self.ToggleAlertsEnabled  = true
    self.TooltipsEnabled      = true
    self.CurrentKeybind       = Enum.KeyCode.RightShift
    self.GuiVisible           = true

    -- copy icons table per instance
    self.Icons = {}
    for k, v in pairs(Icons) do self.Icons[k] = v end

    return self
end

-- ================================================================
-- ICON MANAGEMENT (custom user icons, NOT logo)
-- ================================================================
function Fihware:AddIcon(name, asset)
    assert(type(name) == "string" and name ~= "", "AddIcon: name must be a non-empty string")
    local id = tostring(asset)
    if not id:match("^rbxassetid://") then
        id = "rbxassetid://" .. (id:match("%d+") or "0")
    end
    self.Icons[name] = id
    return id
end

function Fihware:AddIcons(tbl)
    for k, v in pairs(tbl) do self:AddIcon(k, v) end
end

-- ================================================================
-- THEME / ACCENT
-- ================================================================
function Fihware:SetAccent(h, s, v)
    self.AccentH = h
    self.AccentS = s
    self.AccentV = v
    self.Theme.Accent     = Color3.fromHSV(h, s, v)
    self.Theme.AccentDark = Color3.fromHSV(h, math.min(s + 0.1, 1), v * 0.78)

    for _, obj in pairs(self.SavedObjects) do
        if obj.UpdateAccent then pcall(obj.UpdateAccent, self.Theme.Accent) end
    end

    local function applyAccentList(list)
        if not list then return end
        for _, aobj in pairs(list) do
            pcall(function()
                if aobj.type == "BackgroundColor3" then
                    aobj.obj.BackgroundColor3 = self.Theme.Accent
                elseif aobj.type == "TextColor3" then
                    aobj.obj.TextColor3 = self.Theme.Accent
                elseif aobj.type == "ImageColor3" then
                    aobj.obj.ImageColor3 = self.Theme.Accent
                elseif aobj.type == "ScrollBarImageColor3" then
                    aobj.obj.ScrollBarImageColor3 = self.Theme.Accent
                end
            end)
        end
    end

    for _, win in pairs(self.Windows) do applyAccentList(win._accentObjects) end
    applyAccentList(self._mainAccent)
end

-- ================================================================
-- SAVE / LOAD
-- ================================================================
function Fihware:SaveSettings()
    local data = { _accent = { h = self.AccentH, s = self.AccentS, v = self.AccentV } }
    for k, v in pairs(self.SavedObjects) do
        if v.SaveValue ~= nil then data[k] = v.SaveValue end
    end
    pcall(function()
        if not _isfolder("fihware") then _makefolder("fihware") end
        _writefile("fihware/" .. tostring(game.PlaceId) .. ".json",
            HttpService:JSONEncode(data))
    end)
end

function Fihware:LoadSettings()
    local ok, data = pcall(function()
        return HttpService:JSONDecode(_readfile("fihware/" .. tostring(game.PlaceId) .. ".json"))
    end)
    if not ok or type(data) ~= "table" then return end
    if data._accent then self:SetAccent(data._accent.h, data._accent.s, data._accent.v) end
    for k, v in pairs(data) do
        if k ~= "_accent" and self.SavedObjects[k] and self.SavedObjects[k].Load then
            pcall(self.SavedObjects[k].Load, v)
        end
    end
end

-- ================================================================
-- NOTIFICATIONS
-- ================================================================
function Fihware:Notify(title, body, duration, accentColor)
    if not self.NotificationsEnabled or not self.NotifHolder then return end
    duration    = duration    or 4
    accentColor = accentColor or self.Theme.Accent

    local notif = Instance.new("Frame")
    notif.Name                   = "Notification"
    notif.Size                   = UDim2.new(1, 0, 0, 58)
    notif.BackgroundColor3       = self.Theme.Surface
    notif.BorderSizePixel        = 0
    notif.BackgroundTransparency = 1
    notif.Parent                 = self.NotifHolder
    corner(notif, 6)
    stroke(notif, self.Theme.Border)
    shadow(notif, 0.6)

    tween(notif, { BackgroundTransparency = 0 }, 0.2)

    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(0, 3, 1, -16)
    bar.Position         = UDim2.new(0, 0, 0, 8)
    bar.BackgroundColor3 = accentColor
    bar.BorderSizePixel  = 0
    bar.Parent           = notif
    corner(bar, 2)

    local inner = Instance.new("Frame")
    inner.Size                   = UDim2.new(1, -16, 1, 0)
    inner.Position               = UDim2.new(0, 16, 0, 0)
    inner.BackgroundTransparency = 1
    inner.Parent                 = notif
    pad(inner, 9, 8, 9, 6)
    listLayout(inner, 3)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size                   = UDim2.new(1, 0, 0, 17)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text                   = title
    titleLbl.TextSize               = 14
    titleLbl.Font                   = Enum.Font.GothamBold
    titleLbl.TextColor3             = self.Theme.TextBright
    titleLbl.TextXAlignment         = Enum.TextXAlignment.Left
    titleLbl.LayoutOrder            = 1
