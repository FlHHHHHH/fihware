    function Main:CreateKeybind(cfg)       elemCount += 1; return W.keybind(lib, scroll, elemCount, accentList, cfg) end

    function Main:AddDefaultSettings()
        if lib.SettingsWin then return lib.SettingsWin end

        local S = lib:CreateWindow({ Name = "Settings", Icon = lib.Icons.Settings, MaxHeight = 520 })
        lib.SettingsWin = S

        S:CreateSection("APPEARANCE")
        S:CreateColorSlider({
            Name     = "Accent Color",
            DefaultH = lib.AccentH,
            DefaultS = lib.AccentS,
            DefaultV = lib.AccentV,
            Function = function(h, s, v) lib:SetAccent(h, s, v) end,
        })
        S:CreateToggle({
            Name     = "Rainbow Mode",
            Default  = false,
            Function = function(v) lib.RainbowEnabled = v end,
        })
        S:CreateSlider({
            Name     = "Rainbow Speed",
            Min      = 1, Max = 100, Default = 10,
            Function = function(v) lib.RainbowSpeed = math.max((v / 10) - 0.4, 0.05) end,
        })
        S:CreateToggle({
            Name     = "Blur Background",
            Default  = false,
            Function = function(v)
                if lib.MainBlur then tw(lib.MainBlur, { Size = v and 8 or 0 }, 0.25) end
            end,
        })

        S:CreateSection("BEHAVIOR")
        S:CreateToggle({
            Name     = "Notifications",
            Default  = true,
            Function = function(v) lib.NotificationsEnabled = v end,
        })
        S:CreateToggle({
            Name     = "Toggle Alerts",
            Default  = true,
            Function = function(v) lib.ToggleAlertsEnabled = v end,
        })
        S:CreateKeybind({
            Name     = "Menu Keybind",
            Default  = lib.CurrentKeybind,
            Function = function(k) lib.CurrentKeybind = k end,
        })

        S:CreateSection("WINDOWS")
        S:CreateOutlineButton({
            Name     = "SORT WINDOWS",
            Function = function() lib:SortWindows() end,
        })

        S:CreateSection("PROFILE")
        S:CreateOutlineButton({
            Name     = "SAVE SETTINGS",
            Function = function()
                lib:SaveSettings()
                lib:Notify("Profile", "Settings saved", 2.5, lib.Theme.Success)
            end,
        })
        S:CreateOutlineButton({
            Name     = "LOAD SETTINGS",
            Function = function()
                lib:LoadSettings()
                lib:Notify("Profile", "Settings loaded", 2.5, lib.Theme.Success)
            end,
        })

        return S
    end

    return Main
end

