    header.Parent           = nav
    corner(header, 8)

    local headerCover = Instance.new("Frame")
    headerCover.Size             = UDim2.new(1, 0, 0, 8)
    headerCover.Position         = UDim2.new(0, 0, 1, -8)
    headerCover.BackgroundColor3 = lib.Theme.Elevated
