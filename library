        dropFrame.ClipsDescendants = true
        dropFrame.ZIndex           = 10
        dropFrame.Visible          = false
        dropFrame.Parent           = container
        corner(dropFrame, 5)
        stroke(dropFrame, lib.Theme.Border)

        local dScroll = Instance.new("ScrollingFrame")
        dScroll.Size                   = UDim2.new(1, 0, 1, 0)
        dScroll.BackgroundTransparency = 1
        dScroll.BorderSizePixel        = 0
        dScroll.ScrollBarThickness     = 2
        dScroll.ScrollBarImageColor3   = lib.Theme.Accent
        dScroll.ZIndex                 = 10
        dScroll.Parent                 = dropFrame

        local dList = listLayout(dScroll, 2)
        pad(dScroll, 4, 4, 4, 4)

        local api = { Value = selected, List = list }

        local function closeDropdown()
            open = false
            tween(dropFrame, { Size = UDim2.new(1, 0, 0, 0) }, 0.13)
            task.wait(0.14)
            dropFrame.Visible = false
            container.Size    = UDim2.new(1, 0, 0, 30)
            tween(arrow, { Rotation = 0 }, 0.13)
        end

        local function populate()
            for _, c in pairs(dScroll:GetChildren()) do
                if c:IsA("Frame") then c:Destroy() end
            end
            for _, item in ipairs(list) do
                local opt = Instance.new("Frame")
                opt.Size                   = UDim2.new(1, 0, 0, 26)
                opt.BackgroundColor3       = item == selected and lib.Theme.ElevatedHvr or Color3.fromRGB(0,0,0)
                opt.BackgroundTransparency = item == selected and 0 or 1
                opt.BorderSizePixel        = 0
                opt.ZIndex                 = 11
                opt.Parent                 = dScroll
                corner(opt, 4)

                local optBtn = Instance.new("TextButton")
                optBtn.Size                   = UDim2.new(1, 0, 1, 0)
                optBtn.BackgroundTransparency = 1
                optBtn.Text                   = item
                optBtn.TextSize               = 12
                optBtn.Font                   = Enum.Font.GothamMedium
                optBtn.TextColor3             = item == selected and lib.Theme.Accent or lib.Theme.Text
                optBtn.TextXAlignment         = Enum.TextXAlignment.Left
                optBtn.ZIndex                 = 12
                optBtn.AutoButtonColor        = false
                optBtn.Parent                 = opt
                pad(optBtn, 0, 0, 0, 10)

                optBtn.MouseEnter:Connect(function()
                    if item ~= selected then
                        tween(opt, { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.08)
                    end
                end)
                optBtn.MouseLeave:Connect(function()
                    if item ~= selected then
                        tween(opt, { BackgroundTransparency = 1 }, 0.08)
                    end
                end)
                optBtn.MouseButton1Click:Connect(function()
                    selected   = item
                    api.Value  = item
                    selLbl.Text = item
                    if cfg.Function then pcall(cfg.Function, item) end
                    if lib.SavedObjects[eName] then lib.SavedObjects[eName].SaveValue = item end
                    closeDropdown()
                end)
            end
            return math.min(dList.AbsoluteContentSize.Y + 10, 160)
        end

        btn.MouseEnter:Connect(function()
            tween(row, { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
        end)
        btn.MouseLeave:Connect(function()
            tween(row, { BackgroundTransparency = 0.4, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
        end)
        btn.MouseButton1Click:Connect(function()
            open = not open
            if open then
                local h = populate()
                dropFrame.Visible = true
                dropFrame.Size    = UDim2.new(1, 0, 0, 0)
                tween(dropFrame, { Size = UDim2.new(1, 0, 0, h) }, 0.15)
                container.Size   = UDim2.new(1, 0, 0, 30 + h + 4)
                tween(arrow, { Rotation = 180 }, 0.15)
            else
                closeDropdown()
            end
        end)

        lib.SavedObjects[eName] = {
            SaveValue = selected,
            Load = function(v)
                selected   = v
                api.Value  = v
                selLbl.Text = v
                if cfg.Function then pcall(cfg.Function, v) end
            end,
            UpdateAccent = function(c) selLbl.TextColor3 = c end,
        }

        api.SetList = function(newList) list = newList; api.List = newList end

        return api
    end

    -- ── Button ───────────────────────────────────────────────────
    function W:CreateButton(cfg)
        cfg = cfg or {}
        local eName = cfg.Name or "Button"
        elemCount   = elemCount + 1

        local row = Instance.new("Frame")
        row.Size             = UDim2.new(1, 0, 0, 32)
        row.BackgroundColor3 = lib.Theme.Accent
        row.BorderSizePixel  = 0
        row.LayoutOrder      = elemCount
        row.Parent           = scroll
        corner(row, 5)
        table.insert(accentObjs, { obj = row, type = "BackgroundColor3" })

        local btn = Instance.new("TextButton")
        btn.Size                   = UDim2.new(1, 0, 1, 0)
        btn.BackgroundTransparency = 1
        btn.Text                   = eName
        btn.TextSize               = 13
        btn.Font                   = Enum.Font.GothamBold
        btn.TextColor3             = lib.Theme.AccentText
        btn.AutoButtonColor        = false
        btn.Parent                 = row

        btn.MouseEnter:Connect(function()
            tween(row, { BackgroundColor3 = lib.Theme.AccentDark }, 0.1)
        end)
        btn.MouseLeave:Connect(function()
            tween(row, { BackgroundColor3 = lib.Theme.Accent }, 0.1)
        end)
        btn.MouseButton1Click:Connect(function()
            tween(row, { Size = UDim2.new(1, 0, 0, 30) }, 0.06)
            task.wait(0.07)
            tween(row, { Size = UDim2.new(1, 0, 0, 32) }, 0.12)
            if cfg.Function then pcall(cfg.Function) end
        end)

        local api = {}
        function api:SetText(t) btn.Text = t end
        return api
    end

    -- ── TextBox ──────────────────────────────────────────────────
    function W:CreateTextBox(cfg)
        cfg = cfg or {}
        local eName = cfg.Name    or "TextBox"
        local value = cfg.Default or ""
        elemCount   = elemCount + 1

        local row = Instance.new("Frame")
        row.Size                   = UDim2.new(1, 0, 0, 48)
        row.BackgroundColor3       = lib.Theme.Elevated
        row.BackgroundTransparency = 0.4
        row.BorderSizePixel        = 0
        row.LayoutOrder            = elemCount
        row.Parent                 = scroll
        corner(row, 5)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size                   = UDim2.new(1, -16, 0, 14)
        nameLbl.Position               = UDim2.new(0, 12, 0, 6)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text                   = eName
        nameLbl.TextSize               = 11
        nameLbl.Font                   = Enum.Font.GothamMedium
        nameLbl.TextColor3             = lib.Theme.Muted
        nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
        nameLbl.Parent                 = row

        local inputBG = Instance.new("Frame")
        inputBG.Size             = UDim2.new(1, -16, 0, 22)
        inputBG.Position         = UDim2.new(0, 8, 0, 22)
        inputBG.BackgroundColor3 = lib.Theme.Background
        inputBG.BorderSizePixel  = 0
        inputBG.Parent           = row
        corner(inputBG, 4)
        local inputStroke = stroke(inputBG, lib.Theme.Border)

        local input = Instance.new("TextBox")
        input.Size                   = UDim2.new(1, -12, 1, 0)
        input.Position               = UDim2.new(0, 6, 0, 0)
        input.BackgroundTransparency = 1
        input.Text                   = value
        input.PlaceholderText        = cfg.Placeholder or "Enter value..."
        input.PlaceholderColor3      = lib.Theme.Muted
        input.TextSize               = 12
        input.Font                   = Enum.Font.Gotham
        input.TextColor3             = lib.Theme.TextBright
        input.TextXAlignment         = Enum.TextXAlignment.Left
        input.ClearTextOnFocus       = false
        input.Parent                 = inputBG

        input.Focused:Connect(function()
            tween(inputStroke, { Color = lib.Theme.Accent }, 0.1)
        end)
        input.FocusLost:Connect(function(enter)
            tween(inputStroke, { Color = lib.Theme.Border }, 0.1)
            value = input.Text
            if cfg.FocusLost then pcall(cfg.FocusLost, value, enter) end
            if lib.SavedObjects[eName] then lib.SavedObjects[eName].SaveValue = value end
        end)

        lib.SavedObjects[eName] = {
            SaveValue = value,
            Load      = function(v) input.Text = v; value = v end,
            UpdateAccent = function(c)
                if input:IsFocused() then inputStroke.Color = c end
            end,
        }

        return { Value = value, Object = input }
    end

    -- ── Color Slider (HSV bars) ──────────────────────────────────
    function W:CreateColorSlider(cfg)
        cfg = cfg or {}
        local eName    = cfg.Name     or "Color"
        local h        = cfg.DefaultH or 0.58
        local s        = cfg.DefaultS or 0.69
        local v        = cfg.DefaultV or 1.0
        elemCount      = elemCount + 1

        local row = Instance.new("Frame")
        row.Size                   = UDim2.new(1, 0, 0, 86)
        row.BackgroundColor3       = lib.Theme.Elevated
        row.BackgroundTransparency = 0.4
        row.BorderSizePixel        = 0
        row.LayoutOrder            = elemCount
        row.Parent                 = scroll
        corner(row, 5)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size                   = UDim2.new(1, -50, 0, 16)
        nameLbl.Position               = UDim2.new(0, 12, 0, 5)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text                   = eName
        nameLbl.TextSize               = 12
        nameLbl.Font                   = Enum.Font.GothamMedium
        nameLbl.TextColor3             = lib.Theme.Muted
        nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
        nameLbl.Parent                 = row

        local swatch = Instance.new("Frame")
        swatch.Size             = UDim2.new(0, 26, 0, 14)
        swatch.AnchorPoint      = Vector2.new(1, 0)
        swatch.Position         = UDim2.new(1, -12, 0, 6)
        swatch.BackgroundColor3 = Color3.fromHSV(h, s, v)
        swatch.BorderSizePixel  = 0
        swatch.Parent           = row
        corner(swatch, 3)
        stroke(swatch, lib.Theme.Border)

        local function makeBar(yOff)
            local bar = Instance.new("Frame")
            bar.Size             = UDim2.new(1, -24, 0, 6)
            bar.Position         = UDim2.new(0, 12, 0, yOff)
            bar.BackgroundColor3 = Color3.new(1, 1, 1)
            bar.BorderSizePixel  = 0
            bar.Parent           = row
            corner(bar, 99)

            local k = Instance.new("Frame")
            k.Size             = UDim2.new(0, 10, 0, 10)
            k.AnchorPoint      = Vector2.new(0.5, 0.5)
            k.BackgroundColor3 = Color3.new(1, 1, 1)
            k.BorderSizePixel  = 0
            k.ZIndex           = 2
            k.Parent           = bar
            corner(k, 99)
            stroke(k, Color3.fromRGB(40, 39, 40))

            local hb = Instance.new("TextButton")
            hb.Size                   = UDim2.new(1, 0, 0, 16)
            hb.Position               = UDim2.new(0, 0, 0, -5)
            hb.BackgroundTransparency = 1
            hb.Text                   = ""
            hb.ZIndex                 = 3
            hb.Parent                 = bar
            return bar, k, hb
        end

        local hBar, hKnob, hHit = makeBar(28)
        local sBar, sKnob, sHit = makeBar(46)
        local vBar, vKnob, vHit = makeBar(64)

        local hGrad = Instance.new("UIGradient")
        hGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Color3.fromHSV(0,    1, 1)),
            ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
            ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
            ColorSequenceKeypoint.new(0.50, Color3.fromHSV(0.50, 1, 1)),
            ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
            ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
            ColorSequenceKeypoint.new(1,    Color3.fromHSV(1,    1, 1)),
        })
        hGrad.Parent = hBar

        local sGrad = Instance.new("UIGradient")
        sGrad.Color  = ColorSequence.new(Color3.fromHSV(h, 0, 1), Color3.fromHSV(h, 1, 1))
        sGrad.Parent = sBar

        local vGrad = Instance.new("UIGradient")
        vGrad.Color  = ColorSequence.new(Color3.fromHSV(h, s, 0), Color3.fromHSV(h, s, 1))
        vGrad.Parent = vBar

        hKnob.Position = UDim2.new(h, 0, 0.5, 0)
        sKnob.Position = UDim2.new(s, 0, 0.5, 0)
        vKnob.Position = UDim2.new(v, 0, 0.5, 0)

        local function fire()
            swatch.BackgroundColor3 = Color3.fromHSV(h, s, v)
            sGrad.Color = ColorSequence.new(Color3.fromHSV(h, 0, v), Color3.fromHSV(h, 1, v))
            vGrad.Color = ColorSequence.new(Color3.fromHSV(h, s, 0), Color3.fromHSV(h, s, 1))
            if cfg.Function then pcall(cfg.Function, h, s, v) end
            if lib.SavedObjects[eName] then
                lib.SavedObjects[eName].SaveValue = { h = h, s = s, v = v }
            end
        end

        local function barDrag(hitbox, bar, knob, setter)
            local dragging = false
            hitbox.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    local pct = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    knob.Position = UDim2.new(pct, 0, 0.5, 0)
                    setter(pct); fire()
                end
            end)
            UserInputService.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                              or i.UserInputType == Enum.UserInputType.Touch) then
                    local pct = math.clamp((i.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    knob.Position = UDim2.new(pct, 0, 0.5, 0)
                    setter(pct); fire()
                end
            end)
            UserInputService.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)
        end

        barDrag(hHit, hBar, hKnob, function(p) h = p end)
        barDrag(sHit, sBar, sKnob, function(p) s = p end)
        barDrag(vHit, vBar, vKnob, function(p) v = p end)

        local api = { Hue = h, Sat = s, Val = v }
        lib.SavedObjects[eName] = {
            SaveValue = { h = h, s = s, v = v },
            Load = function(d)
                h, s, v = d.h, d.s, d.v
                api.Hue = h; api.Sat = s; api.Val = v
                hKnob.Position = UDim2.new(h, 0, 0.5, 0)
                sKnob.Position = UDim2.new(s, 0, 0.5, 0)
                vKnob.Position = UDim2.new(v, 0, 0.5, 0)
                fire()
            end,
        }

        return api
    end

    -- ── Keybind ──────────────────────────────────────────────────
    function W:CreateKeybind(cfg)
        cfg = cfg or {}
        local eName     = cfg.Name    or "Keybind"
        local key       = cfg.Default or Enum.KeyCode.Unknown
        local capturing = false
        elemCount       = elemCount + 1

        local row = Instance.new("Frame")
        row.Size                   = UDim2.new(1, 0, 0, 30)
        row.BackgroundColor3       = lib.Theme.Elevated
        row.BackgroundTransparency = 0.4
        row.BorderSizePixel        = 0
        row.LayoutOrder            = elemCount
        row.Parent                 = scroll
        corner(row, 5)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size                   = UDim2.new(0.6, 0, 1, 0)
        nameLbl.Position               = UDim2.new(0, 12, 0, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text                   = eName
        nameLbl.TextSize               = 13
        nameLbl.Font                   = Enum.Font.GothamMedium
        nameLbl.TextColor3             = lib.Theme.Text
        nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
        nameLbl.Parent                 = row

        local keyBtn = Instance.new("TextButton")
        keyBtn.Size             = UDim2.new(0, 70, 0, 19)
        keyBtn.AnchorPoint      = Vector2.new(1, 0.5)
        keyBtn.Position         = UDim2.new(1, -8, 0.5, 0)
        keyBtn.BackgroundColor3 = lib.Theme.Background
        keyBtn.BorderSizePixel  = 0
        keyBtn.Text             = key == Enum.KeyCode.Unknown and "None" or key.Name
        keyBtn.TextSize         = 11
        keyBtn.Font             = Enum.Font.GothamMedium
        keyBtn.TextColor3       = lib.Theme.SubText
        keyBtn.AutoButtonColor  = false
        keyBtn.Parent           = row
        corner(keyBtn, 4)
        stroke(keyBtn, lib.Theme.Border)

        local api = { Key = key }

        keyBtn.MouseButton1Click:Connect(function()
            if capturing then return end
            capturing         = true
            keyBtn.Text       = "..."
            keyBtn.TextColor3 = lib.Theme.Accent
        end)

        UserInputService.InputBegan:Connect(function(input, gp)
            if not gp and capturing and input.UserInputType == Enum.UserInputType.Keyboard then
                key               = input.KeyCode
                api.Key           = key
                capturing         = false
                keyBtn.Text       = key.Name
                keyBtn.TextColor3 = lib.Theme.SubText
                if cfg.Function then pcall(cfg.Function, key) end
                if lib.SavedObjects[eName] then lib.SavedObjects[eName].SaveValue = key.Name end
            end
        end)

        lib.SavedObjects[eName] = {
            SaveValue = key.Name,
            Load = function(v)
                local ok, k = pcall(function() return Enum.KeyCode[v] end)
                if ok and k then key = k; api.Key = k; keyBtn.Text = v end
            end,
        }

        return api
    end

    return W
end

