function W.keybind(lib, parent, layoutOrder, accentObjs, cfg)
    cfg = cfg or {}
    local eName     = cfg.Name    or "Keybind"
    local key       = cfg.Default or Enum.KeyCode.Unknown
    local capturing = false

    local row = Instance.new("Frame")
    row.Size                   = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3       = lib.Theme.Elevated
    row.BackgroundTransparency = 0.25
    row.BorderSizePixel        = 0
    row.LayoutOrder            = layoutOrder
    row.Parent                 = parent
    corner(row, 7)

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size                   = UDim2.new(0.55, 0, 1, 0)
    nameLbl.Position               = UDim2.new(0, 16, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = eName
    nameLbl.TextSize               = 13
    nameLbl.Font                   = Enum.Font.GothamMedium
    nameLbl.TextColor3             = lib.Theme.Text
    nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
    nameLbl.Parent                 = row

    local keyBtn = Instance.new("TextButton")
    keyBtn.Size             = UDim2.new(0, 80, 0, 22)
    keyBtn.AnchorPoint      = Vector2.new(1, 0.5)
    keyBtn.Position         = UDim2.new(1, -12, 0.5, 0)
    keyBtn.BackgroundColor3 = lib.Theme.Background
    keyBtn.BorderSizePixel  = 0
    keyBtn.Text             = key == Enum.KeyCode.Unknown and "None" or key.Name
    keyBtn.TextSize         = 11
    keyBtn.Font             = Enum.Font.GothamMedium
    keyBtn.TextColor3       = lib.Theme.SubText
    keyBtn.AutoButtonColor  = false
    keyBtn.Parent           = row
    corner(keyBtn, 6)
    stroke(keyBtn, lib.Theme.Border)

    local api = { Key = key }

    keyBtn.MouseButton1Click:Connect(function()
        if capturing then return end
        capturing         = true
        keyBtn.Text       = "..."
        keyBtn.TextColor3 = lib.Theme.Accent
    end)

    UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and capturing and input.UserInputType == Enum.UserInputType.Keyboard then
            key               = input.KeyCode
            api.Key           = key
            capturing         = false
            keyBtn.Text       = key.Name
            keyBtn.TextColor3 = lib.Theme.SubText
            if cfg.Function then pcall(cfg.Function, key) end
            if lib.SavedObjects[eName] then lib.SavedObjects[eName].SaveValue = key.Name end
        end
    end)

    lib.SavedObjects[eName] = {
        SaveValue = key.Name,
        Load = function(v_)
            local ok, k = pcall(function() return Enum.KeyCode[v_] end)
            if ok and k then key = k; api.Key = k; keyBtn.Text = v_ end
        end,
    }
    return api
end

-- ================================================================
-- CONSTRUCTOR
-- ================================================================
function Fihware.new()
    local self = setmetatable({}, Fihware)

    self.Theme = {
        Accent       = Color3.fromRGB(80, 155, 255),
        AccentDark   = Color3.fromRGB(48, 108, 210),
        AccentText   = Color3.fromRGB(255, 255, 255),
        Background   = Color3.fromRGB(10, 10, 12),
        Surface      = Color3.fromRGB(15, 14, 17),
        Elevated     = Color3.fromRGB(21, 20, 24),
        ElevatedHvr  = Color3.fromRGB(30, 29, 34),
        Border       = Color3.fromRGB(36, 35, 42),
        BorderLight  = Color3.fromRGB(54, 52, 62),
        Text         = Color3.fromRGB(200, 200, 208),
        TextBright   = Color3.fromRGB(236, 236, 242),
        SubText      = Color3.fromRGB(128, 126, 138),
        Muted        = Color3.fromRGB(74, 72, 84),
        Success      = Color3.fromRGB(60, 196, 115),
        Warning      = Color3.fromRGB(240, 162, 44),
        Error        = Color3.fromRGB(235, 68, 68),
    }

    self.SavedObjects   = {}
    self.Windows        = {}
    self.WindowGap      = 10
    self.WindowWidth    = 248
    self.MainNavWidth   = 252
    self.Connections    = {}
    self.MainGui        = nil
    self.MainBlur       = nil
    self.MainScale      = nil
    self.ScaleRoot      = nil
    self.NotifHolder    = nil
    self.MainNavRef     = nil
    self.Initialized    = false
    self._navExpanded   = false
    self._navFullH      = 0
    self._subVisible    = {}  -- store sub-window visibility before hide

    self.RainbowEnabled = false
    self.RainbowHue     = 0.58
    self.RainbowSpeed   = 0.4
    self.AccentH = 0.58
    self.AccentS = 0.69
    self.AccentV = 1.0

    self.NotificationsEnabled = true
    self.ToggleAlertsEnabled  = false  -- off by default (less noise)
    self.TooltipsEnabled      = true
    self.CurrentKeybind       = Enum.KeyCode.RightControl
    self.GuiVisible           = false  -- starts hidden

    self.Icons = {}
    for k, v in pairs(Icons) do self.Icons[k] = v end

    return self
end

-- ================================================================
-- ICON MANAGEMENT
-- ================================================================
function Fihware:AddIcon(name, asset)
    assert(type(name) == "string" and name ~= "", "AddIcon: name must be non-empty")
    local id = tostring(asset)
    if not id:match("^rbxassetid://") then
        id = "rbxassetid://" .. (id:match("%d+") or "0")
    end
    self.Icons[name] = id
    return id
end

function Fihware:AddIcons(tbl)
    for k, v in pairs(tbl) do self:AddIcon(k, v) end
end

-- ================================================================
-- ACCENT / THEME
-- ================================================================
function Fihware:SetAccent(h, s, v)
    self.AccentH = h; self.AccentS = s; self.AccentV = v
    self.Theme.Accent     = Color3.fromHSV(h, s, v)
    self.Theme.AccentDark = Color3.fromHSV(h, math.min(s + 0.08, 1), v * 0.76)

    for _, obj in pairs(self.SavedObjects) do
        if obj.UpdateAccent then pcall(obj.UpdateAccent, self.Theme.Accent) end
    end

    local function applyList(list)
        if not list then return end
        for _, aobj in pairs(list) do
            pcall(function()
                local t = aobj.type
                if t == "BackgroundColor3" then
                    aobj.obj.BackgroundColor3 = self.Theme.Accent
                elseif t == "TextColor3" then
                    aobj.obj.TextColor3 = self.Theme.Accent
                elseif t == "ImageColor3" then
                    aobj.obj.ImageColor3 = self.Theme.Accent
                elseif t == "ScrollBarImageColor3" then
                    aobj.obj.ScrollBarImageColor3 = self.Theme.Accent
                elseif t == "Color" then
                    aobj.obj.Color = self.Theme.Accent
                end
                -- BackgroundColor3_Toggle handled by SavedObjects.UpdateAccent
            end)
        end
    end

    for _, win in pairs(self.Windows) do applyList(win._accentObjects) end
    applyList(self._mainAccent)
end

-- ================================================================
-- SAVE / LOAD
-- ================================================================
function Fihware:SaveSettings()
    local data = { _accent = { h = self.AccentH, s = self.AccentS, v = self.AccentV } }
    for k, v in pairs(self.SavedObjects) do
        if v.SaveValue ~= nil then data[k] = v.SaveValue end
    end
    pcall(function()
        if not _isfolder("fihware") then _makefolder("fihware") end
        _writefile("fihware/" .. tostring(game.PlaceId) .. ".json", HttpService:JSONEncode(data))
    end)
end

function Fihware:LoadSettings()
    local ok, data = pcall(function()
        return HttpService:JSONDecode(_readfile("fihware/" .. tostring(game.PlaceId) .. ".json"))
    end)
    if not ok or type(data) ~= "table" then return end
    if data._accent then self:SetAccent(data._accent.h, data._accent.s, data._accent.v) end
    for k, v in pairs(data) do
        if k ~= "_accent" and self.SavedObjects[k] and self.SavedObjects[k].Load then
            pcall(self.SavedObjects[k].Load, v)
        end
    end
end

-- ================================================================
-- NOTIFICATIONS
-- ================================================================
function Fihware:Notify(title, body, duration, accentColor)
    if not self.NotificationsEnabled or not self.NotifHolder then return end
    duration    = duration    or 4
    accentColor = accentColor or self.Theme.Accent

    local notif = Instance.new("Frame")
    notif.Name                   = "Notification"
    notif.Size                   = UDim2.new(1, 0, 0, 60)
    notif.BackgroundColor3       = self.Theme.Surface
    notif.BorderSizePixel        = 0
    notif.BackgroundTransparency = 1
    notif.Parent                 = self.NotifHolder
    corner(notif, 7)
    stroke(notif, self.Theme.Border)
    shadow(notif, 0.55)

    -- Slide in from right
    notif.Position = UDim2.new(1, 10, 0, 0)
