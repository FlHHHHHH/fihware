        dot.BorderSizePixel  = 0
        dot.Parent           = btn
        corner(dot, 99)

        local function setActive(v)
            active = v
            if window then
                window.Frame.Visible = v
                window._wasVisible   = v
            end
            tween(nameLbl, { TextColor3 = v and lib.Theme.Accent or lib.Theme.SubText }, 0.15)
            tween(dot,     { BackgroundTransparency = v and 0 or 1 }, 0.15)
            tween(btn,     { BackgroundColor3 = v and lib.Theme.ElevatedHvr or lib.Theme.Elevated }, 0.15)
            if iconImg then
                tween(iconImg, { ImageColor3 = v and lib.Theme.Accent or lib.Theme.SubText }, 0.15)
            end
        end

        btn.MouseEnter:Connect(function()
            if not active then tween(btn, { BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1) end
        end)
        btn.MouseLeave:Connect(function()
            if not active then tween(btn, { BackgroundColor3 = lib.Theme.Elevated }, 0.1) end
        end)
        btn.MouseButton1Click:Connect(function()
            setActive(not active)
        end)

        return {
            SetActive = setActive,
            GetActive = function() return active end,
        }
    end

    function Main:SetKeybind(key)
        lib.CurrentKeybind = key
    end

    return Main
end

