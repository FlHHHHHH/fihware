function Fihware.new()
    local self = setmetatable({}, Fihware)

    self.Theme = {
        Accent       = Color3.fromRGB(80, 155, 255),
        AccentDark   = Color3.fromRGB(50, 110, 200),
        AccentText   = Color3.fromRGB(255, 255, 255),
        Background   = Color3.fromRGB(20, 19, 20),
        Surface      = Color3.fromRGB(26, 25, 26),
        Elevated     = Color3.fromRGB(31, 30, 31),
        ElevatedHvr  = Color3.fromRGB(38, 37, 38),
        Border       = Color3.fromRGB(40, 39, 40),
        BorderLight  = Color3.fromRGB(54, 53, 54),
        Text         = Color3.fromRGB(201, 201, 201),
        TextBright   = Color3.fromRGB(230, 230, 230),
        SubText      = Color3.fromRGB(137, 136, 137),
        Muted        = Color3.fromRGB(85, 84, 85),
        Success      = Color3.fromRGB(70, 200, 130),
        Warning      = Color3.fromRGB(240, 170, 60),
        Error        = Color3.fromRGB(235, 80, 80),
    }

    self.SavedObjects   = {}
    self.Windows        = {}
    self.WindowGap      = 8
    self.WindowWidth    = 215
    self.MainNavWidth   = 178
    self.Connections    = {}
    self.MainGui        = nil
    self.MainBlur       = nil
    self.MainScale      = nil
    self.ScaleRoot      = nil
    self.NotifHolder    = nil
    self.Initialized    = false
    self.MainNavRef     = nil

    self.RainbowEnabled = false
    self.RainbowHue     = 0.58
    self.RainbowSpeed   = 0.4

    self.AccentH = 0.58
    self.AccentS = 0.69
    self.AccentV = 1.0

    self.NotificationsEnabled = true
    self.ToggleAlertsEnabled  = true
    self.TooltipsEnabled      = true
    self.CurrentKeybind       = Enum.KeyCode.RightShift
    self.GuiVisible           = true

    self.Icons = {}
    for k, v in pairs(Icons) do self.Icons[k] = v end

    return self
end

-- ================================================================
-- ICON MANAGEMENT
-- ================================================================
function Fihware:AddIcon(name, asset)
    assert(type(name) == "string" and name ~= "", "AddIcon: name must be a non-empty string")
    local id = tostring(asset)
    if not id:match("^rbxassetid://") then
        id = "rbxassetid://" .. (id:match("%d+") or "0")
    end
    self.Icons[name] = id
    return id
end

function Fihware:AddIcons(tbl)
    for k, v in pairs(tbl) do self:AddIcon(k, v) end
end

-- ================================================================
-- INTERNAL HELPERS
-- ================================================================
local function tween(obj, props, t, style, dir)
    if not obj or not obj.Parent then return end
    local twn = TweenService:Create(obj, TweenInfo.new(
        t     or 0.15,
        style or Enum.EasingStyle.Quad,
        dir   or Enum.EasingDirection.Out
    ), props)
    twn:Play()
    return twn
end

local function corner(parent, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(40, 39, 40)
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function pad(parent, t, r, b, l)
    local p = Instance.new("UIPadding")
    p.PaddingTop    = UDim.new(0, t or 6)
    p.PaddingRight  = UDim.new(0, r or 8)
    p.PaddingBottom = UDim.new(0, b or 6)
    p.PaddingLeft   = UDim.new(0, l or 8)
    p.Parent = parent
    return p
end

local function listLayout(parent, gap, dir)
    local l = Instance.new("UIListLayout")
    l.Padding       = UDim.new(0, gap or 3)
    l.FillDirection = dir or Enum.FillDirection.Vertical
    l.SortOrder     = Enum.SortOrder.LayoutOrder
    l.Parent        = parent
    return l
end

local function shadow(parent, transparency)
    local img = Instance.new("ImageLabel")
    img.Name                   = "_Shadow"
    img.AnchorPoint            = Vector2.new(0.5, 0.5)
    img.Position               = UDim2.new(0.5, 0, 0.5, 6)
    img.Size                   = UDim2.new(1, 36, 1, 36)
    img.BackgroundTransparency = 1
    img.Image                  = "rbxassetid://6014261993"
    img.ImageColor3            = Color3.new(0, 0, 0)
    img.ImageTransparency      = transparency or 0.55
    img.ScaleType              = Enum.ScaleType.Slice
    img.SliceCenter            = Rect.new(49, 49, 450, 450)
    img.ZIndex                 = -1
    img.Parent                 = parent
    return img
end

local function makeDraggable(frame, handle, onDragStart)
    handle = handle or frame
    local dragging, dragStart, startPos
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = i.Position
            startPos  = frame.Position
            if onDragStart then onDragStart() end
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                       or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- ================================================================
-- THEME / ACCENT
-- ================================================================
function Fihware:SetAccent(h, s, v)
    self.AccentH = h
    self.AccentS = s
    self.AccentV = v
    self.Theme.Accent = Color3.fromHSV(h, s, v)
    local darkAccent = Color3.fromHSV(h, math.min(s + 0.1, 1), v * 0.75)
    self.Theme.AccentDark = darkAccent

    for _, obj in pairs(self.SavedObjects) do
        if obj.UpdateAccent then
            pcall(obj.UpdateAccent, self.Theme.Accent)
        end
    end

    for _, win in pairs(self.Windows) do
        if win._accentObjects then
            for _, aobj in pairs(win._accentObjects) do
                pcall(function()
                    if aobj.type == "BackgroundColor3" then
                        aobj.obj.BackgroundColor3 = self.Theme.Accent
                    elseif aobj.type == "TextColor3" then
                        aobj.obj.TextColor3 = self.Theme.Accent
                    elseif aobj.type == "ImageColor3" then
                        aobj.obj.ImageColor3 = self.Theme.Accent
                    elseif aobj.type == "ScrollBarImageColor3" then
                        aobj.obj.ScrollBarImageColor3 = self.Theme.Accent
                    end
                end)
            end
        end
    end
end

-- ================================================================
-- SAVE / LOAD
-- ================================================================
function Fihware:SaveSettings()
    local data = { _accent = { h = self.AccentH, s = self.AccentS, v = self.AccentV } }
    for k, v in pairs(self.SavedObjects) do
        if v.SaveValue ~= nil then data[k] = v.SaveValue end
    end
    pcall(function()
        if not _isfolder("fihware") then _makefolder("fihware") end
        _writefile("fihware/" .. tostring(game.PlaceId) .. ".json", HttpService:JSONEncode(data))
    end)
end

function Fihware:LoadSettings()
    local ok, data = pcall(function()
        return HttpService:JSONDecode(_readfile("fihware/" .. tostring(game.PlaceId) .. ".json"))
    end)
    if not ok or type(data) ~= "table" then return end
    if data._accent then
        self:SetAccent(data._accent.h, data._accent.s, data._accent.v)
    end
    for k, v in pairs(data) do
        if k ~= "_accent" and self.SavedObjects[k] and self.SavedObjects[k].Load then
            pcall(self.SavedObjects[k].Load, v)
        end
    end
end

-- ================================================================
-- NOTIFICATIONS
-- ================================================================
function Fihware:Notify(title, body, duration, accentColor)
    if not self.NotificationsEnabled or not self.NotifHolder then return end
    duration    = duration    or 4
    accentColor = accentColor or self.Theme.Accent

    local notif = Instance.new("Frame")
    notif.Name                   = "Notification"
    notif.Size                   = UDim2.new(1, 0, 0, 54)
    notif.BackgroundColor3       = self.Theme.Surface
    notif.BorderSizePixel        = 0
    notif.BackgroundTransparency = 1
    notif.Parent                 = self.NotifHolder
    corner(notif, 6)
    stroke(notif, self.Theme.Border)
    shadow(notif, 0.7)

    tween(notif, { BackgroundTransparency = 0 }, 0.2)

    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(0, 3, 1, -14)
    bar.Position         = UDim2.new(0, 0, 0, 7)
    bar.BackgroundColor3 = accentColor
    bar.BorderSizePixel  = 0
    bar.Parent           = notif
    corner(bar, 2)

    local inner = Instance.new("Frame")
    inner.Size                   = UDim2.new(1, -14, 1, 0)
    inner.Position               = UDim2.new(0, 14, 0, 0)
    inner.BackgroundTransparency = 1
    inner.Parent                 = notif
    pad(inner, 8, 8, 8, 6)
    listLayout(inner, 3)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size                   = UDim2.new(1, 0, 0, 16)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text                   = title
    titleLbl.TextSize               = 14
    titleLbl.Font                   = Enum.Font.GothamBold
    titleLbl.TextColor3             = self.Theme.TextBright
    titleLbl.TextXAlignment         = Enum.TextXAlignment.Left
    titleLbl.LayoutOrder            = 1
    titleLbl.Parent                 = inner

    local bodyLbl = Instance.new("TextLabel")
    bodyLbl.Size                   = UDim2.new(1, 0, 0, 14)
    bodyLbl.BackgroundTransparency = 1
    bodyLbl.Text                   = body or ""
    bodyLbl.TextSize               = 11
    bodyLbl.Font                   = Enum.Font.Gotham
    bodyLbl.TextColor3             = self.Theme.SubText
    bodyLbl.TextXAlignment         = Enum.TextXAlignment.Left
    bodyLbl.TextWrapped            = true
    bodyLbl.LayoutOrder            = 2
    bodyLbl.Parent                 = inner

    local progBG = Instance.new("Frame")
    progBG.Size             = UDim2.new(1, 0, 0, 2)
    progBG.AnchorPoint      = Vector2.new(0, 1)
    progBG.Position         = UDim2.new(0, 0, 1, 0)
    progBG.BackgroundColor3 = self.Theme.Border
    progBG.BorderSizePixel  = 0
    progBG.Parent           = notif

    local prog = Instance.new("Frame")
    prog.Size             = UDim2.new(1, 0, 1, 0)
    prog.BackgroundColor3 = accentColor
    prog.BorderSizePixel  = 0
    prog.Parent           = progBG

    tween(prog, { Size = UDim2.new(0, 0, 1, 0) }, duration, Enum.EasingStyle.Linear)

    task.delay(duration, function()
        tween(notif,    { BackgroundTransparency = 1 }, 0.25)
        tween(titleLbl, { TextTransparency       = 1 }, 0.25)
        tween(bodyLbl,  { TextTransparency       = 1 }, 0.25)
        task.wait(0.3)
        notif:Destroy()
    end)
end

-- ================================================================
-- INIT
-- ================================================================
function Fihware:_init()
    if self.Initialized then return end
    self.Initialized = true

    pcall(function()
        if not _isfolder("fihware") then _makefolder("fihware") end
    end)

    local sg = Instance.new("ScreenGui")
    sg.Name           = "FihwareGui"
    sg.ResetOnSpawn   = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder   = 999
    local ok = pcall(function() sg.Parent = game:GetService("CoreGui") end)
    if not ok then sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    self.MainGui = sg

    local root = Instance.new("Frame")
    root.Name                   = "ScaleRoot"
    root.Size                   = UDim2.new(1, 0, 1, 0)
    root.BackgroundTransparency = 1
    root.Parent                 = sg
    self.ScaleRoot = root

    local uiScale = Instance.new("UIScale")
    uiScale.Scale  = math.clamp(Camera.ViewportSize.X / 1920, 0.55, 1)
    uiScale.Parent = root
    self.MainScale = uiScale

    local scaleCon = Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        uiScale.Scale = math.clamp(Camera.ViewportSize.X / 1920, 0.55, 1)
    end)
    table.insert(self.Connections, scaleCon)

    local blur = Instance.new("BlurEffect")
    blur.Size   = 0
    blur.Parent = Lighting
    self.MainBlur = blur

    local nh = Instance.new("Frame")
    nh.Name                   = "NotifHolder"
    nh.Size                   = UDim2.new(0, 270, 0, 500)
    nh.AnchorPoint            = Vector2.new(1, 1)
    nh.Position               = UDim2.new(1, -12, 1, -12)
    nh.BackgroundTransparency = 1
    nh.Parent                 = root
    local nhList = listLayout(nh, 6)
    nhList.VerticalAlignment = Enum.VerticalAlignment.Bottom
    self.NotifHolder = nh

    task.spawn(function()
        while task.wait(10) do
            if self.Initialized then self:SaveSettings() end
        end
    end)

    task.spawn(function()
        while task.wait() do
            if self.RainbowEnabled and self.Initialized then
                self.RainbowHue = (self.RainbowHue + self.RainbowSpeed * 0.003) % 1
                self:SetAccent(self.RainbowHue, self.AccentS, self.AccentV)
            end
        end
    end)
end

-- ================================================================
-- DESTROY
-- ================================================================
function Fihware:Destroy()
    self:SaveSettings()
    for _, con in pairs(self.Connections) do
        pcall(function() con:Disconnect() end)
    end
    if self.MainGui then self.MainGui:Destroy() end
    if self.MainBlur then self.MainBlur:Destroy() end
    self.Windows      = {}
    self.SavedObjects = {}
    self.Connections  = {}
    self.Initialized  = false
end

-- ================================================================
-- VISIBILITY
-- ================================================================
function Fihware:SetVisible(val)
    self.GuiVisible = val
    if self.ScaleRoot then self.ScaleRoot.Visible = val end
    if self.MainBlur then
        tween(self.MainBlur, { Size = val and 8 or 0 }, 0.25)
    end
end

function Fihware:Toggle()
    self:SetVisible(not self.GuiVisible)
end

-- ================================================================
-- SIDE-BY-SIDE WINDOW POSITIONING
-- ================================================================
function Fihware:_getNextWindowPosition(skipWin)
    local mainNavRight = self.MainNavRef
        and (self.MainNavRef.Position.X.Offset + self.MainNavRef.Size.X.Offset)
        or 6
    local mainNavY = self.MainNavRef and self.MainNavRef.Position.Y.Offset or 6

    local maxRight = mainNavRight
    for _, w in ipairs(self.Windows) do
        if w ~= skipWin and w.Frame.Visible then
            local right = w.Frame.Position.X.Offset + w.Frame.Size.X.Offset
            if right > maxRight then maxRight = right end
        end
    end

    return UDim2.new(0, maxRight + self.WindowGap, 0, mainNavY)
end

