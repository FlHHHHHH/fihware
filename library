function W.section(lib, parent, order, name)
    local sect = Instance.new("Frame")
    sect.Size                   = UDim2.new(1, 0, 0, 28)
    sect.BackgroundTransparency = 1
    sect.LayoutOrder            = order
    sect.Parent                 = parent

    if name and name ~= "" then
        local tw2 = TextService:GetTextSize(
            name:upper(), 10, Enum.Font.GothamBold, Vector2.new(9999, 9999)).X

        local lbl = Instance.new("TextLabel")
        lbl.Size                   = UDim2.new(0, tw2, 1, 0)
        lbl.Position               = UDim2.new(0, 6, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text                   = name:upper()
        lbl.TextSize               = 10
        lbl.Font                   = Enum.Font.GothamBold
        lbl.TextColor3             = lib.Theme.Muted
        lbl.TextXAlignment         = Enum.TextXAlignment.Left
        lbl.Parent                 = sect

        local line = Instance.new("Frame")
        line.Size             = UDim2.new(1, -(tw2 + 6 + 8 + 6), 0, 1)
        line.AnchorPoint      = Vector2.new(0, 0.5)
        line.Position         = UDim2.new(0, tw2 + 6 + 8, 0.5, 0)
        line.BackgroundColor3 = lib.Theme.Border
        line.BorderSizePixel  = 0
        line.Parent           = sect
    else
        local line = Instance.new("Frame")
        line.Size             = UDim2.new(1, -12, 0, 1)
        line.AnchorPoint      = Vector2.new(0, 0.5)
        line.Position         = UDim2.new(0, 6, 0.5, 0)
        line.BackgroundColor3 = lib.Theme.Border
        line.BorderSizePixel  = 0
        line.Parent           = sect
    end
    return sect
end

function W.label(lib, parent, order, cfg)
    cfg = cfg or {}
    local lbl = Instance.new("TextLabel")
    lbl.Size                   = UDim2.new(1, 0, 0, 18)
    lbl.AutomaticSize          = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.Text                   = cfg.Text or ""
    lbl.TextSize               = 12
    lbl.Font                   = Enum.Font.Gotham
    lbl.TextColor3             = cfg.Color or lib.Theme.SubText
    lbl.TextXAlignment         = Enum.TextXAlignment.Left
    lbl.TextWrapped            = true
    lbl.LayoutOrder            = order
    lbl.Parent                 = parent
    pad(lbl, 0, 4, 0, 6)

    local api = {}
    function api:SetText(t)  lbl.Text       = t end
    function api:SetColor(c) lbl.TextColor3 = c end
    return api
end

function W.toggle(lib, parent, order, accentList, cfg)
    cfg = cfg or {}
    local enabled = cfg.Default or false
    local eName   = cfg.Name    or "Toggle"

    local row = Instance.new("Frame")
    row.Size                   = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3       = lib.Theme.Elevated
    row.BackgroundTransparency = 0.4
    row.BorderSizePixel        = 0
    row.LayoutOrder            = order
    row.Parent                 = parent
    corner(row, 6)

    local btn = Instance.new("TextButton")
    btn.Size                   = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text                   = ""
    btn.AutoButtonColor        = false
    btn.Parent                 = row

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size                   = UDim2.new(1, -44, 1, 0)
    nameLbl.Position               = UDim2.new(0, 12, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = eName
    nameLbl.TextSize               = 13
    nameLbl.Font                   = Enum.Font.GothamMedium
    nameLbl.TextColor3             = lib.Theme.Text
    nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
    nameLbl.Parent                 = row

    -- Pill indicator
    local pill = Instance.new("Frame")
    pill.Size             = UDim2.new(0, 32, 0, 18)
    pill.AnchorPoint      = Vector2.new(1, 0.5)
    pill.Position         = UDim2.new(1, -10, 0.5, 0)
    pill.BackgroundColor3 = lib.Theme.Background
    pill.BorderSizePixel  = 0
    pill.Parent           = row
    corner(pill, 99)
    local pillStroke = stroke(pill, lib.Theme.Border)

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 12, 0, 12)
    knob.AnchorPoint      = Vector2.new(0.5, 0.5)
    knob.Position         = UDim2.new(0, 9, 0.5, 0)
    knob.BackgroundColor3 = lib.Theme.Muted
    knob.BorderSizePixel  = 0
    knob.ZIndex           = 2
    knob.Parent           = pill
    corner(knob, 99)

    local api = { Enabled = enabled }

    local function setEnabled(val, silent)
        enabled     = val
        api.Enabled = val
        local knobX = val and 23 or 9
        tw(knob, {
            Position         = UDim2.new(0, knobX, 0.5, 0),
            BackgroundColor3 = val and lib.Theme.Accent or lib.Theme.Muted,
        }, 0.18)
        tw(pill, {
            BackgroundColor3 = val and lib.Theme.AccentDark or lib.Theme.Background,
        }, 0.18)
        pillStroke.Color = val and lib.Theme.Accent or lib.Theme.Border
        tw(nameLbl, { TextColor3 = val and lib.Theme.TextBright or lib.Theme.Text }, 0.18)

        if not silent then
            if cfg.Function then pcall(cfg.Function, val) end
            if lib.ToggleAlertsEnabled then
                lib:Notify(eName, "Module " .. (val and "enabled" or "disabled"), 2,
                    val and lib.Theme.Success or lib.Theme.Muted)
            end
        end
        if lib.SavedObjects[eName] then
            lib.SavedObjects[eName].SaveValue = val
        end
    end

    btn.MouseEnter:Connect(function()
        tw(row, { BackgroundTransparency = 0.1, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
    end)
    btn.MouseLeave:Connect(function()
        tw(row, { BackgroundTransparency = 0.4, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
    end)
    btn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)

    api.Set    = function(val, silent) setEnabled(val, silent) end
    api.Toggle = function() setEnabled(not enabled) end

    lib.SavedObjects[eName] = {
        SaveValue = enabled,
        Load      = function(v) setEnabled(v, true) end,
    }

    if cfg.Default ~= nil then setEnabled(cfg.Default, true) end
    return api
end

function W.slider(lib, parent, order, accentList, cfg)
    cfg = cfg or {}
    local min      = cfg.Min      or 0
    local max      = cfg.Max      or 100
    local decimals = cfg.Decimals or 0
    local suffix   = cfg.Suffix   or ""
    local eName    = cfg.Name     or "Slider"
    local value    = math.clamp(cfg.Default or min, min, max)

    local row = Instance.new("Frame")
    row.Size                   = UDim2.new(1, 0, 0, 54)
    row.BackgroundColor3       = lib.Theme.Elevated
    row.BackgroundTransparency = 0.4
    row.BorderSizePixel        = 0
    row.LayoutOrder            = order
    row.Parent                 = parent
    corner(row, 6)

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size                   = UDim2.new(0.6, 0, 0, 20)
    nameLbl.Position               = UDim2.new(0, 12, 0, 8)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = eName
    nameLbl.TextSize               = 13
    nameLbl.Font                   = Enum.Font.GothamMedium
    nameLbl.TextColor3             = lib.Theme.Text
    nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
    nameLbl.Parent                 = row

    local function fmt(v)
        if decimals > 0 then
            return string.format("%." .. decimals .. "f", v) .. suffix
        end
        return math.floor(v + 0.5) .. suffix
    end

    local valLbl = Instance.new("TextLabel")
    valLbl.Size                   = UDim2.new(0.4, -14, 0, 20)
    valLbl.AnchorPoint            = Vector2.new(1, 0)
    valLbl.Position               = UDim2.new(1, -12, 0, 8)
    valLbl.BackgroundTransparency = 1
    valLbl.Text                   = fmt(value)
    valLbl.TextSize               = 12
    valLbl.Font                   = Enum.Font.GothamMedium
    valLbl.TextColor3             = lib.Theme.Accent
    valLbl.TextXAlignment         = Enum.TextXAlignment.Right
    valLbl.Parent                 = row
    table.insert(accentList, { obj = valLbl, prop = "TextColor3" })

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, -24, 0, 4)
    track.Position         = UDim2.new(0, 12, 0, 38)
    track.BackgroundColor3 = lib.Theme.Border
    track.BorderSizePixel  = 0
    track.Parent           = row
    corner(track, 99)

    local pct0 = (max ~= min) and ((value - min) / (max - min)) or 0

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new(pct0, 0, 1, 0)
    fill.BackgroundColor3 = lib.Theme.Accent
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    corner(fill, 99)
    table.insert(accentList, { obj = fill, prop = "BackgroundColor3" })

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 12, 0, 12)
    knob.AnchorPoint      = Vector2.new(0.5, 0.5)
    knob.Position         = UDim2.new(pct0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel  = 0
    knob.ZIndex           = 2
    knob.Parent           = track
    corner(knob, 99)

    -- Full-row invisible hitbox so dragging anywhere on the row works
    local hitbox = Instance.new("TextButton")
    hitbox.Size                   = UDim2.new(1, 0, 1, 0)
    hitbox.BackgroundTransparency = 1
    hitbox.Text                   = ""
    hitbox.ZIndex                 = 4
    hitbox.Parent                 = row

    local dragging = false
    local api      = { Value = value }

    local function update(x)
        local abs = track.AbsoluteSize.X
        if abs == 0 then return end
        local pct = math.clamp((x - track.AbsolutePosition.X) / abs, 0, 1)
        if decimals > 0 then
            local mult = 10 ^ decimals
            value = math.floor((min + (max - min) * pct) * mult + 0.5) / mult
        else
            value = math.floor(min + (max - min) * pct + 0.5)
        end
        api.Value     = value
        fill.Size     = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        valLbl.Text   = fmt(value)
        if cfg.Function then pcall(cfg.Function, value) end
        if lib.SavedObjects[eName] then lib.SavedObjects[eName].SaveValue = value end
    end

    hitbox.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(i.Position.X)
            tw(knob, { Size = UDim2.new(0, 16, 0, 16) }, 0.1)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (
            i.UserInputType == Enum.UserInputType.MouseMovement
         or i.UserInputType == Enum.UserInputType.Touch
        ) then
            update(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            if dragging then tw(knob, { Size = UDim2.new(0, 12, 0, 12) }, 0.1) end
            dragging = false
        end
    end)
    hitbox.MouseEnter:Connect(function()
        tw(row, { BackgroundTransparency = 0.1, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
    end)
    hitbox.MouseLeave:Connect(function()
        if not dragging then
            tw(row, { BackgroundTransparency = 0.4, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
        end
    end)

    lib.SavedObjects[eName] = {
        SaveValue = value,
        Load = function(v)
            v = math.clamp(v, min, max)
            value = v; api.Value = v
            local p = (max ~= min) and ((v - min) / (max - min)) or 0
            fill.Size     = UDim2.new(p, 0, 1, 0)
            knob.Position = UDim2.new(p, 0, 0.5, 0)
            valLbl.Text   = fmt(v)
            if cfg.Function then pcall(cfg.Function, v) end
        end,
    }
    return api
end

function W.dropdown(lib, parent, order, accentList, cfg)
    cfg = cfg or {}
    local eName    = cfg.Name    or "Dropdown"
    local list     = cfg.List    or {}
    local selected = cfg.Default or (list[1] or "")
    local open     = false

    -- Validate default
    local valid = false
    for _, v in ipairs(list) do if v == selected then valid = true; break end end
    if not valid then selected = list[1] or "" end

    -- Outer container — grows to fit when open
    local container = Instance.new("Frame")
    container.Size                   = UDim2.new(1, 0, 0, 36)
    container.BackgroundTransparency = 1
    container.ClipsDescendants       = false
    container.LayoutOrder            = order
    container.Parent                 = parent

    local row = Instance.new("Frame")
    row.Size                   = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3       = lib.Theme.Elevated
    row.BackgroundTransparency = 0.4
    row.BorderSizePixel        = 0
    row.ZIndex                 = 3
    row.Parent                 = container
    corner(row, 6)

    local btn = Instance.new("TextButton")
    btn.Size                   = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text                   = ""
    btn.AutoButtonColor        = false
    btn.ZIndex                 = 4
    btn.Parent                 = row

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size                   = UDim2.new(0.5, 0, 1, 0)
    nameLbl.Position               = UDim2.new(0, 12, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = eName
    nameLbl.TextSize               = 13
    nameLbl.Font                   = Enum.Font.GothamMedium
    nameLbl.TextColor3             = lib.Theme.Text
    nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
    nameLbl.ZIndex                 = 4
    nameLbl.Parent                 = row

    local selLbl = Instance.new("TextLabel")
    selLbl.Size                   = UDim2.new(0.5, -28, 1, 0)
    selLbl.AnchorPoint            = Vector2.new(1, 0)
    selLbl.Position               = UDim2.new(1, -22, 0, 0)
    selLbl.BackgroundTransparency = 1
    selLbl.Text                   = selected
    selLbl.TextSize               = 12
    selLbl.Font                   = Enum.Font.Gotham
    selLbl.TextColor3             = lib.Theme.Accent
    selLbl.TextXAlignment         = Enum.TextXAlignment.Right
    selLbl.TextTruncate           = Enum.TextTruncate.AtEnd
    selLbl.ZIndex                 = 4
    selLbl.Parent                 = row
    table.insert(accentList, { obj = selLbl, prop = "TextColor3" })

    local arrowLbl = Instance.new("TextLabel")
    arrowLbl.Size                   = UDim2.new(0, 14, 1, 0)
    arrowLbl.AnchorPoint            = Vector2.new(1, 0)
    arrowLbl.Position               = UDim2.new(1, -8, 0, 0)
    arrowLbl.BackgroundTransparency = 1
    arrowLbl.Text                   = "▾"
    arrowLbl.TextSize               = 13
    arrowLbl.Font                   = Enum.Font.Gotham
    arrowLbl.TextColor3             = lib.Theme.SubText
    arrowLbl.ZIndex                 = 4
    arrowLbl.Parent                 = row

    local ITEM_H = 30
    local GAP    = 2
    local VPAD   = 6

    -- Dropdown panel
    local panel = Instance.new("Frame")
    panel.Size             = UDim2.new(1, 0, 0, 0)
    panel.Position         = UDim2.new(0, 0, 1, 4)
    panel.BackgroundColor3 = lib.Theme.Surface
    panel.BorderSizePixel  = 0
    panel.ClipsDescendants = true
    panel.ZIndex           = 10
    panel.Visible          = false
    panel.Parent           = container
    corner(panel, 6)
    stroke(panel, lib.Theme.Border)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size                   = UDim2.new(1, 0, 1, 0)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel        = 0
    scroll.ScrollBarThickness     = 2
    scroll.ScrollBarImageColor3   = lib.Theme.Accent
    scroll.ZIndex                 = 11
    scroll.Parent                 = panel
    pad(scroll, VPAD, VPAD, VPAD, VPAD)
    listLayout(scroll, GAP)

    local api = { Value = selected, List = list }

    local function close()
        if not open then return end
        open = false
        tw(panel,    { Size = UDim2.new(1, 0, 0, 0) }, 0.15)
        tw(arrowLbl, { Rotation = 0 },                 0.15)
        task.delay(0.16, function()
            if not open then
                panel.Visible    = false
                container.Size   = UDim2.new(1, 0, 0, 36)
            end
        end)
    end

    local function populate()
        for _, c in pairs(scroll:GetChildren()) do
            if not c:IsA("UIListLayout") and not c:IsA("UIPadding") then c:Destroy() end
        end
        for idx, item in ipairs(list) do
            local isSelected = (item == selected)

            local opt = Instance.new("TextButton")
            opt.Size                   = UDim2.new(1, 0, 0, ITEM_H)
            opt.BackgroundColor3       = isSelected and lib.Theme.ElevatedHvr or lib.Theme.Elevated
            opt.BackgroundTransparency = isSelected and 0 or 1
            opt.BorderSizePixel        = 0
            opt.Text                   = item
            opt.TextSize               = 12
            opt.Font                   = Enum.Font.GothamMedium
            opt.TextColor3             = isSelected and lib.Theme.Accent or lib.Theme.Text
            opt.TextXAlignment         = Enum.TextXAlignment.Left
            opt.AutoButtonColor        = false
            opt.LayoutOrder            = idx
            opt.ZIndex                 = 12
            opt.Parent                 = scroll
            corner(opt, 5)
            pad(opt, 0, 0, 0, 10)

            opt.MouseEnter:Connect(function()
                if item ~= selected then
                    tw(opt, { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.08)
                end
            end)
            opt.MouseLeave:Connect(function()
                if item ~= selected then tw(opt, { BackgroundTransparency = 1 }, 0.08) end
            end)
            opt.MouseButton1Click:Connect(function()
                selected    = item
                api.Value   = item
                selLbl.Text = item
                if cfg.Function then pcall(cfg.Function, item) end
                if lib.SavedObjects[eName] then lib.SavedObjects[eName].SaveValue = item end
                close()
            end)
        end
        local totalContent = #list * ITEM_H + math.max(0, #list - 1) * GAP + VPAD * 2
        scroll.CanvasSize  = UDim2.new(0, 0, 0, totalContent)
        return math.clamp(totalContent, 36, 180)
    end

    btn.MouseEnter:Connect(function()
        tw(row, { BackgroundTransparency = 0.1, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
    end)
    btn.MouseLeave:Connect(function()
        tw(row, { BackgroundTransparency = 0.4, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
    end)
    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            local h      = populate()
            panel.Visible = true
            panel.Size    = UDim2.new(1, 0, 0, 0)
            tw(panel,     { Size = UDim2.new(1, 0, 0, h) }, 0.17)
            tw(arrowLbl,  { Rotation = 180 },               0.17)
            container.Size = UDim2.new(1, 0, 0, 36 + h + 4)
        else
            close()
        end
    end)

    api.SetList = function(newList)
        list = newList; api.List = newList
        local stillValid = false
        for _, v in ipairs(newList) do if v == selected then stillValid = true; break end end
        if not stillValid then
            selected = newList[1] or ""
            api.Value   = selected
            selLbl.Text = selected
        end
        if open then close() end
    end
    api.Close = close

    lib.SavedObjects[eName] = {
        SaveValue = selected,
        Load = function(v)
            for _, item in ipairs(list) do
                if item == v then
                    selected = v; api.Value = v; selLbl.Text = v
                    if cfg.Function then pcall(cfg.Function, v) end
                    return
                end
            end
        end,
    }
    return api
end

