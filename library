-- ── iOS Toggle ───────────────────────────────────────────────────
function W.toggle(lib, parent, layoutOrder, accentObjs, cfg)
    cfg = cfg or {}
    local enabled = cfg.Default or false
    local eName   = cfg.Name    or "Toggle"

    -- outer row
    local row = Instance.new("Frame")
    row.Size                   = UDim2.new(1, 0, 0, 36)
    row.BackgroundColor3       = lib.Theme.Elevated
    row.BackgroundTransparency = 0.25
    row.BorderSizePixel        = 0
    row.LayoutOrder            = layoutOrder
    row.Parent                 = parent
    corner(row, 7)

    local btn = Instance.new("TextButton")
    btn.Size                   = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text                   = ""
    btn.AutoButtonColor        = false
    btn.Parent                 = row

    -- left accent pip
    local pip = Instance.new("Frame")
    pip.Size                   = UDim2.new(0, 3, 0, 20)
    pip.AnchorPoint            = Vector2.new(0, 0.5)
    pip.Position               = UDim2.new(0, 0, 0.5, 0)
    pip.BackgroundColor3       = lib.Theme.Accent
    pip.BackgroundTransparency = 1
    pip.BorderSizePixel        = 0
    pip.Parent                 = row
    corner(pip, 2)
    table.insert(accentObjs, { obj = pip, type = "BackgroundColor3" })

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size                   = UDim2.new(1, -72, 1, 0)
    nameLbl.Position               = UDim2.new(0, 16, 0, 0)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = eName
    nameLbl.TextSize               = 13
    nameLbl.Font                   = Enum.Font.GothamMedium
    nameLbl.TextColor3             = lib.Theme.Text
    nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
    nameLbl.Parent                 = row

    -- iOS pill toggle
    local pillBG = Instance.new("Frame")
    pillBG.Size             = UDim2.new(0, 40, 0, 22)
    pillBG.AnchorPoint      = Vector2.new(1, 0.5)
    pillBG.Position         = UDim2.new(1, -12, 0.5, 0)
    pillBG.BackgroundColor3 = enabled and lib.Theme.Accent or lib.Theme.Border
    pillBG.BorderSizePixel  = 0
    pillBG.Parent           = row
    corner(pillBG, 99)
    table.insert(accentObjs, { obj = pillBG, type = "BackgroundColor3_Toggle" })

    local pillCircle = Instance.new("Frame")
    pillCircle.Size             = UDim2.new(0, 16, 0, 16)
    pillCircle.AnchorPoint      = Vector2.new(0, 0.5)
    pillCircle.Position         = enabled and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
    pillCircle.BackgroundColor3 = Color3.new(1, 1, 1)
    pillCircle.BorderSizePixel  = 0
    pillCircle.Parent           = pillBG
    corner(pillCircle, 99)

    mkTooltip(lib, btn, row, cfg.HoverText)

    local api = { Enabled = enabled }

    local function setEnabled(val, silent)
        enabled     = val
        api.Enabled = val

        -- pill animation
        tween(pillBG,     { BackgroundColor3 = val and lib.Theme.Accent or lib.Theme.Border }, 0.2)
        tween(pillCircle, { Position = val and UDim2.new(1, -19, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) },
              0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        -- accent pip
        tween(pip,     { BackgroundTransparency = val and 0 or 1 }, 0.18)
        tween(nameLbl, { TextColor3 = val and lib.Theme.TextBright or lib.Theme.Text }, 0.18)

        if not silent then
            if cfg.Function then pcall(cfg.Function, val) end
            if lib.ToggleAlertsEnabled then
                lib:Notify(eName, "Module " .. (val and "enabled" or "disabled"), 2,
                    val and lib.Theme.Success or lib.Theme.Muted)
            end
        end
        if lib.SavedObjects[eName] then
            lib.SavedObjects[eName].SaveValue = val
        end
    end

    btn.MouseEnter:Connect(function()
        tween(row, { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
    end)
    btn.MouseLeave:Connect(function()
        tween(row, { BackgroundTransparency = 0.25, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
    end)
    btn.MouseButton1Click:Connect(function() setEnabled(not enabled) end)

    api.Set    = function(val, silent) setEnabled(val, silent) end
    api.Toggle = function() setEnabled(not enabled) end

    lib.SavedObjects[eName] = {
        SaveValue    = enabled,
        Load         = function(v) setEnabled(v, true) end,
        UpdateAccent = function(c)
            if enabled then
                pillBG.BackgroundColor3 = c
                pip.BackgroundColor3    = c
            end
        end,
    }
    if cfg.Default ~= nil then setEnabled(cfg.Default, true) end
    return api
end

-- ── Slider ───────────────────────────────────────────────────────
function W.slider(lib, parent, layoutOrder, accentObjs, cfg)
    cfg = cfg or {}
    local min      = cfg.Min      or 0
    local max      = cfg.Max      or 100
    local value    = cfg.Default  or min
    local suffix   = cfg.Suffix   or ""
    local eName    = cfg.Name     or "Slider"
    local decimals = cfg.Decimals or 0

    local row = Instance.new("Frame")
    row.Size                   = UDim2.new(1, 0, 0, 54)
    row.BackgroundColor3       = lib.Theme.Elevated
    row.BackgroundTransparency = 0.25
    row.BorderSizePixel        = 0
    row.LayoutOrder            = layoutOrder
    row.Parent                 = parent
    corner(row, 7)

    local nameLbl = Instance.new("TextLabel")
    nameLbl.Size                   = UDim2.new(0.6, 0, 0, 20)
    nameLbl.Position               = UDim2.new(0, 16, 0, 8)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = eName
    nameLbl.TextSize               = 13
    nameLbl.Font                   = Enum.Font.GothamMedium
    nameLbl.TextColor3             = lib.Theme.Text
    nameLbl.TextXAlignment         = Enum.TextXAlignment.Left
    nameLbl.Parent                 = row

    local function fmtVal(v)
        if decimals > 0 then
            return string.format("%." .. decimals .. "f", v) .. suffix
        end
        return tostring(math.floor(v)) .. suffix
    end

    local valLbl = Instance.new("TextLabel")
    valLbl.Size                   = UDim2.new(0.4, -16, 0, 20)
    valLbl.AnchorPoint            = Vector2.new(1, 0)
    valLbl.Position               = UDim2.new(1, -16, 0, 8)
    valLbl.BackgroundTransparency = 1
    valLbl.Text                   = fmtVal(value)
    valLbl.TextSize               = 12
    valLbl.Font                   = Enum.Font.GothamBold
    valLbl.TextColor3             = lib.Theme.Accent
    valLbl.TextXAlignment         = Enum.TextXAlignment.Right
    valLbl.Parent                 = row
    table.insert(accentObjs, { obj = valLbl, type = "TextColor3" })

    local track = Instance.new("Frame")
    track.Size             = UDim2.new(1, -32, 0, 5)
    track.Position         = UDim2.new(0, 16, 0, 37)
    track.BackgroundColor3 = lib.Theme.Border
    track.BorderSizePixel  = 0
    track.Parent           = row
    corner(track, 99)

    local pct0 = (value - min) / (max - min)
    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new(pct0, 0, 1, 0)
    fill.BackgroundColor3 = lib.Theme.Accent
    fill.BorderSizePixel  = 0
    fill.Parent           = track
    corner(fill, 99)
    table.insert(accentObjs, { obj = fill, type = "BackgroundColor3" })

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint      = Vector2.new(0.5, 0.5)
    knob.Position         = UDim2.new(pct0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel  = 0
    knob.ZIndex           = 3
    knob.Parent           = track
    corner(knob, 99)
    local knobStroke = stroke(knob, lib.Theme.Accent, 2)
    table.insert(accentObjs, { obj = knobStroke, type = "Color" })

    local hitbox = Instance.new("TextButton")
    hitbox.Size                   = UDim2.new(1, 0, 1, 0)
    hitbox.BackgroundTransparency = 1
    hitbox.Text                   = ""
    hitbox.ZIndex                 = 5
    hitbox.Parent                 = row

    local dragging = false
    local api      = { Value = value }

    local function updateSlider(x)
        local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        if decimals > 0 then
            local mult = 10 ^ decimals
            value = math.floor((min + (max - min) * pct) * mult + 0.5) / mult
        else
            value = math.floor(min + (max - min) * pct + 0.5)
        end
        api.Value     = value
        fill.Size     = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        valLbl.Text   = fmtVal(value)
        if cfg.Function then pcall(cfg.Function, value) end
        if lib.SavedObjects[eName] then lib.SavedObjects[eName].SaveValue = value end
    end

    hitbox.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateSlider(i.Position.X)
            tween(knob, { Size = UDim2.new(0, 18, 0, 18) }, 0.1)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
                      or i.UserInputType == Enum.UserInputType.Touch) then
            updateSlider(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            if dragging then tween(knob, { Size = UDim2.new(0, 14, 0, 14) }, 0.1) end
            dragging = false
        end
    end)

    hitbox.MouseEnter:Connect(function()
        tween(row, { BackgroundTransparency = 0, BackgroundColor3 = lib.Theme.ElevatedHvr }, 0.1)
    end)
    hitbox.MouseLeave:Connect(function()
        if not dragging then
            tween(row, { BackgroundTransparency = 0.25, BackgroundColor3 = lib.Theme.Elevated }, 0.1)
        end
    end)

    lib.SavedObjects[eName] = {
        SaveValue = value,
        Load = function(v)
            value = v; api.Value = v
            local pct = math.clamp((v - min) / (max - min), 0, 1)
            fill.Size     = UDim2.new(pct, 0, 1, 0)
            knob.Position = UDim2.new(pct, 0, 0.5, 0)
            valLbl.Text   = fmtVal(v)
            if cfg.Function then pcall(cfg.Function, v) end
        end,
        UpdateAccent = function(c)
            fill.BackgroundColor3 = c
            valLbl.TextColor3     = c
            knobStroke.Color      = c
        end,
    }
    return api
end

