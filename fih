    surface    = Color3.fromRGB(16,  19,  28),
    elevated   = Color3.fromRGB(22,  26,  38),
    border     = Color3.fromRGB(38,  45,  65),
    accent     = Color3.fromRGB(0,   210, 180),
    accentDim  = Color3.fromRGB(0,   120, 105),
    accentGlow = Color3.fromRGB(0,   255, 220),
