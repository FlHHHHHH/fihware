local currentWaypoints = {}
local waypointFolder   = nil

local function getWaypointFolder()
    if waypointFolder and waypointFolder.Parent then return waypointFolder end
    local f  = Instance.new("Folder")
    f.Name   = "EggMacroWaypoints"
    f.Parent = Workspace
    waypointFolder = f
    return f
end

local function lerpColor(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

local function waypointColor(index, total, isJump)
    if isJump then return Color3.fromRGB(0, 220, 255) end
    local t      = total <= 1 and 1 or (index - 1) / (total - 1)
    local red    = Color3.fromRGB(255, 60,  60)
    local orange = Color3.fromRGB(255, 165,  0)
    local green  = Color3.fromRGB(60,  255, 100)
    if t < 0.5 then
        return lerpColor(red, orange, t * 2)
    else
        return lerpColor(orange, green, (t - 0.5) * 2)
    end
end

local function createWaypointVisual(position, index, total, isJump)
    local folder    = getWaypointFolder()
    local col       = waypointColor(index, total, isJump)
    local isCurrent = (index == 2)

    local markerY
    if isJump then
        local rayOrigin    = position + Vector3.new(0, 4, 0)
        local rayDirection = Vector3.new(0, -12, 0)
        local rayParams    = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = { character, folder }
        local result = Workspace:Raycast(rayOrigin, rayDirection, rayParams)
        markerY = result and (result.Position.Y + 0.1) or (position.Y + 0.1)
    else
        markerY = position.Y + 3.5
    end

    local markerPos = Vector3.new(position.X, markerY, position.Z)

    local part = Instance.new("Part")
    part.Name         = "WP_" .. index
    part.Size         = isCurrent and Vector3.new(1.8, 1.8, 1.8) or Vector3.new(1.1, 1.1, 1.1)
    part.Shape        = Enum.PartType.Ball
    part.Material     = Enum.Material.Neon
    part.Color        = col
    part.Transparency = isCurrent and 0.05 or 0.25
    part.Anchored     = true
    part.CanCollide   = false
    part.CanQuery     = false
    part.CanTouch     = false
    part.CastShadow   = false
    part.Position     = markerPos
    part.Parent       = folder

    local light = Instance.new("PointLight")
    light.Color      = col
    light.Brightness = isJump and 4 or (isCurrent and 3 or 1.2)
    light.Range      = isJump and 18 or (isCurrent and 14 or 7)
    light.Parent     = part

    local bg = Instance.new("BillboardGui")
    bg.Size        = UDim2.new(0, 44, 0, 44)
    bg.StudsOffset = Vector3.new(0, 2.4, 0)
    bg.AlwaysOnTop = true
    bg.Parent      = part

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text                   = isJump and ("↑" .. index) or tostring(index)
    label.TextColor3             = Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3       = col
    label.Font                   = Enum.Font.GothamBold
    label.TextSize               = isCurrent and 22 or 16
    label.Parent                 = bg

    table.insert(currentWaypoints, { part = part, light = light })
    return part
end

local function createBeam(partA, partB, col)
    local folder = getWaypointFolder()
    local attA = Instance.new("Attachment") attA.Parent = partA
    local attB = Instance.new("Attachment") attB.Parent = partB

    local beam = Instance.new("Beam")
    beam.Attachment0   = attA
    beam.Attachment1   = attB
    beam.Width0        = 0.18
    beam.Width1        = 0.18
    beam.Transparency  = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.5, 0.3), NumberSequenceKeypoint.new(1, 0.1)})
    beam.Color         = ColorSequence.new(col)
    beam.LightEmission = 1
    beam.FaceCamera    = true
    beam.Segments      = 6
    beam.Parent        = folder

    if #currentWaypoints > 0 then
        local entry = currentWaypoints[#currentWaypoints]
        entry.beam = beam
        entry.attA = attA
        entry.attB = attB
    end
end

local function clearWaypoints()
    for _, entry in ipairs(currentWaypoints) do
        if entry.beam and entry.beam.Parent then entry.beam:Destroy() end
        if entry.attA and entry.attA.Parent then entry.attA:Destroy() end
        if entry.attB and entry.attB.Parent then entry.attB:Destroy() end
        if entry.light and entry.light.Parent then entry.light:Destroy() end
        if entry.part and entry.part.Parent then entry.part:Destroy() end
    end
    currentWaypoints = {}
    if waypointFolder and waypointFolder.Parent then
        waypointFolder:Destroy()
        waypointFolder = nil
    end
end

local function createWaypointVisuals(waypoints)
    clearWaypoints()
    local total = #waypoints
    local parts = {}
    for i = 2, total do
        local wp     = waypoints[i]
        local isJump = wp.Action == Enum.PathWaypointAction.Jump
        local part   = createWaypointVisual(wp.Position, i, total, isJump)
        parts[i]     = part
    end
    for i = 2, total - 1 do
        if parts[i] and parts[i + 1] then
            local col = waypointColor(i, total, waypoints[i].Action == Enum.PathWaypointAction.Jump)
            createBeam(parts[i], parts[i + 1], col)
        end
    end
end

local function highlightCurrentWaypoint(wpIndex)
    for i, entry in ipairs(currentWaypoints) do
        if not entry.part or not entry.part.Parent then continue end
        local isCurrent = (i == wpIndex - 1)
        entry.part.Size         = isCurrent and Vector3.new(1.8, 1.8, 1.8) or Vector3.new(1.1, 1.1, 1.1)
        entry.part.Transparency = isCurrent and 0.05 or 0.35
        if entry.light then
            entry.light.Brightness = isCurrent and 3 or 0.8
            entry.light.Range      = isCurrent and 14 or 5
        end
    end
end

