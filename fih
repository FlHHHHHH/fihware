local function getCurrencyText()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return 0 end
    local mi = pg:FindFirstChild("MainInterface")
    if not mi then return 0 end

    for _, f in ipairs(mi:GetChildren()) do
        if f:IsA("Frame") then
            local pos = f.AbsolutePosition
            local sz  = f.AbsoluteSize
            if math.abs(pos.X - 10) < 20 and math.abs(pos.Y - 805) < 25
               and math.abs(sz.X - 192) < 40 and math.abs(sz.Y - 30) < 15 then
                local tl = f:FindFirstChildWhichIsA("TextLabel")
                if tl and tl.Text then
                    local num = tl.Text:gsub("[^%d]", "")
                    return tonumber(num) or 0
                end
            end
        end
    end
    return 0
end

-- ============================================================
--  ELAPSED TIME
-- ============================================================
local function getElapsedTime()
    if macroStartTime <= 0 then return "0h 0m 0s" end
    local elapsed = tick() - macroStartTime
    local hours   = math.floor(elapsed / 3600)
    local minutes = math.floor((elapsed % 3600) / 60)
    local seconds = math.floor(elapsed % 60)
    if hours > 0 then
        return string.format("%dh %dm %ds", hours, minutes, seconds)
    else
        return string.format("%dm %ds", minutes, seconds)
    end
end

