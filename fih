                PlaceholderText  = opts3.PlaceholderText or "",
                PlaceholderColor3= C.textMuted,
                Text             = "",
                Font             = Enum.Font.Gotham,
                TextSize         = 11,
                TextColor3       = C.text,
                TextXAlignment   = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                Parent           = inputBg,
            })

            box.Focused:Connect(function()
                tween(inputStroke, { Color = C.accent })
            end)
            box.FocusLost:Connect(function(enter)
                tween(inputStroke, { Color = C.border })
                if opts3.Callback then pcall(opts3.Callback, box.Text) end
                if opts3.RemoveTextAfterFocusLost then box.Text = "" end
            end)
        end

        return tabObj
    end

    return windowObj
end

-- ── Bootstrap ────────────────────────────────────────────────
return fihware
