                Size             = UDim2.new(1, 0, 0, 28),
                BackgroundTransparency = 1,
                LayoutOrder      = nextOrder(),
                Parent           = page,
            })
            new("TextLabel", {
                Size             = UDim2.new(1, 0, 1, 0),
                Text             = name2:upper(),
                Font             = Enum.Font.GothamBold,
                TextSize         = 9,
                TextColor3       = C.accent,
                TextXAlignment   = Enum.TextXAlignment.Left,
                LetterSpacing    = 2,
                BackgroundTransparency = 1,
                Parent           = row,
            })
            local line = new("Frame", {
                Size             = UDim2.new(1, 0, 0, 1),
                Position         = UDim2.new(0, 0, 1, -1),
                BackgroundColor3 = C.border,
                BorderSizePixel  = 0,
                Parent           = row,
            })
        end

        -- TOGGLE ───────────────────────────────────────────
        function tabObj:CreateToggle(opts3)
            local val = opts3.CurrentValue or false

            local row = new("Frame", {
                Size             = UDim2.new(1, 0, 0, 42),
                BackgroundColor3 = C.elevated,
                BorderSizePixel  = 0,
                LayoutOrder      = nextOrder(),
                Parent           = page,
            })
            corner(row, 8)
            stroke(row, C.border)

            -- hover
            local hBtn = new("TextButton", {
                Size             = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text             = "",
                Parent           = row,
            })

            new("TextLabel", {
                Size             = UDim2.new(1, -70, 1, 0),
                Position         = UDim2.new(0, 14, 0, 0),
                Text             = opts3.Name or "Toggle",
                Font             = Enum.Font.Gotham,
                TextSize         = 12,
                TextColor3       = C.text,
                TextXAlignment   = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                Parent           = row,
            })

            -- track
            local track = new("Frame", {
                Size             = UDim2.new(0, 40, 0, 22),
                Position         = UDim2.new(1, -54, 0.5, -11),
                BackgroundColor3 = val and C.accent or C.border,
                BorderSizePixel  = 0,
                Parent           = row,
            })
            corner(track, 11)

            -- thumb
            local thumb = new("Frame", {
                Size             = UDim2.new(0, 16, 0, 16),
                Position         = val and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel  = 0,
                Parent           = track,
            })
            corner(thumb, 8)

            local function setToggle(v, fireCallback)
                val = v
                if v then
                    tween(track, { BackgroundColor3 = C.accent })
                    tween(thumb, { Position = UDim2.new(1, -19, 0.5, -8) })
                else
                    tween(track, { BackgroundColor3 = C.border })
                    tween(thumb, { Position = UDim2.new(0, 3, 0.5, -8) })
                end
                if fireCallback and opts3.Callback then
                    pcall(opts3.Callback, v)
                end
            end

            hBtn.Activated:Connect(function()
                setToggle(not val, true)
            end)
            hBtn.MouseEnter:Connect(function()
                tween(row, { BackgroundColor3 = Color3.fromRGB(28, 33, 48) })
            end)
            hBtn.MouseLeave:Connect(function()
                tween(row, { BackgroundColor3 = C.elevated })
            end)

            setToggle(val, false)

            local toggleObj = {}
            function toggleObj:Set(v) setToggle(v, true) end
            function toggleObj:Get() return val end
            return toggleObj
        end

        -- BUTTON ───────────────────────────────────────────
        function tabObj:CreateButton(opts3)
            local row = new("TextButton", {
                Size             = UDim2.new(1, 0, 0, 40),
                BackgroundColor3 = C.elevated,
                Text             = "",
                BorderSizePixel  = 0,
                LayoutOrder      = nextOrder(),
                Parent           = page,
            })
            corner(row, 8)
            stroke(row, C.border)

            local label = new("TextLabel", {
                Size             = UDim2.new(1, 0, 1, 0),
                Text             = opts3.Name or "Button",
                Font             = Enum.Font.GothamBold,
                TextSize         = 12,
                TextColor3       = C.accent,
                BackgroundTransparency = 1,
                Parent           = row,
            })

            -- shimmer on click
            row.Activated:Connect(function()
                tween(row, { BackgroundColor3 = Color3.fromRGB(0, 55, 48) }, 0.1)
                task.wait(0.1)
                tween(row, { BackgroundColor3 = C.elevated }, 0.25)
                if opts3.Callback then pcall(opts3.Callback) end
