-- ── Tween helpers ────────────────────────────────────────────
local function tween(obj, props, t, style, dir)
    local info = TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    TweenService:Create(obj, info, props):Play()
end

local function spring(obj, props, t)
    tween(obj, props, t or 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

-- ── Utility ──────────────────────────────────────────────────
local function new(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    return obj
end

local function corner(obj, radius)
    local c = new("UICorner", { CornerRadius = UDim.new(0, radius or 6) })
    c.Parent = obj
    return c
end

local function stroke(obj, color, thickness, transparency)
    local s = new("UIStroke", {
        Color        = color or C.border,
        Thickness    = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
    s.Parent = obj
    return s
end

local function gradient(obj, fromColor, toColor, rotation)
    local g = new("UIGradient", {
        Color    = ColorSequence.new(fromColor, toColor),
        Rotation = rotation or 90,
    })
    g.Parent = obj
    return g
end

local function makeDraggable(frame, handle)
    local drag, startPos, startMouse = false, nil, nil
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag      = true
            startPos  = frame.Position
            startMouse = i.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local delta = i.Position - startMouse
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

-- ── Notification queue ───────────────────────────────────────
local notifHolder = nil
local notifCount  = 0

local function ensureNotifHolder(gui)
    if notifHolder and notifHolder.Parent then return notifHolder end
    notifHolder = new("Frame", {
        Name             = "NotifHolder",
        AnchorPoint      = Vector2.new(1, 1),
        Position         = UDim2.new(1, -18, 1, -18),
        Size             = UDim2.new(0, 310, 1, -18),
        BackgroundTransparency = 1,
        Parent           = gui,
    })
    local list = new("UIListLayout", {
        SortOrder        = Enum.SortOrder.LayoutOrder,
        VerticalAlignment= Enum.VerticalAlignment.Bottom,
        Padding          = UDim.new(0, 8),
    })
    list.Parent = notifHolder
    return notifHolder
end

local function sendNotif(gui, opts)
    notifCount += 1
    local holder = ensureNotifHolder(gui)

    local accent = opts.Type == "error"   and C.danger
                or opts.Type == "success" and C.success
                or opts.Type == "warn"    and C.warn
                or C.accent

    local card = new("Frame", {
        Name             = "Notif_" .. notifCount,
        Size             = UDim2.new(1, 0, 0, 0),
        AutomaticSize    = Enum.AutomaticSize.Y,
        BackgroundColor3 = C.surface,
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        LayoutOrder      = notifCount,
        Parent           = holder,
    })
    corner(card, 8)
    stroke(card, accent, 1, 0.5)

    -- accent strip
    local strip = new("Frame", {
        Size             = UDim2.new(0, 3, 1, 0),
        Position         = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = accent,
        BorderSizePixel  = 0,
        Parent           = card,
    })
    corner(strip, 3)

    local inner = new("Frame", {
        Size             = UDim2.new(1, -14, 1, 0),
        Position         = UDim2.new(0, 14, 0, 0),
        AutomaticSize    = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent           = card,
    })

    local pad = new("UIPadding", { PaddingTop=UDim.new(0,10), PaddingBottom=UDim.new(0,10), PaddingRight=UDim.new(0,10) })
    pad.Parent = inner

    new("TextLabel", {
        Size             = UDim2.new(1, 0, 0, 0),
        AutomaticSize    = Enum.AutomaticSize.Y,
        Text             = opts.Title or "Notice",
        Font             = Enum.Font.GothamBold,
        TextSize         = 13,
        TextColor3       = accent,
        TextXAlignment   = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        Parent           = inner,
    })

    if opts.Content and opts.Content ~= "" then
        new("TextLabel", {
            Size             = UDim2.new(1, 0, 0, 0),
            AutomaticSize    = Enum.AutomaticSize.Y,
            Position         = UDim2.new(0, 0, 0, 20),
            Text             = opts.Content,
            Font             = Enum.Font.Gotham,
            TextSize         = 11,
            TextColor3       = C.textDim,
            TextXAlignment   = Enum.TextXAlignment.Left,
            TextWrapped      = true,
            BackgroundTransparency = 1,
            Parent           = inner,
        })
    end

    -- progress bar
    local bar = new("Frame", {
        Size             = UDim2.new(1, 0, 0, 2),
        Position         = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = accent,
        BorderSizePixel  = 0,
        Parent           = card,
    })
    corner(bar, 1)

    -- animate in
    task.spawn(function()
        tween(card, { BackgroundTransparency = 0.08 }, 0.22)
        local dur = opts.Duration or 5
        tween(bar, { Size = UDim2.new(0, 0, 0, 2) }, dur, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        task.wait(dur)
        tween(card, { BackgroundTransparency = 1 }, 0.3)
        task.wait(0.35)
        card:Destroy()
    end)
end

