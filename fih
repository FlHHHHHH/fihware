            row.MouseEnter:Connect(function()
                tween(row, { BackgroundColor3 = Color3.fromRGB(28, 33, 48) })
                tween(label, { TextColor3 = C.accentGlow })
            end)
            row.MouseLeave:Connect(function()
                tween(row, { BackgroundColor3 = C.elevated })
                tween(label, { TextColor3 = C.accent })
            end)
        end

