-- ── Cached TweenInfos — created once, reused everywhere ──────────────────────
local TI = {
    fast   = TweenInfo.new(0.15, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out),
    med    = TweenInfo.new(0.25, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out),
    spring = TweenInfo.new(0.38, Enum.EasingStyle.Back,  Enum.EasingDirection.Out),
    linear = TweenInfo.new(1.0,  Enum.EasingStyle.Linear,Enum.EasingDirection.Out),
}

local function tw(obj, props, info)
    if not obj or not obj.Parent then return end
    TweenService:Create(obj, info or TI.fast, props):Play()
end

-- ── Instance factory ─────────────────────────────────────────────────────────
local function make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        pcall(function() obj[k] = v end)
    end
    if parent then obj.Parent = parent end
    return obj
end

local function addCorner(parent, r)
    return make("UICorner", { CornerRadius = UDim.new(0, r or 6) }, parent)
end

local function addStroke(parent, color, thick)
    return make("UIStroke", {
        Color           = color or C.border,
        Thickness       = thick or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

local function addGradient(parent, c0, c1, rot)
    return make("UIGradient", {
        Color    = ColorSequence.new(c0, c1),
        Rotation = rot or 90,
    }, parent)
end

-- ── Draggable ─────────────────────────────────────────────────────────────────
-- The correct Roblox drag pattern:
--   dragStart  = position captured from InputBegan (snapshot, not live)
--   dragInput  = a MouseMovement InputObject from frame.InputChanged (IS live)
--   Global UIS.InputChanged fires every frame; when input == dragInput we update.
local function makeDraggable(win, handle)
    local dragging  = false
    local dragInput = nil
    local dragStart = nil
    local startPos  = nil

    handle.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t ~= Enum.UserInputType.MouseButton1
        and t ~= Enum.UserInputType.Touch then return end

        dragging  = true
        dragStart = input.Position
        startPos  = win.Position

        -- Detect release through the input object itself
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end)

    -- frame.InputChanged yields a live-updating MouseMovement object
    handle.InputChanged:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseMovement
        or t == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or input ~= dragInput then return end

        local delta = input.Position - dragStart
        local cam   = workspace.CurrentCamera
        local vp    = cam and cam.ViewportSize or Vector2.new(1920, 1080)
        local ws    = win.AbsoluteSize

        local nx = math.clamp(startPos.X.Offset + delta.X, 0, vp.X - ws.X)
        local ny = math.clamp(startPos.Y.Offset + delta.Y, 0, vp.Y - ws.Y)
        win.Position = UDim2.fromOffset(nx, ny)
    end)
end

-- ── Notification system ───────────────────────────────────────────────────────
-- No UIListLayout here — manual Y stacking avoids reflow jank on add/remove.
local NOTIF_W  = 296
local NOTIF_G  = 8   -- gap between toasts
local NOTIF_MR = 16  -- margin right
local NOTIF_MB = 16  -- margin bottom

local notifStack = {}  -- { card, h }

local function reflowNotifs()
    local y = NOTIF_MB
    for i = #notifStack, 1, -1 do
        local s = notifStack[i]
        if s.card and s.card.Parent then
            local h = s.card.AbsoluteSize.Y
            if h < 2 then h = s.h or 70 end
            tw(s.card, {
                Position = UDim2.new(1, -(NOTIF_W + NOTIF_MR), 1, -(y + h))
            }, TI.med)
            y = y + h + NOTIF_G
        end
    end
end

local function pushNotif(gui, opts)
    local accent = (opts.Type == "error")   and C.danger
                or (opts.Type == "success") and C.success
                or (opts.Type == "warn")    and C.warn
                or C.accent
    local dur = math.max(opts.Duration or 5, 1)

    -- Card starts off-screen below
    local card = make("Frame", {
        AnchorPoint      = Vector2.new(0, 1),
        Size             = UDim2.fromOffset(NOTIF_W, 1),
        AutomaticSize    = Enum.AutomaticSize.Y,
        Position         = UDim2.new(1, -(NOTIF_W + NOTIF_MR), 1, 20),
        BackgroundColor3 = C.surface,
        BorderSizePixel  = 0,
        ZIndex           = 20,
        Parent           = gui,
    })
    addCorner(card, 8)
    addStroke(card, accent, 1)

    -- Left colour strip
    local strip = make("Frame", {
        Size             = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = accent,
        BorderSizePixel  = 0,
        ZIndex           = 21,
        Parent           = card,
    })
    addCorner(strip, 2)

    -- Content frame (offset by strip width)
    -- UIListLayout here is fine — it's a small, static list inside one card
    local content = make("Frame", {
        Size             = UDim2.new(1, -3, 0, 0),
        Position         = UDim2.fromOffset(3, 0),
        AutomaticSize    = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ZIndex           = 21,
        Parent           = card,
    })
    make("UIPadding", {
        PaddingTop    = UDim.new(0, 9),
        PaddingBottom = UDim.new(0, 9),
        PaddingLeft   = UDim.new(0, 9),
        PaddingRight  = UDim.new(0, 9),
    }, content)
    make("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding   = UDim.new(0, 4),
    }, content)

    make("TextLabel", {
        Size             = UDim2.new(1, 0, 0, 15),
        Text             = opts.Title or "Notice",
        Font             = Enum.Font.GothamBold,
        TextSize         = 12,
        TextColor3       = accent,
        TextXAlignment   = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        LayoutOrder      = 1,
        ZIndex           = 21,
        Parent           = content,
    })

    if opts.Content and opts.Content ~= "" then
        make("TextLabel", {
            Size             = UDim2.new(1, 0, 0, 0),
            AutomaticSize    = Enum.AutomaticSize.Y,
            Text             = opts.Content,
            Font             = Enum.Font.Gotham,
            TextSize         = 10,
            TextColor3       = C.textDim,
            TextXAlignment   = Enum.TextXAlignment.Left,
            TextWrapped      = true,
            BackgroundTransparency = 1,
            LayoutOrder      = 2,
            ZIndex           = 21,
            Parent           = content,
        })
    end

    -- Progress bar (bottom)
    local progRow = make("Frame", {
        Size        = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = C.border,
        BorderSizePixel = 0,
        LayoutOrder = 3,
        ZIndex      = 21,
        Parent      = content,
    })
    addCorner(progRow, 1)
    local prog = make("Frame", {
        Size             = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = accent,
        BorderSizePixel  = 0,
        ZIndex           = 22,
        Parent           = progRow,
    })
    addCorner(prog, 1)

    local slot = { card = card, h = 70 }
    table.insert(notifStack, slot)

    task.spawn(function()
        task.wait(0.05)  -- let AutomaticSize resolve
        slot.h = math.max(card.AbsoluteSize.Y, 70)
        reflowNotifs()

        -- Drain progress bar
        local dInfo = TweenInfo.new(dur, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
        tw(prog, { Size = UDim2.new(0, 0, 1, 0) }, dInfo)
        task.wait(dur)

        -- Slide out downward
        tw(card, { Position = UDim2.new(1, -(NOTIF_W + NOTIF_MR), 1, 20) }, TI.med)
        task.wait(0.28)

        -- Remove from stack and reflow survivors
        for i, s in ipairs(notifStack) do
            if s == slot then table.remove(notifStack, i) break end
        end
        card:Destroy()
        reflowNotifs()
    end)
end

-- ╔═══════════════════════════════════════════════════════════════════════════╗
--  CreateWindow
-- ╚═══════════════════════════════════════════════════════════════════════════╝
function fihware:CreateWindow(opts)
    opts = opts or {}

    -- ScreenGui: Sibling ZIndexBehavior = children always above parent.
    -- No global ZIndex juggling needed. DisplayOrder keeps it above game UIs.
    local gui = make("ScreenGui", {
        Name           = "fihware",
        ResetOnSpawn   = false,
        IgnoreGuiInset = true,
        DisplayOrder   = 999,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    -- Executors allow CoreGui; fallback gracefully for studio/standard scripts
    if not pcall(function() gui.Parent = game:GetService("CoreGui") end) then
        gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    end

    local cam        = workspace.CurrentCamera
    local vp         = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local WIN_W, WIN_H = 540, 400
    local SIDEBAR_W  = 128
    local BAR_H      = 44

    -- Window root — NO ClipsDescendants, has UICorner
    -- ClipsDescendants on a rounded frame clips at the rectangular boundary,
    -- not the rounded one — children bleed out at corners.
    local win = make("Frame", {
        Name             = "Window",
        Position         = UDim2.fromOffset(
            math.floor(vp.X / 2 - WIN_W / 2),
            math.floor(vp.Y / 2 - WIN_H / 2)
        ),
        Size             = UDim2.fromOffset(WIN_W, WIN_H),
        BackgroundColor3 = C.bg,
        BorderSizePixel  = 0,
        Parent           = gui,
    })
    addCorner(win, 12)
    addStroke(win, C.border, 1)

    -- Drop shadow (behind everything, ZIndex 0)
    make("ImageLabel", {
        AnchorPoint       = Vector2.new(0.5, 0.5),
        Position          = UDim2.new(0.5, 0, 0.5, 8),
        Size              = UDim2.new(1, 80, 1, 80),
        BackgroundTransparency = 1,
        Image             = "rbxassetid://6014261993",
        ImageColor3       = Color3.fromRGB(0, 175, 150),
        ImageTransparency = 0.78,
        ScaleType         = Enum.ScaleType.Slice,
        SliceCenter       = Rect.new(49, 49, 450, 450),
        ZIndex            = 0,
        Parent            = win,
    })

    -- ── Title bar ─────────────────────────────────────────────────────────────
    -- Rounded top corners: apply UICorner with same radius, then cover the
    -- bottom half of the radius with an opaque rectangle of the same colour.
    -- This is the standard trick since ClipsDescendants won't round-clip.
    local titleBar = make("Frame", {
        Size             = UDim2.new(1, 0, 0, BAR_H),
        BackgroundColor3 = C.surface,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = win,
    })
    addCorner(titleBar, 12)
    -- Cover bottom radius area
    make("Frame", {
        Size             = UDim2.new(1, 0, 0, 12),
        Position         = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = C.surface,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = titleBar,
    })

    -- Accent underline
    local accentLine = make("Frame", {
        Size             = UDim2.new(1, 0, 0, 1),
        Position         = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = C.accent,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = titleBar,
    })
    addGradient(accentLine, C.accent, C.accentDim, 0)

    -- Status dot
    local dot = make("Frame", {
        Size             = UDim2.fromOffset(8, 8),
        Position         = UDim2.new(0, 14, 0.5, -4),
        BackgroundColor3 = C.accent,
        BorderSizePixel  = 0,
        ZIndex           = 4,
        Parent           = titleBar,
    })
    addCorner(dot, 4)

    make("TextLabel", {
        Size             = UDim2.new(1, -100, 1, 0),
        Position         = UDim2.fromOffset(30, 0),
        Text             = opts.Name or "fihware",
        Font             = Enum.Font.GothamBold,
        TextSize         = 13,
        TextColor3       = C.text,
        TextXAlignment   = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1,
        ZIndex           = 4,
        Parent           = titleBar,
    })

    make("TextLabel", {
        AnchorPoint      = Vector2.new(1, 0.5),
        Size             = UDim2.fromOffset(65, BAR_H),
        Position         = UDim2.new(1, -44, 0, 0),
        Text             = "fihware",
        Font             = Enum.Font.GothamBold,
        TextSize         = 9,
        TextColor3       = C.accent,
        TextXAlignment   = Enum.TextXAlignment.Right,
        BackgroundTransparency = 1,
        ZIndex           = 4,
        Parent           = titleBar,
    })

    -- Close button
    local closeBtn = make("TextButton", {
        AnchorPoint      = Vector2.new(1, 0.5),
        Size             = UDim2.fromOffset(26, 26),
        Position         = UDim2.new(1, -9, 0.5, 0),
        Text             = "✕",
        Font             = Enum.Font.GothamBold,
        TextSize         = 11,
        TextColor3       = C.textMuted,
        BackgroundColor3 = C.elevated,
        BorderSizePixel  = 0,
        ZIndex           = 5,
        Parent           = titleBar,
    })
    addCorner(closeBtn, 5)
    closeBtn.MouseEnter:Connect(function()
        tw(closeBtn, { TextColor3 = C.danger, BackgroundColor3 = Color3.fromRGB(52, 16, 16) })
    end)
    closeBtn.MouseLeave:Connect(function()
        tw(closeBtn, { TextColor3 = C.textMuted, BackgroundColor3 = C.elevated })
    end)
    closeBtn.Activated:Connect(function()
        tw(win, { Size = UDim2.fromOffset(WIN_W, 0) }, TI.spring)
        task.delay(0.35, function() pcall(function() gui:Destroy() end) end)
    end)

    makeDraggable(win, titleBar)

    -- ── Sidebar ───────────────────────────────────────────────────────────────
    local sidebar = make("Frame", {
        Size             = UDim2.new(0, SIDEBAR_W, 1, -BAR_H),
        Position         = UDim2.new(0, 0, 0, BAR_H),
        BackgroundColor3 = C.surface,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = win,
    })

    -- Right border line on sidebar
    make("Frame", {
        Size             = UDim2.new(0, 1, 1, 0),
        Position         = UDim2.new(1, -1, 0, 0),
        BackgroundColor3 = C.border,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = sidebar,
    })

    -- Bottom-left corner fill (sidebar sits over the window's corner curve)
    make("Frame", {
        Size             = UDim2.fromOffset(12, 12),
        Position         = UDim2.new(0, 0, 1, -12),
        BackgroundColor3 = C.surface,
        BorderSizePixel  = 0,
        ZIndex           = 3,
        Parent           = sidebar,
    })

    -- Tab button list (UIListLayout is fine here — fixed-height items, no AutomaticSize fight)
    local tabContainer = make("Frame", {
        Size                  = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency= 1,
        ZIndex                = 3,
        Parent                = sidebar,
    })
    make("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding   = UDim.new(0, 3),
        Parent    = tabContainer,
    })
    make("UIPadding", {
        PaddingTop   = UDim.new(0, 10),
        PaddingLeft  = UDim.new(0, 7),
        PaddingRight = UDim.new(0, 7),
        Parent       = tabContainer,
    })

    -- ── Content area ──────────────────────────────────────────────────────────
    -- This frame has NO UICorner, so ClipsDescendants works correctly here.
    local contentArea = make("Frame", {
        Size             = UDim2.new(1, -SIDEBAR_W, 1, -BAR_H),
        Position         = UDim2.new(0, SIDEBAR_W, 0, BAR_H),
        BackgroundColor3 = C.bg,
        BorderSizePixel  = 0,
        ClipsDescendants = true,  -- safe: no UICorner on this frame
        ZIndex           = 2,
        Parent           = win,
    })

    -- Fill the bottom-right radius of the window so the bg shows through
    make("Frame", {
        Size             = UDim2.fromOffset(12, 12),
        Position         = UDim2.new(1, -12, 1, -12),
        BackgroundColor3 = C.bg,
        BorderSizePixel  = 0,
        ZIndex           = 2,
        Parent           = contentArea,
    })

    -- ── Window object ─────────────────────────────────────────────────────────
    local windowObj = {
        _gui         = gui,
        _win         = win,
        _tabContainer= tabContainer,
        _contentArea = contentArea,
        _tabs        = {},
        _activeTab   = nil,
    }

    -- Entrance: spring up from slightly below
    win.Position = UDim2.fromOffset(
        math.floor(vp.X / 2 - WIN_W / 2),
        math.floor(vp.Y / 2 - WIN_H / 2 + 24)
    )
    tw(win, {
        Position = UDim2.fromOffset(
            math.floor(vp.X / 2 - WIN_W / 2),
            math.floor(vp.Y / 2 - WIN_H / 2)
        )
    }, TI.spring)

    function windowObj:Notify(opts2)
        pushNotif(gui, opts2 or {})
    end

    -- ── CreateTab ─────────────────────────────────────────────────────────────
    function windowObj:CreateTab(name)
        local idx = #self._tabs + 1

        -- Sidebar button — fixed height, LayoutOrder for list sorting
        local btn = make("TextButton", {
            Size             = UDim2.new(1, 0, 0, 32),
            Text             = "",
            BackgroundColor3 = C.elevated,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            LayoutOrder      = idx,
            ZIndex           = 4,
            Parent           = tabContainer,
        })
        addCorner(btn, 7)

        local pill = make("Frame", {
            Size             = UDim2.fromOffset(3, 18),
            Position         = UDim2.new(0, 0, 0.5, -9),
            BackgroundColor3 = C.accent,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            ZIndex           = 5,
            Parent           = btn,
        })
        addCorner(pill, 2)

        local btnLabel = make("TextLabel", {
            Size             = UDim2.new(1, -18, 1, 0),
            Position         = UDim2.fromOffset(13, 0),
            Text             = name,
            Font             = Enum.Font.Gotham,
            TextSize         = 12,
            TextColor3       = C.textDim,
            TextXAlignment   = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            ZIndex           = 5,
            Parent           = btn,
        })

        -- ── ScrollingFrame ────────────────────────────────────────────────────
        -- Key pattern: CanvasSize driven by UIListLayout.AbsoluteContentSize.
        -- UIPadding is on an INNER frame, not the ScrollingFrame itself.
        -- AutomaticCanvasSize is left off — we manage it manually via Changed.
        -- This avoids the AutomaticCanvasSize + UIPadding = broken padding bug.
        local page = make("ScrollingFrame", {
            Size                 = UDim2.new(1, 0, 1, 0),
            CanvasSize           = UDim2.fromOffset(0, 0),
            ScrollingDirection   = Enum.ScrollingDirection.Y,
            ScrollBarThickness   = 3,
            ScrollBarImageColor3 = C.accent,
            BackgroundTransparency = 1,
            BorderSizePixel      = 0,
            Visible              = false,
            ZIndex               = 3,
            Parent               = contentArea,
        })

        -- Inner frame: holds items + layout + padding
        local inner = make("Frame", {
            Size             = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            ZIndex           = 3,
            Parent           = page,
        })

        local listLayout = make("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding   = UDim.new(0, 6),
            Parent    = inner,
        })

        -- UIPadding on the INNER frame (not the ScrollingFrame)
        make("UIPadding", {
            PaddingTop    = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 12),
            PaddingLeft   = UDim.new(0, 12),
            PaddingRight  = UDim.new(0, 12),
            Parent        = inner,
        })

        -- Drive CanvasSize from layout's content size (reliable, no AutomaticCanvasSize)
        local function updateCanvas()
            local cs = listLayout.AbsoluteContentSize
            local totalH = cs.Y + 24  -- 12 top + 12 bottom padding
            page.CanvasSize = UDim2.fromOffset(0, totalH)
            inner.Size      = UDim2.fromOffset(page.AbsoluteSize.X, totalH)
        end
        listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
        page:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateCanvas)

        -- Tab object
        local tabObj = {
            _btn    = btn,
            _pill   = pill,
            _label  = btnLabel,
            _page   = page,
            _inner  = inner,
            _order  = 0,
            _win    = windowObj,
        }

        local function activate()
            for _, t in ipairs(windowObj._tabs) do
                tw(t._btn,   { BackgroundTransparency = 1 })
                tw(t._pill,  { BackgroundTransparency = 1 })
                tw(t._label, { TextColor3 = C.textDim })
                t._page.Visible = false
            end
            tw(btn,      { BackgroundTransparency = 0.5, BackgroundColor3 = C.elevated })
            tw(pill,     { BackgroundTransparency = 0 })
            tw(btnLabel, { TextColor3 = C.text })
            page.Visible = true
            windowObj._activeTab = tabObj
        end

        btn.Activated:Connect(activate)
        btn.MouseEnter:Connect(function()
            if windowObj._activeTab == tabObj then return end
            tw(btn,      { BackgroundTransparency = 0.72, BackgroundColor3 = C.elevated })
            tw(btnLabel, { TextColor3 = Color3.fromRGB(150, 168, 200) })
        end)
        btn.MouseLeave:Connect(function()
            if windowObj._activeTab == tabObj then return end
            tw(btn,      { BackgroundTransparency = 1 })
            tw(btnLabel, { TextColor3 = C.textDim })
        end)

        table.insert(windowObj._tabs, tabObj)
        if #windowObj._tabs == 1 then activate() end

        local function nextOrder()
            tabObj._order += 1
            return tabObj._order
        end

        -- ── SECTION ───────────────────────────────────────────────────────────
        function tabObj:CreateSection(label)
            local row = make("Frame", {
                Size             = UDim2.new(1, 0, 0, 28),
                BackgroundTransparency = 1,
                LayoutOrder      = nextOrder(),
                ZIndex           = 4,
                Parent           = inner,
            })
            make("TextLabel", {
                Size             = UDim2.new(1, 0, 0, 18),
                Text             = label:upper(),
                Font             = Enum.Font.GothamBold,
                TextSize         = 9,
                TextColor3       = C.accent,
                TextXAlignment   = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                ZIndex           = 4,
                Parent           = row,
            })
            make("Frame", {
                Size             = UDim2.new(1, 0, 0, 1),
                Position         = UDim2.new(0, 0, 1, -1),
                BackgroundColor3 = C.border,
                BorderSizePixel  = 0,
                ZIndex           = 4,
                Parent           = row,
            })
        end

        -- ── TOGGLE ────────────────────────────────────────────────────────────
        function tabObj:CreateToggle(opts2)
            local val = opts2.CurrentValue == true

            local row = make("Frame", {
                Size             = UDim2.new(1, 0, 0, 42),
                BackgroundColor3 = C.elevated,
                BorderSizePixel  = 0,
                LayoutOrder      = nextOrder(),
                ZIndex           = 4,
                Parent           = inner,
            })
            addCorner(row, 8)
            addStroke(row, C.border, 1)

            -- Invisible hit button on top
            local hitBtn = make("TextButton", {
                Size             = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text             = "",
                ZIndex           = 6,
                Parent           = row,
            })

            make("TextLabel", {
                Size             = UDim2.new(1, -72, 1, 0),
                Position         = UDim2.fromOffset(13, 0),
                Text             = opts2.Name or "Toggle",
                Font             = Enum.Font.Gotham,
                TextSize         = 12,
                TextColor3       = C.text,
                TextXAlignment   = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                ZIndex           = 5,
                Parent           = row,
            })

            -- Track: rounded pill
            local track = make("Frame", {
                AnchorPoint      = Vector2.new(1, 0.5),
                Size             = UDim2.fromOffset(38, 20),
                Position         = UDim2.new(1, -13, 0.5, 0),
                BackgroundColor3 = val and C.accent or C.border,
                BorderSizePixel  = 0,
                ZIndex           = 5,
                Parent           = row,
            })
            addCorner(track, 10)

            -- Thumb: positioned inside track bounds so it never clips at the curve.
            -- We use AnchorPoint 0.5,0.5 + UDim2 scale so it stays inside the pill.
            -- Do NOT use ClipsDescendants=true on track (UICorner won't clip it right).
            local thumb = make("Frame", {
                AnchorPoint      = Vector2.new(0.5, 0.5),
                Size             = UDim2.fromOffset(14, 14),
                Position         = val and UDim2.new(0.77, 0, 0.5, 0)
                                       or  UDim2.new(0.23, 0, 0.5, 0),
                BackgroundColor3 = C.white,
                BorderSizePixel  = 0,
                ZIndex           = 6,
                Parent           = track,
            })
            addCorner(thumb, 7)

            local function setState(v, fire)
                val = v
                tw(track, { BackgroundColor3 = v and C.accent or C.border }, TI.fast)
                tw(thumb, {
                    Position = v and UDim2.new(0.77, 0, 0.5, 0) or UDim2.new(0.23, 0, 0.5, 0)
                }, TI.fast)
                if fire and opts2.Callback then pcall(opts2.Callback, v) end
            end

            hitBtn.Activated:Connect(function() setState(not val, true) end)
            hitBtn.MouseEnter:Connect(function()
                tw(row, { BackgroundColor3 = Color3.fromRGB(27, 33, 48) })
            end)
            hitBtn.MouseLeave:Connect(function()
                tw(row, { BackgroundColor3 = C.elevated })
            end)
            setState(val, false)

            local obj = {}
            function obj:Set(v) setState(v, true) end
            function obj:Get() return val end
            return obj
        end

        -- ── BUTTON ────────────────────────────────────────────────────────────
        function tabObj:CreateButton(opts2)
            local btn2 = make("TextButton", {
                Size             = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = C.elevated,
                Text             = "",
                BorderSizePixel  = 0,
                LayoutOrder      = nextOrder(),
                ZIndex           = 4,
                Parent           = inner,
            })
            addCorner(btn2, 8)
            addStroke(btn2, C.border, 1)

            local lbl = make("TextLabel", {
                Size             = UDim2.new(1, 0, 1, 0),
                Text             = opts2.Name or "Button",
                Font             = Enum.Font.GothamBold,
                TextSize         = 12,
                TextColor3       = C.accent,
                BackgroundTransparency = 1,
                ZIndex           = 5,
                Parent           = btn2,
            })

            btn2.Activated:Connect(function()
                tw(btn2, { BackgroundColor3 = Color3.fromRGB(0, 48, 42) }, TI.fast)
                task.delay(0.14, function()
                    tw(btn2, { BackgroundColor3 = C.elevated }, TI.med)
                end)
                if opts2.Callback then pcall(opts2.Callback) end
            end)
            btn2.MouseEnter:Connect(function()
                tw(btn2, { BackgroundColor3 = Color3.fromRGB(26, 32, 47) })
                tw(lbl,  { TextColor3 = C.accentGlow })
            end)
            btn2.MouseLeave:Connect(function()
                tw(btn2, { BackgroundColor3 = C.elevated })
                tw(lbl,  { TextColor3 = C.accent })
            end)
        end

        -- ── INPUT ─────────────────────────────────────────────────────────────
        function tabObj:CreateInput(opts2)
            local row = make("Frame", {
                Size             = UDim2.new(1, 0, 0, 58),
                BackgroundColor3 = C.elevated,
                BorderSizePixel  = 0,
                LayoutOrder      = nextOrder(),
                ZIndex           = 4,
                Parent           = inner,
            })
            addCorner(row, 8)
            addStroke(row, C.border, 1)

            make("TextLabel", {
                Size             = UDim2.new(1, -16, 0, 20),
                Position         = UDim2.fromOffset(12, 2),
                Text             = opts2.Name or "Input",
                Font             = Enum.Font.Gotham,
                TextSize         = 10,
                TextColor3       = C.textDim,
                TextXAlignment   = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1,
                ZIndex           = 5,
                Parent           = row,
            })

            local boxBg = make("Frame", {
                Size             = UDim2.new(1, -24, 0, 24),
                Position         = UDim2.new(0, 12, 0, 24),
                BackgroundColor3 = C.bg,
                BorderSizePixel  = 0,
                ZIndex           = 5,
                Parent           = row,
            })
            addCorner(boxBg, 5)
            local boxStroke = addStroke(boxBg, C.border, 1)

            local box = make("TextBox", {
                Size              = UDim2.new(1, -16, 1, 0),
                Position          = UDim2.fromOffset(8, 0),
                BackgroundTransparency = 1,
                PlaceholderText   = opts2.PlaceholderText or "",
                PlaceholderColor3 = C.textMuted,
                Text              = "",
                Font              = Enum.Font.Gotham,
                TextSize          = 11,
                TextColor3        = C.text,
                TextXAlignment    = Enum.TextXAlignment.Left,
                ClearTextOnFocus  = false,
                ZIndex            = 6,
                Parent            = boxBg,
            })

            box.Focused:Connect(function()
                tw(boxStroke, { Color = C.accent }, TI.fast)
            end)
            box.FocusLost:Connect(function()
                tw(boxStroke, { Color = C.border }, TI.fast)
                if opts2.Callback then pcall(opts2.Callback, box.Text) end
                if opts2.RemoveTextAfterFocusLost then box.Text = "" end
            end)
        end

        return tabObj
    end -- CreateTab

    return windowObj
end -- CreateWindow

return fihware
