    while true do
        task.wait(0.4)
        updateESP()

        if not cfg.enabled or isProcessing or not root then
            if not cfg.enabled then
                clearWaypoints()
                stopAntiAFK()
            end
            continue
        end

        local egg = getClosestEgg()
        if not egg then continue end

        isProcessing = true
        preEggCurrency = getCurrencyText()
        Rayfield:Notify({ Title = "Moving", Content = "Walking to " .. egg.Name, Duration = 2 })

        local result = walkToEgg(egg)

        if result == "abort" then
            failedEggs[egg] = MAX_EGG_FAILS + 1
            removeEggESP(egg)
            task.spawn(resetCharacter)
            isProcessing = false
            continue
        end

        if result == "failed" then
            failedEggs[egg] = (failedEggs[egg] or 0) + 1
            if failedEggs[egg] >= MAX_EGG_FAILS then
                Rayfield:Notify({
                    Title    = "⚠️ Skipping Egg",
                    Content  = egg.Name .. " is unreachable after " .. MAX_EGG_FAILS .. " tries",
                    Duration = 5
                })
                removeEggESP(egg)
            end
            isProcessing = false
            continue
        end

        -- result == "success"
        if egg.Parent and cfg.enabled then
            local prompt = findPrompt(egg)
            if prompt then interact(prompt) end

            task.wait(cfg.collectDelay)

            local eggName   = egg.Name
            local collected = false
            local conn
            conn = egg.AncestryChanged:Connect(function(_, np)
                if np == nil then
                    collected = true
                    sendWebhook(eggName)
                    if conn then conn:Disconnect() end
                end
            end)

            local startT = tick()
            while not collected and tick() - startT < 12 do task.wait(0.3) end
            if conn then conn:Disconnect() end

            if collected then
                Rayfield:Notify({ Title = "✅ Collected", Content = eggName, Duration = 4 })
                removeEggESP(egg)
                failedEggs[egg] = nil
            end

            task.wait(0.5)
            resetCharacter()
        end

        isProcessing = false
    end
end)

player.CharacterAdded:Connect(function(nc)
    character    = nc
    humanoid     = nc:WaitForChild("Humanoid")
    root         = nc:WaitForChild("HumanoidRootPart")
    setupHumanoid(humanoid)
    isProcessing = false
    clearWaypoints()
    clearPosHistory()
end)

Workspace.DescendantRemoving:Connect(function(obj)
    if obj:IsA("BasePart") and isEgg(obj.Name) then
        failedEggs[obj] = nil
        removeEggESP(obj)
    end
end)

game:BindToClose(function()
    stopAntiAFK()
end)
