--  EGG + ESP
-- ============================================================
local function isEgg(n)
    for _, p in ipairs(EGG_PATS) do if n:match(p) then return true end end
    return false
end

local espFolder = nil
local function getESPFolder()
    if espFolder and espFolder.Parent then return espFolder end
    local f  = Instance.new("Folder")
    f.Name   = "EggMacroESP"
    f.Parent = Workspace
    espFolder = f
    return f
end

local function removeEggESP(egg)
    local hl = eggHighlights[egg]
    if hl then
        if hl.Parent then hl:Destroy() end
        eggHighlights[egg] = nil
    end
end

local function clearAllESP()
    for egg in pairs(eggHighlights) do removeEggESP(egg) end
    eggHighlights = {}
    if espFolder and espFolder.Parent then
        espFolder:Destroy()
        espFolder = nil
    end
end

local function createEggESP(egg)
    if eggHighlights[egg] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor           = Color3.fromRGB(0, 255, 120)
    hl.OutlineColor        = Color3.fromRGB(0, 255, 180)
    hl.FillTransparency    = 0.65
    hl.OutlineTransparency = 0
    hl.Adornee             = egg
    hl.Parent              = getESPFolder()
    eggHighlights[egg]     = hl
end

local function updateESP()
    if not cfg.espEnabled then return end
    local now = tick()
    if now - lastESPUpdate < 1.5 then return end
    lastESPUpdate = now
    for egg, hl in pairs(eggHighlights) do
        if not egg.Parent or not isEgg(egg.Name) then
            if hl and hl.Parent then hl:Destroy() end
            eggHighlights[egg] = nil
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and isEgg(obj.Name) and not eggHighlights[obj] then
            createEggESP(obj)
        end
    end
end

local function getClosestEgg()
    local best, minD = nil, math.huge
    local pos = root.Position
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and isEgg(obj.Name) and not failedEggs[obj] then
            local d = (obj.Position - pos).Magnitude
            if d < minD and d <= MAX_DIST then minD, best = d, obj end
        end
    end
    return best
end

local function findPrompt(egg)
    local p = egg:FindFirstChildOfClass("ProximityPrompt")
    if p then return p end
    for _, c in ipairs(egg:GetChildren()) do
        if c:IsA("Attachment") then
            local pp = c:FindFirstChildOfClass("ProximityPrompt")
            if pp then return pp end
        end
    end
    return egg:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function interact(prompt)
    if not prompt or not prompt.Parent then return end
    local hold = prompt.HoldDuration or 0
    for i = 1, 8 do
        if not prompt or not prompt.Parent then break end
        pcall(fireproximityprompt, prompt)
        task.wait(0.08)
    end
    task.wait(math.max(hold + 0.2, 0.35))
end

-- ============================================================
--  PATHFINDING
-- ============================================================

local ARRIVE_DIST       = 4.5
local ARRIVE_DIST_AIR   = 10
local JUMP_TRIGGER_DIST = 4.5
local WP_TIMEOUT        = 8
local MAX_RECOMPUTES    = 4
local TICK_RATE         = 0.05

local STUCK_WINDOW      = 1.8
local STUCK_THRESHOLD   = 1.0
local STUCK_JUMP_TRIES  = 2

local function setupHumanoid(hum)
    if hum then
        hum.AutoJumpEnabled = true
        hum.JumpPower       = 65
    end
end
setupHumanoid(humanoid)

local function isGrounded()
    return humanoid.FloorMaterial ~= Enum.Material.Air
end

local function waitForLanding(timeout)
    local t = tick()
    while not isGrounded() and tick() - t < timeout do
        task.wait(0.05)
    end
end

-- FIX: fires jump instantly and returns — never pauses walking
local function safeJump()
    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
end

local function computePath(from, to)
    local path = PathfindingService:CreatePath(PATH_PARAMS)
    local ok   = pcall(function() path:ComputeAsync(from, to) end)
    if not ok or path.Status ~= Enum.PathStatus.Success then return nil end
    local wps = path:GetWaypoints()
    if #wps < 2 then return nil end
    return path
end

local posHistory = {}

local function recordPosition()
    local now = tick()
    table.insert(posHistory, { pos = root.Position, t = now })
    while posHistory[1] and (now - posHistory[1].t) > STUCK_WINDOW + 0.1 do
        table.remove(posHistory, 1)
    end
end

local function isStuck()
    if #posHistory < 2 then return false end
    local oldest = posHistory[1]
    if (tick() - oldest.t) < STUCK_WINDOW then return false end
    local dist = (root.Position - oldest.pos).Magnitude
    return dist < STUCK_THRESHOLD
end

local function clearPosHistory()
    posHistory = {}
end

-- Returns: "success" | "failed" | "abort"
local function walkToEgg(egg)
    if not egg or not root then return "failed" end
    clearWaypoints()
    clearPosHistory()

    local recomputeCount = 0
    local jumpAttempts   = 0

    local function doRecompute()
        recomputeCount += 1
        if recomputeCount > MAX_RECOMPUTES then
            return false
        end
        clearWaypoints()
        clearPosHistory()
        return true
    end

    while cfg.enabled and egg.Parent do
        local path = computePath(root.Position, egg.Position)
        if not path then
            return "failed"
        end

        local waypoints = path:GetWaypoints()
        local totalWPs  = #waypoints
        local wpIndex   = 2

        if cfg.showWaypoints then createWaypointVisuals(waypoints) end

        local blocked     = false
        local blockedConn = path.Blocked:Connect(function(idx)
            if idx >= wpIndex then blocked = true end
        end)

        local wpClock = tick()

        humanoid:MoveTo(waypoints[wpIndex].Position)

        while cfg.enabled and egg.Parent do
            recordPosition()

            local wp        = waypoints[wpIndex]
            local isJumpWP  = wp.Action == Enum.PathWaypointAction.Jump
            local airborne  = not isGrounded()

            local flat = function(v)
                return Vector3.new(v.X, 0, v.Z)
            end

            local distToWP = (flat(root.Position) - flat(wp.Position)).Magnitude

            -- ── WAYPOINT ARRIVAL ────────────────────────────────
            local threshold = airborne and ARRIVE_DIST_AIR or ARRIVE_DIST

            if distToWP <= threshold then
                if isJumpWP then
                    if distToWP > JUMP_TRIGGER_DIST then
                        -- Not close enough to the jump point yet, keep walking
                        humanoid:MoveTo(wp.Position)
                        task.wait(TICK_RATE)
                        continue
                    end
                    -- FIX: fire jump and immediately continue — no waitForLanding
                    safeJump()
                    jumpAttempts = 0
                end

                wpIndex += 1
                if wpIndex > totalWPs then
                    blockedConn:Disconnect()
                    clearWaypoints()
                    clearPosHistory()
                    return "success"
                end

                humanoid:MoveTo(waypoints[wpIndex].Position)
                highlightCurrentWaypoint(wpIndex)
                wpClock = tick()
                clearPosHistory()
                task.wait(TICK_RATE)
                continue
            end

            -- ── BLOCKED / TIMED OUT → RECOMPUTE ─────────────────
            if blocked or (tick() - wpClock > WP_TIMEOUT) then
                blocked = false
                blockedConn:Disconnect()

                -- FIX: removed waitForLanding here — don't pause movement

                if not doRecompute() then
                    Rayfield:Notify({
                        Title    = "⚠️ Stuck — Resetting",
                        Content  = "Can't reach " .. egg.Name .. ", skipping.",
                        Duration = 5
                    })
                    clearWaypoints()
                    clearPosHistory()
                    return "abort"
                end

                break
            end

            -- Re-issue MoveTo every tick so it's never silently dropped mid-air
            humanoid:MoveTo(wp.Position)

            -- ── STUCK DETECTION ──────────────────────────────────
            if not airborne and isStuck() then
                clearPosHistory()
                jumpAttempts += 1

                if jumpAttempts > STUCK_JUMP_TRIES then
                    blockedConn:Disconnect()
                    Rayfield:Notify({
                        Title    = "⚠️ Stuck — Resetting",
                        Content  = "Couldn't un-stick for " .. egg.Name .. ", skipping.",
                        Duration = 5
                    })
                    clearWaypoints()
                    clearPosHistory()
                    return "abort"
                end

                -- FIX: jump to un-stick but don't wait for landing before recompute
                safeJump()
                task.wait(0.4)

                blockedConn:Disconnect()
                if not doRecompute() then
                    Rayfield:Notify({
                        Title    = "⚠️ Stuck — Resetting",
                        Content  = "Can't reach " .. egg.Name .. ", skipping.",
                        Duration = 5
                    })
                    clearWaypoints()
                    clearPosHistory()
                    return "abort"
                end

                break
            end

            task.wait(TICK_RATE)
        end

        blockedConn:Disconnect()
    end

    clearWaypoints()
    clearPosHistory()
    return "failed"
end

-- Full character reset (death respawn)
local function resetCharacter()
