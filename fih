    function windowObj:CreateTab(name, _icon)
        local tabIndex = #self._tabs + 1

        -- sidebar button
        local btn = new("TextButton", {
            Name             = "Tab_" .. name,
            Size             = UDim2.new(1, 0, 0, 34),
            Text             = "",
            BackgroundColor3 = C.elevated,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            LayoutOrder      = tabIndex,
            Parent           = tabBar,
        })
        corner(btn, 7)

        -- active pill
        local pill = new("Frame", {
            Name             = "Pill",
            Size             = UDim2.new(0, 3, 0.7, 0),
            Position         = UDim2.new(0, 0, 0.15, 0),
            BackgroundColor3 = C.accent,
            BackgroundTransparency = 1,
            BorderSizePixel  = 0,
            Parent           = btn,
        })
        corner(pill, 2)

        new("TextLabel", {
            Size             = UDim2.new(1, -18, 1, 0),
            Position         = UDim2.new(0, 14, 0, 0),
            Text             = name,
            Font             = Enum.Font.Gotham,
            TextSize         = 12,
            TextColor3       = C.textDim,
            TextXAlignment   = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            Parent           = btn,
        })

        -- content page (scrollable)
        local page = new("ScrollingFrame", {
            Name                    = "Page_" .. name,
            Size                    = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency  = 1,
            BorderSizePixel         = 0,
            ScrollBarThickness      = 3,
            ScrollBarImageColor3    = C.accent,
            CanvasSize              = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize     = Enum.AutomaticSize.Y,
            Visible                 = false,
            Parent                  = contentArea,
        })

        local pageList = new("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding   = UDim.new(0, 6),
            Parent    = page,
        })
        new("UIPadding", {
            PaddingTop    = UDim.new(0, 14),
            PaddingBottom = UDim.new(0, 14),
            PaddingLeft   = UDim.new(0, 14),
            PaddingRight  = UDim.new(0, 14),
            Parent        = page,
        })

        -- tab object
        local tabObj = {
            _btn  = btn,
            _pill = pill,
            _page = page,
            _itemIndex = 0,
            _window = windowObj,
        }

        local function activateTab()
            -- deactivate all
            for _, t in ipairs(windowObj._tabs) do
                tween(t._btn,  { BackgroundTransparency = 1 })
                tween(t._pill, { BackgroundTransparency = 1 })
                local lbl = t._btn:FindFirstChildOfClass("TextLabel")
                if lbl then tween(lbl, { TextColor3 = C.textDim, TextSize = 12 }) end
                t._page.Visible = false
            end
            -- activate this
            tween(btn,  { BackgroundTransparency = 0.5, BackgroundColor3 = C.elevated })
            tween(pill, { BackgroundTransparency = 0 })
            local lbl = btn:FindFirstChildOfClass("TextLabel")
            if lbl then tween(lbl, { TextColor3 = C.text, TextSize = 12 }) end
            page.Visible = true
            windowObj._activeTab = tabObj
        end

        btn.Activated:Connect(activateTab)
        btn.MouseEnter:Connect(function()
            if windowObj._activeTab ~= tabObj then
                tween(btn, { BackgroundTransparency = 0.7, BackgroundColor3 = C.elevated })
                local lbl = btn:FindFirstChildOfClass("TextLabel")
                if lbl then tween(lbl, { TextColor3 = Color3.fromRGB(160, 175, 200) }) end
            end
        end)
        btn.MouseLeave:Connect(function()
            if windowObj._activeTab ~= tabObj then
                tween(btn, { BackgroundTransparency = 1 })
                local lbl = btn:FindFirstChildOfClass("TextLabel")
                if lbl then tween(lbl, { TextColor3 = C.textDim }) end
            end
        end)

        table.insert(windowObj._tabs, tabObj)
        if #windowObj._tabs == 1 then activateTab() end

        -- ── helpers to build elements ────────────────────────
        local function nextOrder()
            tabObj._itemIndex += 1
            return tabObj._itemIndex
        end

